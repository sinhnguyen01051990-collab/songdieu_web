---
/**
 * Landing page cho quảng cáo (Facebook/TikTok/Google): /lp/<slug>/?utm_source=...
 * noindex – không cạnh tranh SEO với trang sản phẩm chính.
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import FeedbackGallery from '../../components/FeedbackGallery.astro';
import { PRODUCTS, type Product, formatVnd, minPrice } from '../../data/products';
import { VIDEOS, FEEDBACK } from '../../data/media';
import { SITE, COMMITMENTS } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.filter((p) => p.offers.length).map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: Product }
const { product: p } = Astro.props;
const best = p.offers.find((o) => o.best) ?? p.offers[0];
---
<Base title={`${p.name} – Ưu đãi hôm nay`} description={p.description} image={p.image} noindex>
  <section class="section !pt-6 !pb-10">
    <div class="container-x grid gap-8 lg:grid-cols-2 lg:items-start">
      <div>
        {p.image && <Image src={p.image} alt={p.name} widths={[420, 640, 860]} sizes="(min-width: 1024px) 560px, 100vw" loading="eager" fetchpriority="high" class="aspect-square w-full rounded-3xl object-cover" />}
        <ul class="mt-5 grid grid-cols-2 gap-3 text-sm">
          {COMMITMENTS.map((c) => <li class="rounded-2xl bg-white p-3 ring-1 ring-black/5"><strong class="block text-ink">{c.title}</strong><span class="text-mute">{c.text}</span></li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow">{p.category}</p>
        <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{p.name}</h1>
        <p class="mt-3 text-lg text-mute">{p.tagline}</p>
        <ul class="mt-5 space-y-2">
          {p.benefits.slice(0, 4).map((b) => <li class="flex gap-3"><span class="text-brand-600">✔</span>{b}</li>)}
        </ul>
        <p class="mt-5 rounded-2xl bg-brand-100 px-4 py-3 text-sm ring-1 ring-gold-400/50">
          🎁 Combo được chọn nhiều nhất: <strong>{best.label}</strong> – <strong class="text-brand-600">{formatVnd(best.price)}</strong>{best.note && <> · {best.note}</>}
        </p>
        <div id="dat-hang" class="mt-6 rounded-3xl bg-white p-5 ring-1 ring-black/5 sm:p-6">
          <p class="mb-4 text-xl font-bold">Đặt hàng – nhận hàng mới thanh toán</p>
          <LeadForm product={p} variant="order" compact />
        </div>
        <p class="mt-3 text-xs text-mute">📄 {p.legal}</p>
      </div>
    </div>
  </section>

  <FeedbackGallery items={FEEDBACK[p.slug] ?? []} />
  <VideoGallery videos={VIDEOS[p.slug] ?? []} title={`Video về ${p.shortName}`} />

  {p.faq.length > 0 && (
    <section class="section !py-12">
      <div class="container-x max-w-3xl">
        <h2 class="text-2xl font-bold">Câu hỏi thường gặp</h2>
        <div class="mt-6 space-y-3">
          {p.faq.map((f) => (
            <details class="group rounded-2xl bg-white p-5 ring-1 ring-black/5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">{f.q}<span class="text-brand-600 transition group-open:rotate-45">+</span></summary>
              <p class="mt-3 text-sm leading-relaxed text-mute">{f.a}</p>
            </details>
          ))}
        </div>
        {p.disclaimer && <p class="mt-6 text-sm italic text-mute">{p.disclaimer}</p>}
      </div>
    </section>
  )}

  <div class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-2 border-t border-black/10 bg-white p-3 pr-20 md:hidden">
    <div class="flex-1 text-xs leading-tight"><span class="text-mute">Chỉ từ</span><br /><strong class="text-base text-brand-600">{formatVnd(minPrice(p)!)}</strong></div>
    <a href={`tel:${SITE.phone}`} class="btn border border-brand-600 !px-3 text-brand-600" data-loc="lp-sticky">Gọi</a>
    <a href="#dat-hang" class="btn-primary !px-4">Đặt hàng</a>
  </div>
</Base>
