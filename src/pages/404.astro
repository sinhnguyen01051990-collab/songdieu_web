---
import Base from '../layouts/Base.astro';
---
<Base title="Không tìm thấy trang" noindex>
  <section class="section">
    <div class="container-x text-center">
      <p class="font-serif text-8xl font-bold text-brand-600">404</p>
      <h1 class="mt-4 text-2xl font-bold">Trang bạn tìm không tồn tại</h1>
      <p class="mt-2 text-mute">Có thể đường dẫn đã thay đổi. Mời bạn quay lại trang chủ hoặc xem sản phẩm.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary">Về trang chủ</a>
        <a href="/san-pham/" class="btn border border-brand-600 text-brand-600">Xem sản phẩm</a>
      </div>
    </div>
  </section>
</Base>
