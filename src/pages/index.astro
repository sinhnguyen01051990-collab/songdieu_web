---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { VIDEOS } from '../data/media';
import HeroCarousel from '../components/HeroCarousel.astro';
import LeadForm from '../components/LeadForm.astro';
import { PRODUCTS, getProduct, formatVnd } from '../data/products';
import { COMMITMENTS, SITE } from '../data/site';
import avatar from '../assets/images/chu-thuong-hieu.jpg';
import xnnBanner from '../assets/images/background-1.png';
import congthuc from '../assets/images/congthuc.jpeg';
import { getCollection } from 'astro:content';

// biểu tượng nét mảnh cho 4 cam kết: chính hãng · giao hàng · kiểm hàng COD · tư vấn
const COMMIT_ICONS = [
  '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
  '<path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>',
  '<path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path d="M8.5 11.5c.6 1.5 2 2.8 3.5 3.3"/>',
];
const gel = getProduct('gel-gung-que-sdbody')!;
const xnn = getProduct('vien-uong-noi-tiet-xuan-nu-nhan')!;
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base
  title="Mỹ phẩm & thảo dược chăm sóc phụ nữ Việt"
  description={SITE.description}
  jsonLd={[{
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Sản phẩm SONG DIỆU',
    itemListElement: PRODUCTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/san-pham/${p.slug}/`, name: p.name })),
  }]}
>
  <HeroCarousel />

  <!-- CAM KẾT -->
  <section class="bg-white" aria-label="Cam kết của SONG DIỆU">
    <div class="container-x grid grid-cols-2 gap-x-4 gap-y-6 py-8 lg:grid-cols-4 lg:gap-0 lg:py-10">
      {COMMITMENTS.map((c, i) => (
        <div class:list={['flex flex-col items-center text-center lg:flex-row lg:items-start lg:gap-4 lg:px-6 lg:text-left', i > 0 && 'lg:border-l lg:border-gold-400/30']}>
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-gradient-to-b from-brand-50 to-brand-100 text-brand-600 ring-1 ring-gold-400/50">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={COMMIT_ICONS[i]} />
          </span>
          <span class="mt-3 lg:mt-0">
            <span class="block font-semibold">{c.title}</span>
            <span class="mt-1 block text-sm leading-snug text-mute">{c.text}</span>
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- VỀ CHÚNG TÔI -->
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div class="relative mx-auto max-w-md">
        <div class="absolute -inset-4 -z-10 rotate-3 rounded-[2.5rem] bg-gradient-to-br from-brand-100 to-gold-400 opacity-70"></div>
        <Image src={avatar} alt="Chủ thương hiệu SONG DIỆU tại văn phòng Song Diệu Pharma Beauty" width={640} height={640} class="rounded-[2rem] shadow-xl" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Về chúng tôi</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">SONG DIỆU <span class="italic text-brand-600">Pharma Beauty</span></h2>
        <p class="mt-6 text-lg leading-relaxed text-ink/80">
          Với một lý tưởng: xây dựng một điều gì đó mang tên <strong class="text-brand-700">“đứa con tinh thần”</strong> của chính mình, và mang tới những vị khách hàng trân quý của SONG DIỆU những sản phẩm <strong>độc tôn – chất lượng</strong> nhất.
        </p>
        <p class="mt-4 leading-relaxed text-mute">
          Hơn 11 năm đồng hành cùng chị em, nhà sáng lập – theo học chuyên ngành Công nghệ Hóa dược – tự tay nghiên cứu, trải nghiệm từng công thức trước khi đưa tới khách hàng. <em>“Mình dùng gì bán đó, uy tín luôn là số 1.”</em>
        </p>
        <a href="/gioi-thieu/" class="btn-primary mt-8 !px-7 !py-3.5">Câu chuyện thương hiệu</a>
      </div>
    </div>
  </section>

  <!-- SẢN PHẨM -->
  <section class="section bg-white" aria-labelledby="sp-title">
    <div class="container-x">
      <div class="text-center">
        <p class="eyebrow">Sản phẩm</p>
        <h2 id="sp-title" class="mt-3 text-4xl font-bold sm:text-5xl">Bộ sản phẩm SONG DIỆU</h2>
        <p class="mx-auto mt-4 max-w-2xl text-mute">Mỗi sản phẩm đều có hồ sơ công bố, kiểm nghiệm rõ ràng – chăm sóc vóc dáng, nội tiết và vùng kín cho phụ nữ.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PRODUCTS.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- SPOTLIGHT GEL -->
  <section class="section">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Sản phẩm nổi bật</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">{gel.name}</h2>
        <p class="mt-4 text-lg text-mute">{gel.tagline}</p>
        <ul class="mt-6 space-y-3">
          {gel.ingredients.slice(0, 3).map((i) => (
            <li class="flex gap-3"><span class="mt-1 text-brand-500">✦</span><span><strong>{i.name}:</strong> <span class="text-mute">{i.desc}</span></span></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`/san-pham/${gel.slug}/`} class="btn-primary">Xem chi tiết</a>
          <p class="text-sm text-mute">Combo từ <strong class="text-brand-600 text-lg">{formatVnd(gel.offers[0].price)}</strong> · Tặng Trà Táo Mèo</p>
        </div>
      </div>
      <Image src={congthuc} alt="Công thức thành phần Gel gừng quế SDBODY" width={700} class="rounded-3xl shadow-xl" loading="lazy" />
    </div>
  </section>

  <!-- SPOTLIGHT XNN -->
  <section class="relative isolate overflow-hidden">
    <Image src={xnnBanner} alt="Viên uống nội tiết Xuân Nữ Nhan" widths={[640, 1024, 1672]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-l from-brand-900/90 via-brand-900/50 to-transparent"></div>
    <div class="container-x flex justify-end py-24">
      <div class="max-w-md text-white">
        <p class="eyebrow !text-gold-300">Nội tiết tố nữ</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">{xnn.shortName}</h2>
        <p class="mt-4 text-white/80">{xnn.tagline}. Sâm tố nữ, Đương quy, Thiên môn chùm, Đông trùng hạ thảo, Maca… hỗ trợ cân bằng nội tiết, làn da và giấc ngủ.</p>
        <a href={`/san-pham/${xnn.slug}/`} class="btn-gold mt-8">Tìm hiểu Xuân Nữ Nhan</a>
      </div>
    </div>
  </section>

  <Testimonials />
  <VideoGallery videos={Object.values(VIDEOS).map((v) => v[0])} title="Video từ SONG DIỆU" />

  <!-- TIN TỨC -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container-x">
        <div class="flex items-end justify-between gap-4">
          <div><p class="eyebrow">Kiến thức</p><h2 class="mt-3 text-4xl font-bold">Tin tức &amp; chia sẻ</h2></div>
          <a href="/tin-tuc/" class="text-sm font-semibold text-brand-600 hover:underline">Xem tất cả →</a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a href={`/tin-tuc/${post.id}/`} class="card group block p-6 transition hover:shadow-lg">
              <time class="text-xs text-mute" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('vi-VN')}</time>
              <h3 class="mt-2 text-lg font-bold group-hover:text-brand-600">{post.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-mute">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ĐĂNG KÝ TƯ VẤN -->
  <section class="section relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-brand-900 text-white">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow !text-gold-300">Tư vấn miễn phí</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">Để lại thông tin, SONG DIỆU gọi lại ngay</h2>
        <p class="mt-4 text-white/75">Nhận tư vấn liệu trình phù hợp và ưu đãi mới nhất. Hoặc gọi trực tiếp hotline <a class="font-bold text-brand-100" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>.</p>
      </div>
      <div class="rounded-3xl bg-cream p-6 text-ink sm:p-8">
        <LeadForm variant="contact" />
      </div>
    </div>
  </section>
</Base>
