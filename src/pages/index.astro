---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Testimonials from '../components/Testimonials.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import LeadForm from '../components/LeadForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AboutBrand from '../components/AboutBrand.astro';
import { PRODUCTS, getProduct } from '../data/products';
import { SITE } from '../data/site';
import xnnBanner from '../assets/images/background-1.png';
import { getCollection } from 'astro:content';

const xnn = getProduct('vien-uong-noi-tiet-xuan-nu-nhan')!;
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base
  title="Mỹ phẩm & thảo dược chăm sóc phụ nữ Việt"
  description={SITE.description}
  jsonLd={[{
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Sản phẩm SONG DIỆU',
    itemListElement: PRODUCTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/san-pham/${p.slug}/`, name: p.name })),
  }]}
>
  <HeroCarousel />

  <!-- CAM KẾT (thẻ nổi) + VỀ CHÚNG TÔI -->
  <TrustStrip />
  <AboutBrand />

  <!-- SẢN PHẨM -->
  <section class="section prod-sec" aria-labelledby="sp-title">
    <span class="prod-dust" aria-hidden="true"></span>
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Sản phẩm</p>
        <h2 id="sp-title" class="mt-3 text-4xl font-bold sm:text-5xl">Bộ sản phẩm SONG DIỆU</h2>
        <p class="mx-auto mt-4 max-w-2xl text-mute">Hơn 11 năm đồng hành cùng phái đẹp Việt, Song Diệu kiến tạo vẻ đẹp khỏe khoắn, tự tin và rạng rỡ bền vững qua các dòng sản phẩm chăm sóc nội tiết, sắc vóc từ thiên nhiên.</p>
      </div>
      <!-- xếp 3 + 2 cân giữa, không để trống ô -->
      <div class="prod-grid mt-12" data-reveal-group>
        {PRODUCTS.map((p) => <div class="prod-cell"><ProductCard product={p} /></div>)}
      </div>
      <div class="mt-12 text-center" data-reveal>
        <a href="/san-pham/" class="btn-primary prod-all !px-7 !py-3.5">
          Xem tất cả sản phẩm
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SPOTLIGHT XNN -->
  <section class="relative isolate overflow-hidden">
    <Image src={xnnBanner} alt="Viên uống nội tiết Xuân Nữ Nhan" widths={[640, 1024, 1672]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-l from-brand-900/90 via-brand-900/50 to-transparent"></div>
    <div class="container-x flex justify-end py-24">
      <div class="max-w-md text-white" data-reveal>
        <p class="eyebrow !text-gold-300">Nội tiết tố nữ</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">{xnn.shortName}</h2>
        <p class="mt-4 text-white/80">{xnn.tagline}. Sâm tố nữ, Đương quy, Thiên môn chùm, Đông trùng hạ thảo, Maca… hỗ trợ cân bằng nội tiết, làn da và giấc ngủ.</p>
        <a href={`/san-pham/${xnn.slug}/`} class="btn-gold mt-8">Tìm hiểu Xuân Nữ Nhan</a>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- TIN TỨC -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container-x">
        <div class="flex items-end justify-between gap-4" data-reveal>
          <div><p class="eyebrow">Kiến thức</p><h2 class="mt-3 text-4xl font-bold">Tin tức &amp; chia sẻ</h2></div>
          <a href="/tin-tuc/" class="text-sm font-semibold text-brand-600 hover:underline">Xem tất cả →</a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal-group>
          {posts.map((post) => (
            <a href={`/tin-tuc/${post.id}/`} class="card group block p-6 transition hover:shadow-lg">
              <time class="text-xs text-mute" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('vi-VN')}</time>
              <h3 class="mt-2 text-lg font-bold group-hover:text-brand-600">{post.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm text-mute">{post.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ĐĂNG KÝ TƯ VẤN -->
  <section class="section relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-brand-900 text-white">
    <div class="container-x grid gap-10 lg:grid-cols-2" data-reveal-group>
      <div>
        <p class="eyebrow !text-gold-300">Tư vấn miễn phí</p>
        <h2 class="mt-3 text-4xl font-bold sm:text-5xl">Để lại thông tin, SONG DIỆU gọi lại ngay</h2>
        <p class="mt-4 text-white/75">Nhận tư vấn liệu trình phù hợp và ưu đãi mới nhất. Hoặc gọi trực tiếp hotline <a class="font-bold text-brand-100" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>.</p>
      </div>
      <div class="rounded-3xl bg-cream p-6 text-ink sm:p-8">
        <LeadForm variant="contact" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* khối sản phẩm: nền kem nối liền khối Về chúng tôi, bụi vàng mờ ở góc phải (15/11/2026) */
  .prod-sec { position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(ellipse 45% 40% at 94% 4%, rgba(224, 191, 110, .2), transparent 70%),
      linear-gradient(180deg, var(--color-cream) 0, #fffdf9 45%, var(--color-cream) 100%); }
  .prod-dust { position: absolute; top: 0; right: 0; width: 45%; height: 300px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 88% 14%, rgba(201,161,74,.5) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 70% 6%, rgba(201,161,74,.4) 0 1px, transparent 2px),
      radial-gradient(circle at 56% 26%, rgba(201,161,74,.35) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 94% 44%, rgba(201,161,74,.3) 0 1px, transparent 2px),
      radial-gradient(circle at 40% 10%, rgba(201,161,74,.3) 0 1px, transparent 2px);
    animation: sd-prod-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-prod-twinkle { from { opacity: .45; } to { opacity: 1; } }

  .prod-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; }
  .prod-cell { width: 100%; }
  @media (min-width: 640px) { .prod-cell { width: calc((100% - 24px) / 2); } }
  @media (min-width: 1024px) { .prod-grid { gap: 28px; } .prod-cell { width: calc((100% - 56px) / 3); } }

  .prod-all { box-shadow: 0 6px 18px -8px rgba(99,16,28,.6), inset 0 0 0 1px rgba(224,191,110,.6); }
</style>
