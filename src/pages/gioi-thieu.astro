---
/**
 * Trang Giới thiệu – bản gọn (16/11/2026, bản 2): header thường như các trang con (không trong suốt),
 * 3 phần (bỏ khối Câu chuyện 16/11): đầu trang (ảnh nhà sáng lập khung vàng + số liệu),
 * Chăm ngoài – Uống trong, nhà máy & hồ sơ + lời mời. Chỉ dùng thông tin đã có, không mã chạy.
 */
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { PRODUCTS } from '../data/products';
import founder from '../assets/images/banner/02-nha-sang-lap-xuan-nu-nhan.jpg';
import nhaMay1 from '../assets/images/sp/nha-may-1.jpg';
import vanPhong from '../assets/images/sp/van-phong-song-dieu.jpg';
import dayChuyen from '../assets/images/banner/05-day-chuyen-sdbody.jpg';

const p = (slug: string) => PRODUCTS.find((x) => x.slug === slug)!;
const OUTSIDE = [p('gel-gung-que-sdbody'), p('but-gel-hoang-cung-bao-phu-khang')];
const INSIDE = [p('vien-uong-noi-tiet-xuan-nu-nhan'), p('tra-tao-meo'), p('tra-mam-xoi-tu-vi')];
const STATS = [
  { n: '11+', label: 'năm đồng hành cùng phái đẹp Việt' },
  { n: '5', label: 'dòng sản phẩm từ thảo dược' },
  { n: '100%', label: 'sản phẩm có hồ sơ công bố' },
  { n: 'ISO 22000', label: 'nhà máy sản xuất đạt chuẩn' },
];
const FACTORIES = [
  { t: 'Công ty CP Dược phẩm VITATH', d: 'KCN Tiên Sơn, Bắc Ninh · đạt ISO 22000 · sản xuất Viên uống Xuân Nữ Nhan' },
  { t: 'Công ty CP Dược Mỹ phẩm Tân Vạn Xuân', d: 'Phú Thọ · đạt ISO 22000:2018 · sản xuất Thất Bảo Trà, Bút Gel Hoàng Cung Bảo Phụ Khang' },
  { t: 'Kiểm nghiệm tại IRDOP', d: 'Thất Bảo Trà đạt các chỉ tiêu vi sinh, kim loại nặng, aflatoxin, thuốc BVTV' },
];
const arrow = '<path d="M5 12h14M13 6l6 6-6 6" />';
---
<Base title="Giới thiệu Song Diệu Pharma Beauty" description="Câu chuyện thương hiệu SONG DIỆU Pharma Beauty – Công ty TNHH SINHAN PHARMA BEAUTY. Hơn 11 năm đồng hành cùng phái đẹp Việt với sản phẩm thảo dược có đầy đủ hồ sơ công bố, sản xuất đạt chuẩn ISO 22000."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Giới thiệu', href: '/gioi-thieu/' }]}>

  <!-- ===== ĐẦU TRANG ===== -->
  <section class="gt-hero" aria-labelledby="gt-title">
    <span class="gt-dust" aria-hidden="true"></span>
    <div class="container-x grid items-center gap-12 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div>
        <p class="eyebrow gt-eyebrow-l" data-reveal>Câu chuyện thương hiệu</p>
        <h1 id="gt-title" class="gt-h1" data-reveal>Song Diệu <span class="gt-red italic">Pharma Beauty</span></h1>
        <p class="gt-slogan" data-reveal>“{SITE.tagline}”</p>
        <p class="gt-lead" data-reveal>Lấy tinh hoa từ dược liệu tự nhiên, Song Diệu mang đến hệ sinh thái giải pháp an toàn chăm sóc vóc dáng và sức khỏe phụ nữ toàn diện từ trong ra ngoài.</p>
      </div>
      <div class="gt-photo" data-reveal>
        <span class="gt-glow" aria-hidden="true"></span>
        <div class="gt-frame">
          <Picture src={founder} alt="Nhà sáng lập SONG DIỆU tại văn phòng Song Diệu Pharma Beauty" widths={[420, 640, 900]} sizes="(min-width: 1024px) 440px, 82vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="gt-img" />
        </div>
        <span class="gt-tag"><b>Hơn 11 năm</b>đồng hành cùng phái đẹp</span>
      </div>
    </div>
    <div class="container-x">
      <ul class="gt-stats" data-reveal>
        {STATS.map((s) => <li><span class="gt-num">{s.n}</span><span class="gt-lbl">{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ===== CHĂM NGOÀI – UỐNG TRONG ===== -->
  <section class="section gt-philo" aria-labelledby="gt-philo-title">
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Triết lý chăm sóc</p>
        <h2 id="gt-philo-title" class="mt-3 text-4xl font-bold sm:text-5xl">Chăm ngoài – <span class="gt-red italic">Uống trong</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-mute">Vẻ đẹp bền vững đến từ sự cân bằng bên trong và chăm sóc đúng cách bên ngoài.</p>
      </div>
      <div class="gt-pgrid" data-reveal-group>
        {[{ k: 'Chăm ngoài', d: 'Vóc dáng săn gọn, vùng kín khỏe – chăm sóc tại nhà mỗi ngày.', list: OUTSIDE },
          { k: 'Uống trong', d: 'Cân bằng nội tiết, thanh lọc nhẹ nhàng – nuôi dưỡng từ bên trong.', list: INSIDE }].map((c) => (
          <div class="gt-pcard">
            <p class="gt-pk">{c.k}</p>
            <p class="gt-pd">{c.d}</p>
            <ul>{c.list.map((x) => <li><a href={`/san-pham/${x.slug}/`}>{x.image && <Image src={x.image} alt="" width={96} height={96} class="gt-thumb" loading="lazy" />}<span>{x.name}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== NHÀ MÁY & HỒ SƠ ===== -->
  <section class="section gt-fac" aria-labelledby="gt-fac-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow gt-eyebrow-l" data-reveal>Văn phòng & nhà máy</p>
        <h2 id="gt-fac-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Sản xuất <span class="gt-red italic">đạt chuẩn</span></h2>
        <p class="mt-5 leading-relaxed text-ink/75" data-reveal>Thương hiệu SONG DIỆU thuộc <strong>{SITE.legalName}</strong>. Sản phẩm được sản xuất tại những nhà máy đạt chuẩn, có đầy đủ phiếu công bố và kiểm nghiệm theo quy định.</p>
        <ul class="gt-flist" data-reveal>
          {FACTORIES.map((f) => <li><span class="gt-fdot" aria-hidden="true"></span><span><b>{f.t}</b><span>{f.d}</span></span></li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <a href="/ho-so-phap-ly/" class="btn-primary !px-7 !py-3.5">Xem hồ sơ pháp lý <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
          <a href="/san-pham/" class="btn-white !px-7 !py-3.5">Xem sản phẩm</a>
        </div>
      </div>
      <div class="gt-gallery" data-reveal>
        <div class="gt-g gt-g-big"><Image src={dayChuyen} alt="Dây chuyền sản xuất Gel SDBODY" width={800} widths={[480, 800]} sizes="(min-width: 1024px) 360px, 60vw" class="gt-gimg" loading="lazy" /></div>
        <div class="gt-g"><Image src={nhaMay1} alt="Kiểm tra sản phẩm tại nhà máy" width={480} widths={[300, 480]} sizes="(min-width: 1024px) 180px, 40vw" class="gt-gimg" loading="lazy" /></div>
        <div class="gt-g"><Image src={vanPhong} alt="Văn phòng Song Diệu Pharma Beauty" width={480} widths={[300, 480]} sizes="(min-width: 1024px) 180px, 40vw" class="gt-gimg" loading="lazy" /></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gt-red { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .gt-red { animation: sd-gt-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-gt-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .gt-eyebrow-l::before { display: none; }
  .gt-eyebrow-l::after { width: 44px; }

  /* đầu trang: nền kem như khối Về chúng tôi trang chủ */
  .gt-hero { position: relative; overflow: hidden; isolation: isolate;
    background: radial-gradient(ellipse 50% 50% at 8% 10%, rgba(224, 191, 110, .22), transparent 70%),
      radial-gradient(ellipse 40% 50% at 100% 100%, rgba(155, 28, 44, .07), transparent 70%), var(--color-cream); }
  .gt-dust { position: absolute; left: 0; top: 0; width: 55%; height: 340px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 12% 18%, rgba(201,161,74,.55) 0 1.4px, transparent 2.5px),
      radial-gradient(circle at 28% 8%, rgba(201,161,74,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 44% 30%, rgba(201,161,74,.4) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 63% 14%, rgba(201,161,74,.4) 0 1.3px, transparent 2.3px);
    animation: sd-gt-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-gt-twinkle { from { opacity: .45; } to { opacity: 1; } }
  .gt-h1 { margin-top: 12px; font: 700 clamp(42px, 5.6vw, 72px)/1.05 var(--font-serif); color: var(--color-ink); }
  .gt-slogan { margin-top: 12px; font: italic 600 clamp(20px, 2vw, 25px)/1.3 var(--font-serif); color: var(--color-gold-600); }
  .gt-lead { margin-top: 14px; max-width: 34rem; font-size: 17px; line-height: 1.7; color: rgba(35, 24, 25, .78); }

  .gt-photo { position: relative; width: 100%; max-width: 26rem; margin: 0 auto; }
  .gt-glow { position: absolute; inset: 8% 4%; z-index: -1; border-radius: 50%; filter: blur(48px);
    background: radial-gradient(circle, rgba(224,191,110,.7), rgba(155,28,44,.3) 60%, transparent 75%); }
  .gt-frame { position: relative; border-radius: 2rem; padding: 6px; overflow: hidden;
    background: linear-gradient(140deg, #f6dc86, #b8862a 35%, #f0dca8 55%, #a8761f 80%, #e8c46a); box-shadow: 0 28px 56px -30px rgba(58, 9, 16, .55); }
  .gt-frame::before { content: ''; position: absolute; inset: 6px; border-radius: 1.65rem; z-index: 1; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 248, 225, .9), inset 0 0 0 4px rgba(184, 134, 42, .3); }
  .gt-frame :global(.gt-img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%; border-radius: 1.65rem; }
  .gt-frame-sq :global(.gt-img) { aspect-ratio: 1; }
  .gt-tag { position: absolute; left: -26px; bottom: 12%; z-index: 3; display: flex; flex-direction: column; gap: 2px; padding: 10px 16px; border-radius: 16px;
    font-size: 12px; line-height: 1.3; color: rgba(251, 243, 230, .82);
    background: linear-gradient(180deg, rgba(99, 16, 28, .92), rgba(58, 9, 16, .94));
    box-shadow: 0 14px 30px -14px rgba(58, 9, 16, .8), inset 0 0 0 1px rgba(224, 191, 110, .55); }
  .gt-tag b { font-family: var(--font-serif); font-size: 20px; line-height: 1.1; color: var(--color-gold-300); }

  .gt-stats { list-style: none; margin: 0; padding: 22px 8px; margin-bottom: 56px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 24px; background: linear-gradient(180deg, #fffdf8, #fbf5ea);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .55), 0 24px 50px -30px rgba(58, 9, 16, .45); }
  .gt-stats li { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 4px 12px; text-align: center; }
  .gt-stats li + li { border-left: 1px solid rgba(201, 161, 74, .3); }
  .gt-num { font: 700 clamp(30px, 3.2vw, 40px)/1 var(--font-serif); color: var(--color-brand-700); }
  .gt-lbl { font-size: 13.5px; color: var(--color-mute); }

  /* trích dẫn */
  .gt-quote { position: relative; margin: 28px 0 0; padding: 18px 24px 16px 62px; border-radius: 18px;
    background: linear-gradient(135deg, #fdf8ec, #f6ecd6); box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .55); }
  .gt-qmark { position: absolute; left: 18px; top: 14px; font: 700 60px/1 var(--font-serif);
    background: linear-gradient(180deg, #f6dc86, #b8862a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .gt-quote blockquote { margin: 0; font: italic 700 clamp(19px, 1.7vw, 22px)/1.4 var(--font-serif); color: var(--color-brand-700); }
  .gt-quote figcaption { margin-top: 8px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-gold-600); }
  .gt-quote figcaption::before { content: '— '; }

  /* chăm ngoài – uống trong */
  .gt-philo { background: #fff; }
  .gt-pgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 60rem; margin: 44px auto 0; }
  .gt-pcard { height: 100%; padding: 26px; border-radius: 24px; background: linear-gradient(180deg, #fff 0%, #fffdf8 55%, #fbf3e4 100%);
    box-shadow: 0 0 0 1px rgba(201, 161, 74, .38), 0 18px 40px -28px rgba(58, 9, 16, .45); }
  .gt-pk { font: 700 28px/1.1 var(--font-serif); color: var(--color-brand-700); }
  .gt-pd { margin-top: 6px; font-size: 14.5px; color: var(--color-mute); }
  .gt-pcard ul { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 8px; }
  .gt-pcard a { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 16px; color: var(--color-ink); transition: background .3s, color .3s; }
  .gt-pcard a span { flex: 1; font-weight: 600; }
  .gt-pcard a svg { color: var(--color-gold-500); transition: transform .3s; }
  .gt-pcard a:hover { background: var(--color-brand-50); color: var(--color-brand-600); }
  .gt-pcard a:hover svg { transform: translateX(3px); }
  .gt-pcard :global(.gt-thumb) { flex: none; width: 52px; height: 52px; border-radius: 12px; object-fit: cover; box-shadow: 0 0 0 1px rgba(201, 161, 74, .5); }

  /* nhà máy */
  .gt-fac { background: var(--color-cream); }
  .gt-flist { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; }
  .gt-flist li { display: flex; gap: 12px; }
  .gt-fdot { flex: none; width: 10px; height: 10px; margin-top: 7px; border-radius: 50%; background: radial-gradient(circle, #f6dc86, #b8862a); }
  .gt-flist b { display: block; color: var(--color-ink); }
  .gt-flist li > span:last-child > span { display: block; font-size: 14px; color: var(--color-mute); }
  .gt-gallery { display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: 1fr 1fr; gap: 14px; aspect-ratio: 5 / 4; }
  .gt-g { overflow: hidden; border-radius: 22px; box-shadow: 0 0 0 1px rgba(201, 161, 74, .4), 0 18px 36px -24px rgba(58, 9, 16, .5); }
  .gt-g-big { grid-row: span 2; }
  .gt-g :global(.gt-gimg) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
  .gt-g:hover :global(.gt-gimg) { transform: scale(1.05); }

  @media (max-width: 1023px) {
    .gt-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 16px; }
    .gt-stats li:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 640px) {
    .gt-tag { left: -8px; padding: 8px 12px; font-size: 11px; } .gt-tag b { font-size: 17px; }
    .gt-pgrid { grid-template-columns: 1fr; }
    .gt-quote { padding-left: 54px; } .gt-qmark { left: 14px; font-size: 52px; }
  }
</style>
