<script>
  // nghiêng 3D có vệt kính khi rê chuột (chỉ máy tính có chuột)
  const tilt = document.getElementById('gt-tilt');
  if (tilt && matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tilt.addEventListener('pointermove', (e) => {
      const r = tilt.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
      tilt.classList.add('on');
      tilt.style.transform = `perspective(1000px) rotateX(${((0.5 - py) * 10).toFixed(2)}deg) rotateY(${((px - 0.5) * 12).toFixed(2)}deg) scale(1.02)`;
      tilt.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
      tilt.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
    });
    tilt.addEventListener('pointerleave', () => { tilt.classList.remove('on'); tilt.style.transform = ''; });
  }
</script>
