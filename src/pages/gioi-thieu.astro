---
/**
 * Trang Giới thiệu – thiết kế lại 16/11/2026, đồng bộ phong cách trang chủ (đỏ đô + vàng gold).
 * Điểm nhấn: đầu trang đỏ đô có ảnh nhà sáng lập khung vàng + nhãn nổi, số liệu đếm lên;
 * đường vàng tự vẽ nối 5 bước "từ công thức tới tay khách"; mề đay vàng "Chăm ngoài – Uống trong".
 * Chỉ dùng thông tin đã có trên web / hồ sơ công bố, không thêm số liệu mới.
 */
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE, COMMITMENTS } from '../data/site';
import { PRODUCTS } from '../data/products';
import founder from '../assets/images/banner/02-nha-sang-lap-xuan-nu-nhan.jpg';
import avatar from '../assets/images/chu-thuong-hieu.jpg';
import vanPhong from '../assets/images/sp/van-phong-song-dieu.jpg';
import vanPhong2 from '../assets/images/sp/van-phong-2.jpg';
import nhaMay1 from '../assets/images/sp/nha-may-1.jpg';
import nhaMay2 from '../assets/images/sp/nha-may-2.jpg';
import dayChuyen from '../assets/images/banner/05-day-chuyen-sdbody.jpg';

const p = (slug: string) => PRODUCTS.find((x) => x.slug === slug)!;
const OUTSIDE = [p('gel-gung-que-sdbody'), p('but-gel-hoang-cung-bao-phu-khang')];
const INSIDE = [p('vien-uong-noi-tiet-xuan-nu-nhan'), p('tra-tao-meo'), p('tra-mam-xoi-tu-vi')];

const STATS = [
  { n: 11, suf: '+', label: 'năm đồng hành cùng phái đẹp Việt' },
  { n: 5, suf: '', label: 'dòng sản phẩm từ thảo dược' },
  { n: 100, suf: '%', label: 'sản phẩm có hồ sơ công bố' },
  { text: 'ISO 22000', label: 'nhà máy sản xuất đạt chuẩn' },
];
const STEPS = [
  { t: 'Nghiên cứu công thức', d: 'Từ nền tảng chuyên ngành Công nghệ Hóa dược, chọn lọc thảo dược và hoạt chất phù hợp cơ thể phụ nữ.' },
  { t: 'Tự trải nghiệm trước', d: 'Nhà sáng lập dùng thử trên chính mình trước khi đưa ra thị trường – “mình dùng gì bán đó”.' },
  { t: 'Sản xuất đạt chuẩn', d: 'Sản xuất tại nhà máy đạt ISO 22000 như Dược phẩm VITATH, Dược Mỹ phẩm Tân Vạn Xuân.' },
  { t: 'Công bố & kiểm nghiệm', d: 'Đầy đủ phiếu công bố, kiểm nghiệm theo quy định của Bộ Y tế trước khi tới tay khách.' },
  { t: 'Đồng hành sau mua', d: 'Tư vấn tận tâm trước – trong – sau khi dùng, theo sát từng chị trên hành trình chăm sóc.' },
];
const VALUES = [
  { t: 'Chữ tín', d: 'Giữ trọn chữ tín trên mọi hành trình. Không nói quá về sản phẩm để khách kỳ vọng rồi thất vọng.', i: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>' },
  { t: 'Minh bạch', d: '100% sản phẩm có đầy đủ hồ sơ công bố pháp lý, công khai nơi sản xuất và kết quả kiểm nghiệm.', i: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>' },
  { t: 'An nhiên từ thảo dược', d: 'Tinh hoa dược liệu tự nhiên kết hợp quy trình hiện đại – an toàn, dịu nhẹ, phù hợp dùng lâu dài.', i: '<path d="M5 19c0-8 6-14 15-14-1 9-6 15-14 15"/><path d="M5 19c3-4 6-6 9-7"/>' },
  { t: 'Đồng hành trọn đời', d: 'Cam kết đồng hành cùng vẻ đẹp khỏe khoắn, bền vững của phụ nữ Việt, không chỉ một lần mua.', i: '<path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"/>' },
];
const FACTORIES = [
  { t: 'Công ty CP Dược phẩm VITATH', d: 'KCN Tiên Sơn, Bắc Ninh · đạt ISO 22000 · sản xuất Viên uống Xuân Nữ Nhan' },
  { t: 'Công ty CP Dược Mỹ phẩm Tân Vạn Xuân', d: 'Phú Thọ · đạt ISO 22000:2018 · sản xuất Thất Bảo Trà, Bút Gel Hoàng Cung Bảo Phụ Khang' },
  { t: 'Kiểm nghiệm tại IRDOP', d: 'Thất Bảo Trà kiểm nghiệm vi sinh, kim loại nặng, aflatoxin, thuốc BVTV – kết quả đạt' },
];
const GALLERY = [
  { src: vanPhong, alt: 'Văn phòng Song Diệu Pharma Beauty' },
  { src: nhaMay1, alt: 'Kiểm tra sản phẩm Gel SDBODY tại nhà máy' },
  { src: vanPhong2, alt: 'Không gian làm việc tại Song Diệu' },
  { src: nhaMay2, alt: 'Dây chuyền đóng gói sản phẩm SONG DIỆU' },
];
const STAR = 'M12 0l2.2 9.8L24 12l-9.8 2.2L12 24l-2.2-9.8L0 12l9.8-2.2z';
---
<Base title="Giới thiệu Song Diệu Pharma Beauty" description="Câu chuyện thương hiệu SONG DIỆU Pharma Beauty – Công ty TNHH SINHAN PHARMA BEAUTY. Hơn 11 năm đồng hành cùng phái đẹp Việt với sản phẩm thảo dược có đầy đủ hồ sơ công bố, sản xuất đạt chuẩn ISO 22000."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Giới thiệu', href: '/gioi-thieu/' }]}>

  <!-- ===== ĐẦU TRANG ===== -->
  <section class="gt-hero" aria-labelledby="gt-title">
    <span class="gt-hero-glow" aria-hidden="true"></span>
    <span class="gt-hero-dust" aria-hidden="true"></span>
    <div class="container-x gt-hero-in">
      <div class="gt-hero-copy">
        <p class="eyebrow gt-eyebrow" data-reveal>Câu chuyện thương hiệu</p>
        <h1 id="gt-title" class="gt-h1" data-reveal>Song Diệu <span class="gt-gold italic">Pharma Beauty</span></h1>
        <p class="gt-slogan" data-reveal>“{SITE.tagline}”</p>
        <p class="gt-lead" data-reveal>Lấy tinh hoa từ dược liệu tự nhiên, Song Diệu mang đến hệ sinh thái giải pháp an toàn chăm sóc vóc dáng và sức khỏe phụ nữ toàn diện từ trong ra ngoài.</p>
        <div class="gt-hero-act" data-reveal>
          <a href="#cau-chuyen" class="btn-gold !px-6 !py-3.5">Đọc câu chuyện
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
          </a>
          <a href="/san-pham/" class="btn gt-ghost !px-6 !py-3.5">Xem sản phẩm
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
      <div class="gt-hero-photo" data-reveal>
        <span class="gt-photo-glow" aria-hidden="true"></span>
        <div class="gt-frame">
          <Picture src={founder} alt="Nhà sáng lập SONG DIỆU tại văn phòng Song Diệu Pharma Beauty" widths={[420, 640, 900]} sizes="(min-width: 1024px) 440px, 82vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="gt-img" />
        </div>
        <span class="gt-tag gt-tag-1"><b>Hơn 11 năm</b>đồng hành cùng phái đẹp</span>
        <span class="gt-tag gt-tag-2"><b>ISO 22000</b>nhà máy sản xuất đạt chuẩn</span>
        <svg class="gt-star" width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path d={STAR} fill="currentColor" /></svg>
      </div>
    </div>

    <!-- số liệu: đếm lên khi cuộn tới -->
    <div class="container-x">
      <ul class="gt-stats" data-count-wrap>
        {STATS.map((s) => (
          <li>
            <span class="gt-num">{s.text ?? <><span data-count={s.n}>{s.n}</span>{s.suf}</>}</span>
            <span class="gt-lbl">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== CÂU CHUYỆN ===== -->
  <section class="section gt-story" id="cau-chuyen" aria-labelledby="gt-story-title">
    <span class="gt-dust" aria-hidden="true"></span>
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div class="gt-story-photo" data-reveal>
        <div class="gt-frame gt-frame-sq">
          <Image src={avatar} alt="Chủ thương hiệu SONG DIỆU tại văn phòng" width={640} height={640} widths={[400, 640]} sizes="(min-width: 1024px) 480px, 90vw" class="gt-img" loading="lazy" />
        </div>
        <span class="gt-tag gt-tag-3"><b>Đứa con tinh thần</b>của hai vợ chồng nhà sáng lập</span>
      </div>
      <div>
        <p class="eyebrow gt-eyebrow-l" data-reveal>Về chúng tôi</p>
        <h2 id="gt-story-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Câu chuyện <span class="gt-red italic">“đứa con tinh thần”</span></h2>
        <p class="mt-6 text-lg leading-relaxed text-ink/85" data-reveal>
          SONG DIỆU ra đời từ một lý tưởng giản dị của hai vợ chồng: xây dựng một điều gì đó mang tên <strong class="text-brand-700">đứa con tinh thần</strong> của chính mình, và mang tới những vị khách hàng trân quý những sản phẩm <strong>chất lượng</strong> nhất.
        </p>
        <p class="mt-4 text-[1.0625rem] leading-relaxed text-ink/75" data-reveal>
          Với hơn <strong class="text-brand-700">11 năm kinh nghiệm</strong> và nền tảng chuyên ngành <strong>Công nghệ Hóa dược</strong>, nhà sáng lập tự tay nghiên cứu, thử nghiệm từng công thức trên chính bản thân trước khi đưa ra thị trường. Gel gừng quế SDBODY ra đời từ chính hành trình chăm sóc vóc dáng sau sinh của nhà sáng lập.
        </p>
        <figure class="gt-quote" data-reveal>
          <span class="gt-qmark" aria-hidden="true">“</span>
          <blockquote>Mình dùng gì bán đó. Không nói điêu, không nói quá về sản phẩm để khách hàng kỳ vọng rồi thất vọng. Uy tín luôn luôn là số 1.</blockquote>
          <figcaption>Nhà sáng lập SONG DIỆU</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== HÀNH TRÌNH 5 BƯỚC ===== -->
  <section class="section gt-steps-sec" aria-labelledby="gt-steps-title">
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Làm thật – minh bạch</p>
        <h2 id="gt-steps-title" class="mt-3 text-4xl font-bold sm:text-5xl">Từ công thức tới <span class="gt-red italic">tay chị em</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-mute">Mỗi sản phẩm SONG DIỆU đi qua 5 bước trước khi được gửi tới khách hàng.</p>
      </div>
      <div class="gt-steps" data-draw>
        <span class="gt-steps-line" aria-hidden="true"><span></span></span>
        <ol class="gt-steps-ol">
        {STEPS.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="gt-step-dot"><span>{String(i + 1).padStart(2, '0')}</span></span>
            <h3 class="gt-step-t">{s.t}</h3>
            <p class="gt-step-d">{s.d}</p>
          </li>
        ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== TRIẾT LÝ CHĂM NGOÀI – UỐNG TRONG ===== -->
  <section class="section gt-philo" aria-labelledby="gt-philo-title">
    <span class="gt-philo-dust" aria-hidden="true"></span>
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow gt-eyebrow">Triết lý chăm sóc</p>
        <h2 id="gt-philo-title" class="mt-3 text-4xl font-bold text-white sm:text-5xl">Chăm ngoài – <span class="gt-gold italic">Uống trong</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-white/75">Vẻ đẹp bền vững đến từ sự cân bằng bên trong và chăm sóc đúng cách bên ngoài – Song Diệu đồng hành cùng phái đẹp Việt chủ động gìn giữ nét thanh xuân.</p>
      </div>
      <div class="gt-philo-grid">
        <div class="gt-pcard" data-reveal>
          <p class="gt-pcard-k">Chăm ngoài</p>
          <p class="gt-pcard-d">Vóc dáng săn gọn, vùng kín khỏe – chăm sóc tại nhà mỗi ngày.</p>
          <ul>{OUTSIDE.map((x) => <li><a href={`/san-pham/${x.slug}/`}>{x.image && <Image src={x.image} alt="" width={96} height={96} class="gt-pthumb" loading="lazy" />}<span>{x.name}</span></a></li>)}</ul>
        </div>
        <div class="gt-medal" aria-hidden="true">
          <span class="gt-medal-ring"></span>
          <span class="gt-medal-in"><svg width="26" height="26" viewBox="0 0 24 24"><path d={STAR} fill="currentColor" /></svg><b>Vẻ đẹp</b><i>an nhiên</i></span>
        </div>
        <div class="gt-pcard" data-reveal>
          <p class="gt-pcard-k">Uống trong</p>
          <p class="gt-pcard-d">Cân bằng nội tiết, thanh lọc nhẹ nhàng – nuôi dưỡng từ sâu bên trong.</p>
          <ul>{INSIDE.map((x) => <li><a href={`/san-pham/${x.slug}/`}>{x.image && <Image src={x.image} alt="" width={96} height={96} class="gt-pthumb" loading="lazy" />}<span>{x.name}</span></a></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GIÁ TRỊ CỐT LÕI ===== -->
  <section class="section gt-values-sec" aria-labelledby="gt-values-title">
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Giá trị cốt lõi</p>
        <h2 id="gt-values-title" class="mt-3 text-4xl font-bold sm:text-5xl">Điều SONG DIỆU <span class="gt-red italic">luôn giữ</span></h2>
      </div>
      <div class="gt-values" data-reveal-group>
        {VALUES.map((v) => (
          <div class="gt-vcell"><div class="gt-vcard">
            <span class="gt-vico"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={v.i} /></span>
            <h3 class="gt-vt">{v.t}</h3>
            <p class="gt-vd">{v.d}</p>
          </div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== NHÀ MÁY & VĂN PHÒNG ===== -->
  <section class="section gt-fac" aria-labelledby="gt-fac-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-5 lg:gap-14">
      <div class="lg:col-span-2">
        <p class="eyebrow gt-eyebrow-l" data-reveal>Văn phòng & nhà máy</p>
        <h2 id="gt-fac-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Sản xuất <span class="gt-red italic">đạt chuẩn</span></h2>
        <p class="mt-5 leading-relaxed text-ink/75" data-reveal>Thương hiệu SONG DIỆU thuộc <strong>{SITE.legalName}</strong>. Sản phẩm được sản xuất tại những nhà máy đạt chuẩn, có đầy đủ phiếu công bố và kiểm nghiệm theo quy định.</p>
        <ul class="gt-flist" data-reveal-group>
          {FACTORIES.map((f) => <li><span class="gt-fdot" aria-hidden="true"></span><span><b>{f.t}</b><span>{f.d}</span></span></li>)}
        </ul>
        <div class="mt-8" data-reveal>
          <a href="/ho-so-phap-ly/" class="btn-primary !px-7 !py-3.5">Xem hồ sơ pháp lý
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
      <div class="gt-gallery lg:col-span-3" data-reveal-group>
        <div class="gt-g gt-g-big"><Image src={dayChuyen} alt="Dây chuyền sản xuất Gel SDBODY" width={900} widths={[480, 720, 900]} sizes="(min-width: 1024px) 640px, 92vw" class="gt-gimg" loading="lazy" /></div>
        {GALLERY.map((g) => <div class="gt-g"><Image src={g.src} alt={g.alt} width={480} widths={[300, 480]} sizes="(min-width: 1024px) 200px, 45vw" class="gt-gimg" loading="lazy" /></div>)}
      </div>
    </div>
  </section>

  <!-- ===== CAM KẾT + LỜI MỜI ===== -->
  <section class="gt-cta" aria-labelledby="gt-cta-title">
    <span class="gt-hero-dust" aria-hidden="true"></span>
    <div class="container-x">
      <ul class="gt-commit" data-reveal-group>
        {COMMITMENTS.map((c) => <li><b>{c.title}</b><span>{c.text}</span></li>)}
      </ul>
      <div class="gt-cta-in" data-reveal>
        <h2 id="gt-cta-title" class="text-3xl font-bold text-white sm:text-4xl">Để SONG DIỆU <span class="gt-gold italic">đồng hành</span> cùng chị</h2>
        <p class="mt-3 text-white/75">“Giữ trọn chữ tín trên mọi hành trình”</p>
        <div class="gt-hero-act justify-center">
          <a href="/san-pham/" class="btn-gold !px-6 !py-3.5">Khám phá sản phẩm
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href={SITE.zalo} target="_blank" rel="noopener" class="btn gt-ghost !px-6 !py-3.5">Tư vấn qua Zalo</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- dùng chung ---------- */
  .gt-gold { background-image: linear-gradient(100deg, #e0bf6e 0 40%, #fff3c4 46%, #ffffff 50%, #fff3c4 54%, #e0bf6e 60% 100%);
    background-size: 320% 100%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  .gt-red { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) .gt-gold, :global(.is-in) .gt-red { animation: sd-gt-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-gt-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .gt-eyebrow { color: var(--color-gold-300); }
  .gt-eyebrow-l::before, .gt-hero-copy .gt-eyebrow::before { display: none; }
  .gt-eyebrow-l::after, .gt-hero-copy .gt-eyebrow::after { width: 44px; }
  .gt-hero-dust { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 8% 22%, rgba(246,220,134,.75) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 24% 74%, rgba(246,220,134,.5) 0 1px, transparent 2px),
      radial-gradient(circle at 40% 14%, rgba(246,220,134,.6) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 52% 88%, rgba(246,220,134,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 63% 34%, rgba(246,220,134,.4) 0 1.1px, transparent 2.1px),
      radial-gradient(circle at 90% 80%, rgba(246,220,134,.55) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 96% 12%, rgba(246,220,134,.5) 0 1px, transparent 2px);
    animation: sd-gt-twinkle 4.5s ease-in-out infinite alternate; }
