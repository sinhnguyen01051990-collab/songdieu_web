---
/**
 * Trang Giới thiệu – bản gọn (16/11/2026, bản 2): header thường như các trang con (không trong suốt),
 * 3 phần (bỏ khối Câu chuyện 16/11): đầu trang (ảnh nhà sáng lập khung vàng + số liệu),
 * Chăm ngoài – Uống trong, nhà máy & hồ sơ + lời mời. Chỉ dùng thông tin đã có, không mã chạy.
 */
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { PRODUCTS } from '../data/products';
import founder from '../assets/images/chu-thuong-hieu.jpg'; // ảnh văn phòng có biển SONG DIỆU
// ảnh khối Sản xuất đạt chuẩn: anh gửi qua Drive 16/11/2026
import gNhaMay from '../assets/images/gioi-thieu/kiem-tra-tai-nha-may.jpg';
import gDayChuyen from '../assets/images/gioi-thieu/day-chuyen-sdbody.jpg';
import gXnn from '../assets/images/gioi-thieu/xuan-nu-nhan-van-phong.jpg';
import imgNgoai from '../assets/images/sp/gel-sdbody-beauty-1.jpg';
import imgTrong from '../assets/images/sp/xuan-nu-nhan-beauty-1.jpg';

const p = (slug: string) => PRODUCTS.find((x) => x.slug === slug)!;
const OUTSIDE = [p('gel-gung-que-sdbody'), p('but-gel-hoang-cung-bao-phu-khang')];
const INSIDE = [p('vien-uong-noi-tiet-xuan-nu-nhan'), p('tra-tao-meo'), p('tra-mam-xoi-tu-vi')];
const STATS = [
  { n: '11+', label: 'năm đồng hành cùng phái đẹp Việt' },
  { n: '5', label: 'dòng sản phẩm từ thảo dược' },
  { n: '100%', label: 'sản phẩm có hồ sơ công bố' },
  { n: 'ISO 22000', label: 'nhà máy sản xuất đạt chuẩn' },
];
const FACTORIES = [
  { i: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>', t: 'Đầy đủ giấy phép lưu hành & công bố chất lượng', d: 'Nội tiết tố Xuân Nữ Nhan, Gel Gừng Quế SDBODY, Bút Gel Hoàng Cung Bảo Phụ Khang...' },
  { i: '<path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A1.6 1.6 0 0 0 5.9 21h12.2a1.6 1.6 0 0 0 1.4-2.5L14 9V3"/><path d="M7.5 15h9"/>', t: 'Kiểm nghiệm an toàn nghiêm ngặt tại Viện IRDOP', d: 'Đạt chuẩn kiểm nghiệm khắt khe về chỉ tiêu vi sinh, kim loại nặng, aflatoxin và dư lượng thuốc bảo vệ thực vật' },
  { i: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>', t: 'Thẻ bảo hành chính hãng & Cam kết đồng hành', d: 'Thẻ bảo hành minh bạch trong mỗi đơn hàng và cam kết hoàn tiền 100% theo đúng chính sách của công ty.' },
];
const arrow = '<path d="M5 12h14M13 6l6 6-6 6" />';
const TOPIC: Record<string, string> = { 'gel-gung-que-sdbody': 'Vóc dáng', 'but-gel-hoang-cung-bao-phu-khang': 'Vùng kín',
  'vien-uong-noi-tiet-xuan-nu-nhan': 'Nội tiết', 'tra-tao-meo': 'Trà thảo mộc', 'tra-mam-xoi-tu-vi': 'Trà thảo mộc' };
const HALVES = [
  { side: 'l', k: 'Chăm ngoài', d: 'Vóc dáng săn gọn, vùng kín khỏe – chăm sóc tại nhà mỗi ngày.', img: imgNgoai, alt: 'Chăm sóc vóc dáng với Gel gừng quế SDBODY', list: OUTSIDE,
    tip: 'Gel SDBODY + Thất Bảo Trà – chăm vóc dáng từ ngoài vào trong',
    ico: '<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12"/><path d="M11 11.5v-2a1.5 1.5 0 0 1 3 0V12"/><path d="M14 10.5a1.5 1.5 0 0 1 3 0V12"/><path d="M17 11.5a1.5 1.5 0 0 1 3 0V16a6 6 0 0 1-6 6h-2a6 6 0 0 1-5.2-3l-2.6-4.5a1.5 1.5 0 0 1 2.6-1.5L8 15"/>' },
  { side: 'r', k: 'Uống trong', d: 'Cân bằng nội tiết, thanh lọc nhẹ nhàng – nuôi dưỡng từ bên trong.', img: imgTrong, alt: 'Viên uống nội tiết Xuân Nữ Nhan', list: INSIDE,
    tip: 'Trà Mâm Xôi Tứ Vị + Bút Gel Hoàng Cung – chăm vùng kín cả trong lẫn ngoài',
    ico: '<path d="M5 19c0-8 6-14 15-14-1 9-6 15-14 15"/><path d="M5 19c3-4 6-6 9-7"/>' },
];
---
<Base title="Giới thiệu Song Diệu Pharma Beauty" jsonLd={[{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Giới thiệu Song Diệu Pharma Beauty', url: `${SITE.url}/gioi-thieu/`, inLanguage: 'vi-VN', mainEntity: { '@id': `${SITE.url}/#org` } }]} description="Câu chuyện thương hiệu SONG DIỆU Pharma Beauty – Công ty TNHH SINHAN PHARMA BEAUTY. Hơn 11 năm đồng hành cùng phái đẹp Việt với sản phẩm thảo dược có đầy đủ hồ sơ công bố, sản xuất đạt chuẩn ISO 22000."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Giới thiệu', href: '/gioi-thieu/' }]}>

  <!-- ===== ĐẦU TRANG ===== -->
  <section class="gt-hero" aria-labelledby="gt-title">
    <span class="gt-dust" aria-hidden="true"></span>
    <div class="container-x grid items-center gap-12 py-14 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div>
        <p class="eyebrow gt-eyebrow-l" data-reveal>Về Song Diệu</p>
        <h1 id="gt-title" class="gt-h1" data-reveal>SONG DIỆU <span class="gt-red italic">Pharma Beauty</span></h1>
        <p class="gt-slogan" data-reveal>“{SITE.tagline}”</p>
        <p class="gt-lead" data-reveal>Lấy tinh hoa từ dược liệu tự nhiên, Song Diệu mang đến hệ sinh thái giải pháp an toàn chăm sóc vóc dáng và sức khỏe phụ nữ toàn diện từ trong ra ngoài.</p>
      </div>
      <div class="gt-photo" data-reveal>
        <span class="gt-glow" aria-hidden="true"></span>
        <div class="gt-tilt" id="gt-tilt">
          <div class="gt-frame">
          <Picture src={founder} alt="Chủ thương hiệu SONG DIỆU tại văn phòng Song Diệu Pharma Beauty" widths={[420, 640, 900]} sizes="(min-width: 1024px) 440px, 82vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="gt-img" />
        </div>
          <span class="gt-glare" aria-hidden="true"></span>
        </div>
        <span class="gt-tag"><b>Hơn 11 năm</b>đồng hành cùng phái đẹp</span>
        <span class="gt-tag gt-tag-2"><b>ISO 22000</b>nhà máy sản xuất đạt chuẩn</span>
      </div>
    </div>
    <div class="container-x">
      <ul class="gt-stats" data-reveal>
        {STATS.map((s) => <li><span class="gt-num">{s.n}</span><span class="gt-lbl">{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- ===== CHĂM NGOÀI – UỐNG TRONG ===== -->
  <section class="section gt-philo" aria-labelledby="gt-philo-title">
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Triết lý chăm sóc</p>
        <h2 id="gt-philo-title" class="mt-3 text-4xl font-bold sm:text-5xl">Chăm ngoài – <span class="gt-red italic">uống trong</span></h2>
        <p class="mx-auto mt-4 max-w-2xl text-mute">Vẻ đẹp bền vững đến từ sự cân bằng bên trong và chăm sóc đúng cách bên ngoài.</p>
      </div>
      <!-- hai nửa – một vẻ đẹp: thẻ trái trượt từ trái, thẻ phải trượt từ phải, vòng ＋ ở giữa sáng lên một lần -->
      <div class="gt-pwrap">
        {HALVES.map((h, i) => (
          <>
            {i === 1 && <div class="gt-plus" data-reveal aria-hidden="true"><span>+</span></div>}
            <article class={`gt-pc gt-pc-${h.side}`} data-reveal>
              <div class="gt-pc-media">
                <Picture src={h.img} alt={h.alt} widths={[420, 640]} sizes="(min-width: 1024px) 440px, 92vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" class="gt-pc-img" />
                <span class="gt-pc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={h.ico} /></span>
              </div>
              <div class="gt-pc-body">
                <h3 class="gt-pk">{h.k}</h3>
                <p class="gt-pd">{h.d}</p>
                <ul class="gt-plist">
                  {h.list.map((x) => (
                    <li><a href={`/san-pham/${x.slug}/`}>
                      {x.image && <Image src={x.image} alt="" width={128} height={128} class="gt-thumb" loading="lazy" />}
                      <span class="gt-pn"><b>{x.name}</b><span class="gt-ptag">{TOPIC[x.slug]}</span></span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
                    </a></li>
                  ))}
                </ul>
                <p class="gt-tip"><b>Gợi ý kết hợp</b>{h.tip}</p>
              </div>
            </article>
          </>
        ))}
      </div>
      <p class="gt-eq" data-reveal><span>=</span> Vẻ đẹp an nhiên <em>từ trong ra ngoài</em></p>
      <div class="gt-pcta" data-reveal>
        <p>Chưa biết bắt đầu từ đâu? Nhận tư vấn lộ trình <strong>chăm ngoài – uống trong</strong></p>
        <a href={SITE.zalo} target="_blank" rel="noopener" class="btn-primary !px-6 !py-3">Tư vấn qua Zalo <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- ===== NHÀ MÁY & HỒ SƠ ===== -->
  <section class="section gt-fac" aria-labelledby="gt-fac-title">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow gt-eyebrow-l" data-reveal>Văn phòng & nhà máy</p>
        <h2 id="gt-fac-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Sản xuất <span class="gt-red italic">đạt chuẩn</span></h2>
        <p class="mt-5 leading-relaxed text-ink/75" data-reveal>Thương hiệu SONG DIỆU thuộc <strong>{SITE.legalName}</strong>. 100% sản phẩm đều trải qua quy trình nghiên cứu chuyên sâu, có đầy đủ hồ sơ công bố của Sở Y tế và phiếu kiểm nghiệm đạt chuẩn chất lượng trước khi đến tay khách hàng.</p>
        <ul class="gt-flist" data-reveal>
          {FACTORIES.map((f) => <li><span class="gt-fico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.i} /></span><span><b>{f.t}</b><span>{f.d}</span></span></li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          
          <a href="/san-pham/" class="btn-primary !px-7 !py-3.5">Xem sản phẩm <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} /></a>
        </div>
      </div>
      <div class="gt-gallery" data-reveal>
        <div class="gt-g gt-g-big"><Picture src={gDayChuyen} alt="Dây chuyền sản xuất Gel SDBODY" widths={[480, 720, 960]} sizes="(min-width: 1024px) 340px, 58vw" formats={['avif', 'webp']} fallbackFormat="webp" class="gt-gimg" loading="lazy" /><span class="gt-cap">Dây chuyền SDBODY</span></div>
        <div class="gt-g gt-g-top"><Picture src={gNhaMay} alt="Kiểm tra sản phẩm SONG DIỆU tại nhà máy" widths={[320, 520]} sizes="(min-width: 1024px) 240px, 40vw" formats={['avif', 'webp']} fallbackFormat="webp" class="gt-gimg" loading="lazy" /><span class="gt-cap">Kiểm tra tại nhà máy</span></div>
        <div class="gt-g gt-g-top"><Picture src={gXnn} alt="Viên uống nội tiết Xuân Nữ Nhan tại văn phòng Song Diệu" widths={[320, 520]} sizes="(min-width: 1024px) 240px, 40vw" formats={['avif', 'webp']} fallbackFormat="webp" class="gt-gimg" loading="lazy" /></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gt-red { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) .gt-red { animation: sd-gt-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-gt-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .gt-eyebrow-l::before { display: none; }
  .gt-eyebrow-l::after { width: 44px; }

  /* đầu trang: nền kem như khối Về chúng tôi trang chủ */
  .gt-hero { position: relative; overflow: hidden; isolation: isolate;
    background: radial-gradient(ellipse 50% 50% at 8% 10%, rgba(224, 191, 110, .22), transparent 70%),
      radial-gradient(ellipse 40% 50% at 100% 100%, rgba(155, 28, 44, .07), transparent 70%), var(--color-cream); }
  .gt-dust { position: absolute; left: 0; top: 0; width: 55%; height: 340px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 12% 18%, rgba(201,161,74,.55) 0 1.4px, transparent 2.5px),
      radial-gradient(circle at 28% 8%, rgba(201,161,74,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 44% 30%, rgba(201,161,74,.4) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 63% 14%, rgba(201,161,74,.4) 0 1.3px, transparent 2.3px);
    animation: sd-gt-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-gt-twinkle { from { opacity: .45; } to { opacity: 1; } }
  .gt-h1 { margin-top: 12px; font: 700 clamp(42px, 5.6vw, 72px)/1.05 var(--font-serif); color: var(--color-ink); }
  .gt-slogan { margin-top: 12px; font: italic 600 clamp(20px, 2vw, 25px)/1.3 var(--font-serif); color: var(--color-gold-600); }
  .gt-lead { margin-top: 14px; max-width: 34rem; font-size: 17px; line-height: 1.7; color: rgba(35, 24, 25, .78); }

  .gt-photo { position: relative; width: 100%; max-width: 26rem; margin: 0 auto; }
  .gt-glow { position: absolute; inset: 8% 4%; z-index: -1; border-radius: 50%; filter: blur(48px);
    background: radial-gradient(circle, rgba(224,191,110,.7), rgba(155,28,44,.3) 60%, transparent 75%); }
  .gt-frame { position: relative; border-radius: 2rem; padding: 6px; overflow: hidden;
    background: linear-gradient(140deg, #f6dc86, #b8862a 35%, #f0dca8 55%, #a8761f 80%, #e8c46a); box-shadow: 0 28px 56px -30px rgba(58, 9, 16, .55); }
  .gt-frame::before { content: ''; position: absolute; inset: 6px; border-radius: 1.65rem; z-index: 1; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 248, 225, .9), inset 0 0 0 4px rgba(184, 134, 42, .3); }
  .gt-frame :global(.gt-img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%; border-radius: 1.65rem; }
  .gt-tag { position: absolute; left: -26px; bottom: 12%; z-index: 3; display: flex; flex-direction: column; gap: 2px; padding: 10px 16px; border-radius: 16px;
    font-size: 12px; line-height: 1.3; color: rgba(251, 243, 230, .82);
    background: linear-gradient(180deg, rgba(99, 16, 28, .92), rgba(58, 9, 16, .94));
    box-shadow: 0 14px 30px -14px rgba(58, 9, 16, .8), inset 0 0 0 1px rgba(224, 191, 110, .55); }
  .gt-tag b { font-family: var(--font-serif); font-size: 20px; line-height: 1.1; color: var(--color-gold-300); }
  .gt-tag { animation: sd-gt-float 6s ease-in-out infinite; }
  .gt-tag-2 { left: auto; right: -26px; bottom: auto; top: 10%; animation-delay: -3s; }
  @keyframes sd-gt-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  /* nghiêng 3D + vệt sáng kính khi rê chuột (như ảnh khối Về chúng tôi trang chủ) */
  .gt-tilt { position: relative; transform-style: preserve-3d; transition: transform .5s cubic-bezier(.2,.8,.2,1); will-change: transform; }
  .gt-glare { position: absolute; inset: 6px; border-radius: 1.65rem; z-index: 2; pointer-events: none; opacity: 0; mix-blend-mode: soft-light;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255,250,230,.95), rgba(255,236,190,.3) 30%, transparent 60%); transition: opacity .4s; }
  .gt-tilt.on .gt-glare { opacity: 1; }

  .gt-stats { list-style: none; margin: 0; padding: 22px 8px; margin-bottom: 56px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 24px; background: linear-gradient(180deg, #fffdf8, #fbf5ea);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .55), 0 24px 50px -30px rgba(58, 9, 16, .45); }
  .gt-stats { position: relative; }
  .gt-stats::after { content: ''; position: absolute; inset: -1px; border-radius: 25px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .gt-stats:global(.is-in)::after { animation: sd-gt-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-gt-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }
  .gt-stats li { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 4px 12px; text-align: center; }
  .gt-stats li + li { border-left: 1px solid rgba(201, 161, 74, .3); }
  .gt-num { padding: 0 .04em; font: 700 clamp(30px, 3.2vw, 40px)/1.1 var(--font-serif);
    background: linear-gradient(180deg, #d9b25a 0%, #b8862a 50%, #7d5c1b 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .gt-lbl { font-size: 13.5px; color: var(--color-mute); }

  /* trích dẫn */

  /* chăm ngoài – uống trong */
  .gt-philo { position: relative; overflow: hidden; isolation: isolate;
    background: linear-gradient(90deg, #fcf5ea 0%, #fff 50%, #fcf0f0 100%); }
  .gt-philo::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 8% 20%, rgba(201,161,74,.5) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 22% 78%, rgba(201,161,74,.35) 0 1px, transparent 2px),
      radial-gradient(circle at 80% 16%, rgba(201,161,74,.45) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 93% 70%, rgba(201,161,74,.35) 0 1px, transparent 2px);
    animation: sd-gt-twinkle 5s ease-in-out infinite alternate; }

  .gt-pwrap { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 76px minmax(0, 1fr); align-items: stretch; max-width: 66rem; margin: 48px auto 0; }
  .gt-pwrap::before { /* đường vàng nối hai thẻ */
    content: ''; position: absolute; left: 20%; right: 20%; top: 50%; height: 1px; z-index: 0;
    background: linear-gradient(90deg, transparent, rgba(201, 161, 74, .8) 30%, rgba(201, 161, 74, .8) 70%, transparent); }

  .gt-pc { position: relative; z-index: 1; display: flex; flex-direction: column; overflow: hidden; border-radius: 26px;
    background: linear-gradient(180deg, #fff 0%, #fffdf8 55%, #fbf3e4 100%);
    box-shadow: 0 0 0 1px rgba(201, 161, 74, .4), 0 22px 46px -30px rgba(58, 9, 16, .5);
    transition: transform .8s cubic-bezier(.2, .8, .2, 1), box-shadow .45s, opacity .9s ease, filter .9s ease; }
  @media (hover: hover) and (pointer: fine) {
    .gt-pc-l:hover { transform: perspective(1100px) rotateY(5deg) translateY(-4px); }
    .gt-pc-r:hover { transform: perspective(1100px) rotateY(-5deg) translateY(-4px); }
