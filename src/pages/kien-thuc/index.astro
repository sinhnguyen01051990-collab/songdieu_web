---
/**
 * Trang Kiến thức (17/11/2026, đường dẫn mới /kien-thuc/ – /tin-tuc/ cũ chuyển hướng 301):
 * đầu trang đồng bộ trang Sản phẩm – nền kem có quầng + bụi vàng, tiêu đề viết hoa chữ đầu, "Chia Sẻ" có vệt vàng quét một lần.
 */
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Kiến thức & chia sẻ chăm sóc phụ nữ" description="Kiến thức chăm sóc vóc dáng, nội tiết tố nữ và hướng dẫn sử dụng sản phẩm SONG DIỆU."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Kiến thức', href: '/kien-thuc/' }]}>
  <section class="kt" aria-labelledby="kt-title">
    <span class="kt-dust" aria-hidden="true"></span>
    <div class="container-x kt-hero">
      <p class="eyebrow" data-reveal>Góc chăm sóc</p>
      <h1 id="kt-title" class="kt-h1" data-reveal>Kiến Thức &amp; <span class="kt-em italic">Chia Sẻ</span></h1>
      <p class="kt-sub" data-reveal>Hướng dẫn chăm sóc vóc dáng, nội tiết tố nữ và cách dùng sản phẩm SONG DIỆU đúng chuẩn.</p>
    </div>
    <div class="container-x pb-16 sm:pb-24">
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {posts.map((post, i) => <div class="min-w-0"><PostCard post={post} as="h2" eager={i < 3} /></div>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .kt { position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(224, 191, 110, .22), transparent 70%),
      radial-gradient(ellipse 40% 40% at 100% 60%, rgba(155, 28, 44, .05), transparent 70%),
      linear-gradient(180deg, var(--color-cream) 0, #fffdf9 50%, var(--color-cream) 100%); }
  .kt-dust { position: absolute; left: 20%; top: 0; width: 60%; height: 320px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 8% 30%, rgba(201,161,74,.5) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 24% 10%, rgba(201,161,74,.4) 0 1px, transparent 2px),
      radial-gradient(circle at 78% 14%, rgba(201,161,74,.45) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 94% 40%, rgba(201,161,74,.35) 0 1px, transparent 2px),
      radial-gradient(circle at 60% 4%, rgba(201,161,74,.3) 0 1.1px, transparent 2.1px);
    animation: sd-ktp-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-ktp-twinkle { from { opacity: .45; } to { opacity: 1; } }

  .kt-hero { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 56px; }
  .kt-h1 { margin-top: 14px; max-width: 48rem; font: 700 clamp(36px, 5vw, 64px)/1.08 var(--font-serif); color: var(--color-ink); }
  .kt-em { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .kt-em { animation: sd-ktp-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-ktp-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .kt-sub { margin-top: 16px; max-width: 40rem; font-size: 17px; line-height: 1.7; color: var(--color-mute); }
  @media (max-width: 640px) { .kt-hero { padding-top: 40px; } }
</style>
