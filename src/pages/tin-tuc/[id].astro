---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { Picture } from 'astro:assets';
import { getProduct } from '../../data/products';
import { postMeta } from '../../data/kien-thuc';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('tinTuc');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const product = post.data.product ? getProduct(post.data.product) : undefined;
const cover = post.data.image ?? product?.image;
const { topic, minutes } = postMeta(post);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  mainEntityOfPage: `${SITE.url}/tin-tuc/${post.id}/`,
  inLanguage: 'vi-VN',
};
---
<Base title={post.data.title} description={post.data.description} type="article" image={cover} jsonLd={[articleLd]}
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Kiến thức', href: '/tin-tuc/' }, { name: post.data.title, href: `/tin-tuc/${post.id}/` }]}>
  <article class="section">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="art-meta">
          {topic && <a href="/tin-tuc/" class="art-cat">{topic}</a>}
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('vi-VN')}</time>
          <span aria-hidden="true">·</span>{minutes} phút đọc
        </p>
        <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{post.data.title}</h1>
        <p class="mt-4 text-lg text-mute">{post.data.description}</p>
        {cover && (
          <div class="art-cover">
            <Picture src={cover} alt={post.data.title} width={1200} widths={[640, 960, 1200]} sizes="(min-width: 1024px) 720px, 92vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="art-img" />
          </div>
        )}
        <div class="prose-sd mt-8"><Content /></div>
      </div>
      {product && (
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <p class="mb-3 text-sm font-semibold text-mute">Sản phẩm liên quan</p>
          <ProductCard product={product} />
        </aside>
      )}
    </div>
  </article>
</Base>

<style>
  .art-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-size: 14px; color: var(--color-mute); }
  .art-meta > span { color: var(--color-gold-500); }
  .art-cat { padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--color-gold-300);
    background: linear-gradient(180deg, #63101c, #3a0910); box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .55); }
  .art-cover { position: relative; margin-top: 28px; border-radius: 26px; padding: 6px; overflow: hidden;
    background: linear-gradient(140deg, #f6dc86, #b8862a 35%, #f0dca8 55%, #a8761f 80%, #e8c46a);
    box-shadow: 0 28px 56px -32px rgba(58, 9, 16, .5); }
  .art-cover :global(.art-img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 30%; border-radius: 20px; }
</style>
