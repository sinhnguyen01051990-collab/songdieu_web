---
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Tin tức & kiến thức làm đẹp" description="Kiến thức chăm sóc vóc dáng, nội tiết tố nữ và hướng dẫn sử dụng sản phẩm SONG DIỆU."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Tin tức', href: '/tin-tuc/' }]}>
  <PageHero badge="Kiến thức làm đẹp" title="Tin tức & chia sẻ" sub="Hướng dẫn chăm sóc vóc dáng, nội tiết tố nữ và cách dùng sản phẩm SONG DIỆU đúng chuẩn." note="Đọc là hiểu" />
  <section class="section !pt-4">
    <div class="container-x">
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <a href={`/tin-tuc/${post.id}/`} class="card group block p-6 transition hover:-translate-y-1 hover:shadow-lg">
            <time class="text-xs text-mute" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('vi-VN')}</time>
            <h2 class="mt-2 text-xl font-bold group-hover:text-brand-600">{post.data.title}</h2>
            <p class="mt-3 text-sm text-mute">{post.data.description}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-gold-600">Đọc tiếp →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
