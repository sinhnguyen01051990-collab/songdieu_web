---
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Kiến thức & chia sẻ chăm sóc phụ nữ" description="Kiến thức chăm sóc vóc dáng, nội tiết tố nữ và hướng dẫn sử dụng sản phẩm SONG DIỆU."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Kiến thức', href: '/tin-tuc/' }]}>
  <PageHero badge="Góc chăm sóc" title="Kiến thức & chia sẻ" sub="Hướng dẫn chăm sóc vóc dáng, nội tiết tố nữ và cách dùng sản phẩm SONG DIỆU đúng chuẩn." note="Đọc là hiểu" />
  <section class="section !pt-4">
    <div class="container-x">
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {posts.map((post, i) => <div class="min-w-0"><PostCard post={post} as="h2" eager={i < 3} /></div>)}
      </div>
    </div>
  </section>
</Base>
