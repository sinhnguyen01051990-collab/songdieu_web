---
/**
 * Trang Sản phẩm (16/11/2026, đồng bộ trang chủ & Giới thiệu):
 * đầu trang nền kem có quầng + bụi vàng, tiêu đề có vệt vàng quét, 3 cam kết biểu tượng;
 * nút lọc Tất cả · Chăm Ngoài · Uống Trong (không tải lại trang); lưới căn giữa hàng cuối, thẻ hiện lần lượt;
 * cuối trang là khối Đăng ký tư vấn đỏ đô dùng chung với trang chủ.
 */
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ConsultSection from '../../components/ConsultSection.astro';
import { PRODUCTS } from '../../data/products';

// nhóm theo triết lý "Chăm ngoài – Uống trong" ở trang Giới thiệu
const OUTSIDE = new Set(['gel-gung-que-sdbody', 'but-gel-hoang-cung-bao-phu-khang']);
const group = (slug: string) => (OUTSIDE.has(slug) ? 'ngoai' : 'trong');
const FILTERS = [
  { k: 'all', t: 'Tất cả', n: PRODUCTS.length },
  { k: 'ngoai', t: 'Chăm Ngoài', n: PRODUCTS.filter((p) => group(p.slug) === 'ngoai').length },
  { k: 'trong', t: 'Uống Trong', n: PRODUCTS.filter((p) => group(p.slug) === 'trong').length },
];
const PROMISES = [
  { t: 'Freeship toàn quốc', i: '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>' },
  { t: 'Kiểm hàng rồi thanh toán', i: '<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>' },
  { t: '100% có hồ sơ công bố', i: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>' },
];
---
<Base
  title="Sản phẩm"
  description="Danh mục sản phẩm SONG DIỆU: Gel gừng quế SDBODY, viên uống nội tiết Xuân Nữ Nhan, Trà Táo Mèo, Bút gel Hoàng Cung Bảo Phụ Khang, Trà Mâm Xôi Tứ Vị. Freeship, kiểm hàng COD."
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Sản phẩm', href: '/san-pham/' }]}
>
  <section class="spl" aria-labelledby="spl-title">
    <span class="spl-dust" aria-hidden="true"></span>
    <div class="container-x spl-hero">
      <p class="eyebrow" data-reveal>Sản phẩm SONG DIỆU</p>
      <h1 id="spl-title" class="spl-h1" data-reveal>Thảo Dược Cho <span class="spl-em italic">Vẻ Đẹp An Nhiên</span></h1>
      <p class="spl-sub" data-reveal>Song Diệu – Hệ sinh thái thảo dược an toàn, lành tính chăm sóc sắc vóc và nội tiết trọn vẹn từ trong ra ngoài cho phụ nữ Việt.</p>
      <ul class="spl-promise" data-reveal>
        {PROMISES.map((p) => (
          <li><span class="spl-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.i} /></span>{p.t}</li>
        ))}
      </ul>
    </div>

    <div class="container-x pb-16 sm:pb-24">
      <div class="spl-filter" role="group" aria-label="Lọc sản phẩm theo nhu cầu" data-reveal>
        {FILTERS.map((f, i) => (
          <button type="button" class="spl-chip" data-f={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.t}<span>{f.n}</span></button>
        ))}
      </div>
      <div class="spl-grid" id="spl-grid" data-reveal-group>
        {PRODUCTS.map((p, i) => <div class="spl-cell" data-g={group(p.slug)}><ProductCard product={p} eager={i < 3} /></div>)}
      </div>
    </div>
  </section>

  <ConsultSection eyebrow="Tư vấn chọn sản phẩm" titleA="Chưa biết chọn sản phẩm nào?" titleEm="SONG DIỆU tư vấn miễn phí"
    sub="Để lại tên và số điện thoại, chuyên viên SONG DIỆU gọi lại tư vấn sản phẩm và liệu trình phù hợp với chị." />
</Base>

<style>
  .spl { position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(ellipse 50% 40% at 50% 0%, rgba(224, 191, 110, .22), transparent 70%),
      radial-gradient(ellipse 40% 40% at 100% 60%, rgba(155, 28, 44, .05), transparent 70%),
      linear-gradient(180deg, var(--color-cream) 0, #fffdf9 50%, var(--color-cream) 100%); }
  .spl-dust { position: absolute; left: 20%; top: 0; width: 60%; height: 320px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 8% 30%, rgba(201,161,74,.5) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 24% 10%, rgba(201,161,74,.4) 0 1px, transparent 2px),
      radial-gradient(circle at 78% 14%, rgba(201,161,74,.45) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 94% 40%, rgba(201,161,74,.35) 0 1px, transparent 2px),
      radial-gradient(circle at 60% 4%, rgba(201,161,74,.3) 0 1.1px, transparent 2.1px);
    animation: sd-spl-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-spl-twinkle { from { opacity: .45; } to { opacity: 1; } }

  .spl-hero { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 56px; padding-bottom: 8px; }
  .spl-h1 { margin-top: 14px; max-width: 48rem; font: 700 clamp(36px, 5vw, 64px)/1.08 var(--font-serif); color: var(--color-ink); }
  .spl-em { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .spl-em { animation: sd-spl-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-spl-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .spl-sub { margin-top: 16px; max-width: 40rem; font-size: 17px; line-height: 1.7; color: var(--color-mute); }

  .spl-promise { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 26px; }
  .spl-promise li { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 500; color: var(--color-ink); }
  .spl-ico { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--color-gold-300);
    background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%);
    box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .7), 0 6px 14px -8px rgba(58, 9, 16, .7); }

  /* nút lọc: viên tròn viền vàng, đang chọn thì đỏ đô chữ vàng */
  .spl-filter { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 44px; }
  .spl-chip { display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border-radius: 999px; font-size: 14.5px; font-weight: 600;
    color: var(--color-brand-700); background: rgba(255, 255, 255, .8); box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .7);
    transition: background .3s, color .3s, box-shadow .3s, transform .3s, opacity .9s, filter .9s; }
  .spl-chip span { min-width: 22px; padding: 1px 7px; border-radius: 999px; font-size: 12px; background: rgba(224, 191, 110, .25); color: var(--color-gold-600); }
  .spl-chip:hover { transform: translateY(-1px); box-shadow: inset 0 0 0 1px var(--color-gold-500), 0 0 0 4px rgba(224, 191, 110, .14); }
  .spl-chip[aria-pressed="true"] { color: var(--color-gold-300); background: linear-gradient(180deg, var(--color-brand-500), var(--color-brand-700));
    box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .7), 0 8px 18px -10px rgba(99, 16, 28, .7); }
  .spl-chip[aria-pressed="true"] span { background: rgba(255, 243, 196, .18); color: #fff3c4; }

  /* lưới căn giữa hàng cuối như trang chủ */
  .spl-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 32px; }
  .spl-cell { width: 100%; }
  .spl-cell.is-show { animation: sd-spl-in .5s cubic-bezier(.2,.8,.2,1) both; }
  @keyframes sd-spl-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @media (min-width: 640px) { .spl-cell { width: calc((100% - 24px) / 2); } }
  @media (min-width: 1024px) { .spl-grid { gap: 28px; } .spl-cell { width: calc((100% - 56px) / 3); } }
  @media (max-width: 640px) { .spl-hero { padding-top: 40px; } .spl-promise { flex-direction: column; align-items: flex-start; } }
</style>

<script>
  // lọc theo nhu cầu: chỉ ẩn/hiện thẻ, không tải lại trang
  const chips = document.querySelectorAll<HTMLButtonElement>('.spl-chip');
  const cells = document.querySelectorAll<HTMLElement>('.spl-cell');
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.dataset.f;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    cells.forEach((el) => {
      const show = f === 'all' || el.dataset.g === f;
      el.hidden = !show;
      el.classList.remove('is-show');
      if (show) { void el.offsetWidth; el.classList.add('is-show'); }
    });
  }));
</script>
