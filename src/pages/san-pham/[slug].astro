---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, type Product, formatVnd, minPrice } from '../../data/products';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
interface Props { product: Product }
const { product: p } = Astro.props;
const url = `${SITE.url}/san-pham/${p.slug}/`;
const imgUrl = p.image ? new URL((await getImage({ src: p.image, width: 1200, format: 'jpg' })).src, Astro.site).href : `${SITE.url}/logo.png`;
const priceValidUntil = `${new Date().getFullYear() + 1}-12-31`;

const productLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.sku,
  image: imgUrl,
  description: p.description,
  brand: { '@type': 'Brand', name: 'SONG DIỆU' },
  manufacturer: { '@id': `${SITE.url}/#org` },
  ...(p.offers.length && {
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'VND',
      lowPrice: minPrice(p),
      highPrice: Math.max(...p.offers.map((o) => o.price)),
      offerCount: p.offers.length,
      availability: 'https://schema.org/InStock',
      url,
      priceValidUntil,
      seller: { '@id': `${SITE.url}/#org` },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: 0, currency: 'VND' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'VN' },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 1, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 3, unitCode: 'DAY' },
        },
      },
    },
  }),
};
const faqLd = p.faq.length
  ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
  : [];
const fullUrls = await Promise.all(p.gallery.map(async (g) => (await getImage({ src: g.src, width: 900, format: 'webp' })).src));
// ảnh to khi bấm xem (đọc rõ chữ trên ảnh công dụng/thành phần) – chỉ tải khi khách mở
const zoomUrls = await Promise.all(p.gallery.map(async (g) => (await getImage({ src: g.src, width: 1400, format: 'webp' })).src));
const bestOffer = p.offers.find((o) => o.best) ?? p.offers[0];
const lowest = minPrice(p);
const others = PRODUCTS.filter((x) => x.slug !== p.slug).slice(0, 3);
// biểu tượng nét mảnh thay biểu tượng cảm xúc (16/11/2026), cùng kiểu khối Sản Xuất Đạt Chuẩn
const ico = (d: string, size = 18) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
// biểu tượng nét mảnh cho từng thành phần
const ING_ICO: Record<string, string> = {
  flame: '<path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2.5 1.5-3.5 2-5 .8 1.5 1.5 2 2.5 2C11.5 7.5 11 5.5 12 3z"/>',
  bark: '<path d="M7 20c-1.5-5 0-11 4-16"/><path d="M12 20c-1.5-5 0-11 4-16"/><path d="M17 20c-1-3-.5-6 1-9"/>',
  flower: '<circle cx="12" cy="12" r="2.5"/><path d="M12 9.5C10 6 10.5 3.5 12 3c1.5.5 2 3 0 6.5zM12 14.5c2 3.5 1.5 6 0 6.5-1.5-.5-2-3 0-6.5zM9.5 12C6 10 3.5 10.5 3 12c.5 1.5 3 2 6.5 0zM14.5 12c3.5 2 6 1.5 6.5 0-.5-1.5-3-2-6.5 0z"/>',
  drop: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  root: '<path d="M12 3v5"/><path d="M12 8c-3 0-4 3-4 6s2 6 4 6 4-3 4-6-1-6-4-6z"/><path d="M8 16l-3 2M16 16l3 2"/>',
  leaf: '<path d="M5 19c0-8 6-14 15-14-1 9-6 15-14 15"/><path d="M5 19c3-4 6-6 9-7"/>',
  moon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
  seed: '<ellipse cx="12" cy="12" rx="5" ry="8"/><path d="M12 5v14"/>',
  clover: '<circle cx="12" cy="8" r="3"/><circle cx="8" cy="13" r="3"/><circle cx="16" cy="13" r="3"/><path d="M12 15v6"/>',
  sparkle: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  heart: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  berry: '<circle cx="9" cy="14" r="3"/><circle cx="15" cy="14" r="3"/><circle cx="12" cy="9" r="3"/><path d="M12 6V3"/>',
};
const PROMISES = [
  { t: 'Freeship toàn quốc, giao 2–3 ngày', i: '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>' },
  { t: 'Được kiểm hàng trước khi thanh toán', i: '<path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>' },
  { t: 'Thẻ bảo hành kèm mỗi đơn hàng', i: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>' },
  { t: 'Đổi 1–1 nếu sản phẩm lỗi', i: '<path d="M4 9a8 8 0 0 1 14-3l2 2"/><path d="M20 4v4h-4"/><path d="M20 15a8 8 0 0 1-14 3l-2-2"/><path d="M4 20v-4h4"/>' },
];
---
<Base
  title={p.name}
  description={p.description}
  image={p.image}
  type="product"
  jsonLd={[productLd, ...faqLd]}
  breadcrumbs={[{ name: 'Trang chủ', href: '/' }, { name: 'Sản phẩm', href: '/san-pham/' }, { name: p.name, href: `/san-pham/${p.slug}/` }]}
>
  <!-- TOP -->
  <section class="section !pt-10 spd-top">
    <span class="spd-dust" aria-hidden="true"></span>
    <!-- bố cục: máy tính ảnh + công dụng bên trái, tên + giá + đặt hàng bên phải (hai cột cân nhau);
         điện thoại: ảnh → tên, giá → công dụng → đặt hàng (17/11/2026) -->
    <div class="container-x spd-grid">
      <!-- Gallery: bấm ảnh xem to; điện thoại vuốt ngang -->
      <div class="spd-gal">
        {p.gallery.length > 0 ? (
          <div class="space-y-3">
            <div class="spd-frame" id="spd-frame" data-zoom={JSON.stringify(zoomUrls)} data-full={JSON.stringify(fullUrls)} data-alts={JSON.stringify(p.gallery.map((g) => g.alt))}>
              <button type="button" class="spd-zoom" aria-label="Xem ảnh lớn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg></button>
              {p.gallery.length > 1 && <span class="spd-dots" aria-hidden="true">{p.gallery.map((_, i) => <i class={i === 0 ? 'on' : ''} />)}</span>}
              <Picture id="main-img" src={p.gallery[0].src} alt={p.gallery[0].alt} widths={[420, 640, 900]} sizes="(min-width: 1024px) 560px, 100vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="eager" fetchpriority="high" class="spd-main aspect-square w-full object-contain" />
            </div>
            {p.gallery.length > 1 && (
              <div class="grid grid-cols-4 gap-3 sm:grid-cols-6">
                {p.gallery.map((g, i) => (
                  <button type="button" class="thumb spd-thumb" data-active={i === 0 ? '' : undefined} aria-label={`Xem ảnh: ${g.alt}`}>
                    <Picture src={g.src} alt="" width={160} height={160} formats={['avif', 'webp']} fallbackFormat="webp" class="aspect-square w-full object-cover" data-full={fullUrls[i]} loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="flex aspect-square flex-col items-center justify-center rounded-3xl bg-gradient-to-br from-brand-600 to-brand-900 text-white">
            <span class="font-serif text-7xl font-bold text-gold-300">SD</span>
            <span class="mt-4 font-serif text-2xl">{p.shortName}</span>
            <span class="mt-2 text-sm text-white/60">Ảnh sản phẩm đang cập nhật</span>
          </div>
        )}
      </div>

      <div class="spd-head">
        <p class="eyebrow">{p.category}</p>
        <h1 class="mt-2 text-4xl font-bold sm:text-5xl">{p.name}</h1>
        <p class="mt-3 text-lg text-mute">{p.tagline}</p>
        <div class="spd-pr">
          <p class="spd-pr-v">{lowest ? <><span>Từ</span> {formatVnd(lowest)}</> : 'Liên hệ báo giá'}</p>
          <ul class="spd-pr-tags">
            <li><span set:html={ico(PROMISES[0].i, 15)} />Freeship toàn quốc</li>
            <li><span set:html={ico(PROMISES[1].i, 15)} />Kiểm hàng rồi thanh toán</li>
          </ul>
        </div>
      </div>

      <div class="spd-ben">
        <p class="spd-ben-t">Công dụng nổi bật <span>· Quy cách: {p.size}</span></p>
        <ul class="spd-benefits">
          {p.benefits.map((b) => <li><span class="spd-check" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"/></svg></span>{b}</li>)}
        </ul>
      </div>

        <div id="dat-hang" class="spd-order" data-reveal>
          {p.offers.length > 0 ? (
            <>
              <p class="spd-order-t">Đặt hàng – Freeship toàn quốc</p>
              <LeadForm product={p} variant="order" />
            </>
          ) : (
            <>
              <p class="spd-order-t !mb-2">Liên hệ để nhận báo giá</p>
              <p class="mb-4 text-sm text-mute">Để lại họ tên + SĐT, nhân viên báo giá và lên đơn cho chị ngay ạ.</p>
              <LeadForm product={p} variant="order" />
            </>
          )}
        </div>
    </div>
  </section>

  <!-- DETAILS -->
  <section class="section bg-white !pt-16 spd-cv">
    <div class="container-x grid gap-12 lg:grid-cols-3">
      <article class="prose-sd spd-prose lg:col-span-2">
        {p.ingredients.length > 0 && (
          <>
            <h2>Thành Phần Chính</h2>
            {p.ingredientsIntro && <p class="spd-ing-intro">{p.ingredientsIntro}</p>}
            <ul class="not-prose spd-ings" data-reveal-group>
              {p.ingredients.map((i) => (
                <li class="spd-ing">
                  <span class="spd-ing-ico" set:html={ico(ING_ICO[i.icon ?? 'leaf'] ?? ING_ICO.leaf, 20)} />
                  <span class="spd-ing-txt">
                    <span class="spd-ing-name">{i.name}{i.amount && <span class="spd-ing-amt">{i.amount}</span>}</span>
                    <span class="spd-ing-desc">{i.desc}</span>
                  </span>
                </li>
              ))}
            </ul>
          </>
        )}
        <h2>Hướng Dẫn Sử Dụng</h2>
        <ol>{p.usage.map((u) => <li>{u}</li>)}</ol>
        <h2>Lưu Ý Khi Dùng</h2>
        <ul>{p.notes.map((n) => <li>{n}</li>)}</ul>
        {p.faq.length > 0 && (
          <>
            <h2>Câu Hỏi Thường Gặp</h2>
            <div class="not-prose space-y-3">
              {p.faq.map((f) => (
                <details class="spd-faq">
                  <summary>
                    {f.q}<span class="spd-plus" aria-hidden="true"></span>
                  </summary>
                  <p class="mt-3 text-sm leading-relaxed text-mute">{f.a}</p>
                </details>
              ))}
            </div>
          </>
        )}
      </article>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        <!-- ô "Đơn của bạn": combo đang chọn ở form + tổng tiền (thay bảng giá lặp, 17/11/2026) -->
        <div class="card spd-price p-6">
          <p class="spd-price-t">Đơn của bạn</p>
          {bestOffer ? (
            <div class="spd-sum">
              <p class="spd-sum-k">{p.shortName}</p>
              <p class="spd-sum-l" data-offer-label>{bestOffer.label}</p>
              <p class="spd-sum-p"><span>Tổng</span><b data-offer-price>{formatVnd(bestOffer.price)}</b></p>
              <p class="spd-sum-n">Freeship · thanh toán khi nhận hàng</p>
            </div>
          ) : <p class="mt-3 text-sm text-mute">Liên hệ hotline để nhận báo giá.</p>}
          <a href="#dat-hang" class="btn-primary mt-5 w-full">{bestOffer ? 'Đặt hàng ngay' : 'Để lại thông tin'}</a>
          <a href={`tel:${SITE.phone}`} class="btn spd-call mt-2 w-full">Gọi {SITE.phoneDisplay}</a>
        </div>
        <ul class="card spd-promise p-5">
          {PROMISES.map((x) => <li><span class="spd-ico" set:html={ico(x.i)} />{x.t}</li>)}
        </ul>
      </aside>
    </div>
  </section>


  <!-- RELATED -->
  <section class="section spd-cv spd-rel" aria-labelledby="spd-rel-title">
    <div class="container-x">
      <div class="text-center" data-reveal>
        <p class="eyebrow">Gợi ý cho bạn</p>
        <h2 id="spd-rel-title" class="mt-3 text-4xl font-bold sm:text-5xl">Có Thể Bạn <span class="spd-em italic">Cũng Thích</span></h2>
      </div>
      <div class="spd-rgrid mt-10" data-reveal-group>
        {others.map((o) => <div class="spd-rcell"><ProductCard product={o} /></div>)}
      </div>
    </div>
  </section>

  <!-- Mobile sticky CTA -->
  <div class="spd-bar md:hidden" id="spd-bar">
    <a href={`tel:${SITE.phone}`} class="spd-bar-call" aria-label={`Gọi ${SITE.phoneDisplay}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg></a>
    {bestOffer ? (
      <span class="spd-bar-info"><span data-offer-label>{bestOffer.label}</span><b data-offer-price>{formatVnd(bestOffer.price)}</b></span>
    ) : <span class="spd-bar-info"><span>{p.shortName}</span><b>Liên hệ báo giá</b></span>}
    <a href="#dat-hang" class="btn-primary spd-bar-go">Đặt ngay</a>
  </div>

  <!-- xem ảnh lớn -->
  {p.gallery.length > 0 && (
    <dialog class="spd-lb" id="spd-lb" aria-label="Xem ảnh sản phẩm">
      <img id="spd-lb-img" alt="" />
      <p class="spd-lb-cap" id="spd-lb-cap"></p>
      <button type="button" class="spd-lb-x" data-lb="close" aria-label="Đóng"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      {p.gallery.length > 1 && <>
        <button type="button" class="spd-lb-nav spd-lb-prev" data-lb="prev" aria-label="Ảnh trước"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button type="button" class="spd-lb-nav spd-lb-next" data-lb="next" aria-label="Ảnh sau"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      </>}
    </dialog>
  )}
</Base>

<script>
  // ảnh sản phẩm: đổi ảnh mờ dần, bấm xem lớn, vuốt ngang trên điện thoại (17/11/2026)
  const main = document.getElementById('main-img') as HTMLImageElement | null;
  const frame = document.getElementById('spd-frame');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  const dots = [...document.querySelectorAll<HTMLElement>('.spd-dots i')];
  const full: string[] = frame ? JSON.parse(frame.dataset.full || '[]') : [];
  const zoom: string[] = frame ? JSON.parse(frame.dataset.zoom || '[]') : [];
  const alts: string[] = frame ? JSON.parse(frame.dataset.alts || '[]') : [];
  let cur = 0;
  const go = (i: number) => {
    if (!main || !full.length) return;
    cur = (i + full.length) % full.length;
    main.closest('picture')?.querySelectorAll('source').forEach((s) => s.remove());
    main.srcset = '';
    main.classList.add('is-fade');
    const next = new Image();
    next.onload = next.onerror = () => { main.src = full[cur]; main.alt = alts[cur] || ''; requestAnimationFrame(() => main.classList.remove('is-fade')); };
    next.src = full[cur];
    thumbs.forEach((t, k) => t.toggleAttribute('data-active', k === cur));
    dots.forEach((d, k) => d.classList.toggle('on', k === cur));
    if (full[cur + 1]) new Image().src = full[cur + 1]; // tải trước ảnh kế
  };
  thumbs.forEach((btn, i) => btn.addEventListener('click', () => go(i)));

  // vuốt ngang ảnh chính
  let x0 = 0, y0 = 0;
  frame?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  frame?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) go(cur + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // xem ảnh lớn
  const lb = document.getElementById('spd-lb') as HTMLDialogElement | null;
  const lbImg = document.getElementById('spd-lb-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('spd-lb-cap');
  let li = 0;
  const show = (i: number) => {
    if (!lbImg || !zoom.length) return;
    li = (i + zoom.length) % zoom.length;
    lbImg.src = zoom[li]; lbImg.alt = alts[li] || '';
    if (lbCap) lbCap.textContent = `${li + 1} / ${zoom.length} · ${alts[li] || ''}`;
    if (zoom[li + 1]) new Image().src = zoom[li + 1];
  };
  const open = () => { if (!lb) return; show(cur); lb.showModal(); };
  frame?.querySelector('.spd-zoom')?.addEventListener('click', open);
  main?.addEventListener('click', open);
  lb?.addEventListener('click', (e) => {
    const k = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (k === 'close' || e.target === lb) lb.close();
    else if (k === 'prev') show(li - 1);
    else if (k === 'next') show(li + 1);
  });
  lb?.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(li - 1); if (e.key === 'ArrowRight') show(li + 1); });
  let lx = 0;
  lb?.addEventListener('touchstart', (e) => { lx = e.touches[0].clientX; }, { passive: true });
  lb?.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - lx; if (Math.abs(dx) > 45) show(li + (dx < 0 ? 1 : -1)); }, { passive: true });

  // combo đang chọn ở form → ô "Đơn của bạn" và thanh điện thoại
  const setOffer = (label?: string, price?: string) => {
    if (label) document.querySelectorAll('[data-offer-label]').forEach((el) => (el.textContent = label));
    if (price) document.querySelectorAll('[data-offer-price]').forEach((el) => (el.textContent = price));
  };
  window.addEventListener('sd-offer', (e) => { const d = (e as CustomEvent).detail; setOffer(d.label, d.price); });
  const chk = document.querySelector<HTMLInputElement>('#dat-hang input[name=offer]:checked');
  if (chk) setOffer(chk.dataset.label, Number(chk.dataset.price).toLocaleString('vi-VN') + 'đ');

  // thanh Gọi / Đặt hàng trên điện thoại tự ẩn khi khách đang ở ngay form đặt hàng
  const bar = document.getElementById('spd-bar');
  const order = document.getElementById('dat-hang');
  if (bar && order && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-off', e.isIntersecting), { threshold: 0.15 }).observe(order);
  }
</script>

