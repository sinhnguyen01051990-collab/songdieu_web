---
/**
 * Thẻ sản phẩm đồng bộ phong cách đầu trang (15/11/2026):
 * nền trắng → kem, viền vàng mảnh sáng lên khi rê chuột, đường vàng mảnh trong ảnh,
 * vệt sáng vàng lướt qua ảnh, nhãn loại đỏ đô chữ vàng, giá nổi bật, nút tròn mũi tên.
 */
import { Image } from 'astro:assets';
import { type Product, formatVnd, minPrice } from '../data/products';
interface Props { product: Product; eager?: boolean }
const { product: p, eager = false } = Astro.props;
const price = minPrice(p);
const href = `/san-pham/${p.slug}/`;
---
<article class="pc">
  <a href={href} class="pc-media" tabindex="-1" aria-hidden="true">
    {p.image ? (
      <Image src={p.image} alt={p.name} width={600} height={600} widths={[320, 480, 600]} sizes="(min-width: 1024px) 360px, (min-width: 640px) 46vw, 92vw" loading={eager ? 'eager' : 'lazy'} class="pc-img" />
    ) : (
      <div class="flex h-full w-full flex-col items-center justify-center bg-gradient-to-br from-brand-600 to-brand-900 p-6 text-center text-white">
        <span class="font-serif text-4xl font-bold text-gold-300">SD</span>
        <span class="mt-3 font-serif text-xl font-semibold">{p.shortName}</span>
        <span class="mt-1 text-xs text-white/60">Ảnh sản phẩm đang cập nhật</span>
      </div>
    )}
    <span class="pc-shine"></span>
    <span class="pc-cat">{p.category}</span>
  </a>
  <div class="pc-body">
    <h3 class="pc-name"><a href={href}>{p.name}</a></h3>
    <p class="pc-tag line-clamp-2">{p.tagline}</p>
    <div class="pc-foot">
      <p class="pc-price">{price ? <>Từ <b>{formatVnd(price)}</b></> : <b>Liên hệ</b>}</p>
      <a href={href} class="pc-go" aria-label={`Xem chi tiết ${p.name}`} title="Xem chi tiết">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .pc { position: relative; display: flex; flex-direction: column; height: 100%; padding: 8px; border-radius: 26px;
    background: linear-gradient(180deg, #fff 0%, #fffdf8 55%, #fbf3e4 100%);
    box-shadow: 0 0 0 1px rgba(201, 161, 74, .38), 0 18px 40px -28px rgba(58, 9, 16, .45);
    transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
  .pc:hover { transform: translateY(-6px);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .95), 0 0 0 5px rgba(224, 191, 110, .14), 0 30px 50px -26px rgba(99, 16, 28, .55); }

  /* ảnh: bo góc trong, đường vàng mảnh, vệt sáng lướt qua khi rê chuột */
  .pc-media { position: relative; display: block; aspect-ratio: 1; overflow: hidden; border-radius: 19px; background: var(--color-brand-50); }
  .pc-media::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .75), inset 0 0 0 4px rgba(255, 250, 235, .18); }
  .pc-media :global(.pc-img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .7s cubic-bezier(.2, .8, .2, 1); }
  .pc:hover .pc-media :global(.pc-img) { transform: scale(1.05); }
  .pc-shine { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 240, 200, .5) 50%, transparent 65%);
    transform: translateX(-130%); transition: transform 1s ease; }
  .pc:hover .pc-shine { transform: translateX(130%); }

  /* nhãn loại: đỏ đô chữ vàng như nhãn ở khối Về chúng tôi */
  .pc-cat { position: absolute; left: 12px; top: 12px; z-index: 2; padding: 5px 12px; border-radius: 999px;
    font-size: 12px; font-weight: 600; letter-spacing: .02em; color: var(--color-gold-300);
    background: linear-gradient(180deg, rgba(99, 16, 28, .9), rgba(58, 9, 16, .92));
    box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .55), 0 6px 14px -8px rgba(58, 9, 16, .8);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }

  .pc-body { flex: 1; display: flex; flex-direction: column; padding: 18px 14px 10px; }
  .pc-name { font-family: var(--font-serif); font-size: 21px; font-weight: 700; line-height: 1.25; color: var(--color-ink); text-wrap: balance; }
  .pc-name a { transition: color .3s; }
  .pc-name a:hover { color: var(--color-brand-600); }
  .pc-tag { flex: 1; margin-top: 8px; font-size: 14px; line-height: 1.55; color: var(--color-mute); }

  .pc-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; padding-top: 14px;
    border-top: 1px solid rgba(201, 161, 74, .28); }
  .pc-price { font-size: 13px; color: var(--color-mute); }
  .pc-price b { margin-left: 2px; font-size: 20px; font-weight: 700; color: var(--color-brand-700); }

  /* nút tròn mũi tên: viền vàng, rê chuột tô đỏ đô */
  .pc-go { position: relative; flex: none; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 999px; overflow: hidden;
    color: var(--color-brand-700); background: linear-gradient(180deg, #fdf8ec, #f4e8cc);
    box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .8), 0 4px 10px -6px rgba(125, 92, 27, .5);
    transition: color .35s, box-shadow .35s; }
  .pc-go::before { content: ''; position: absolute; inset: 0; border-radius: inherit; opacity: 0; transition: opacity .35s;
    background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%); }
  .pc-go svg { position: relative; transition: transform .35s; }
  .pc:hover .pc-go { color: var(--color-gold-300); box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .6), 0 8px 16px -8px rgba(99, 16, 28, .8); }
  .pc:hover .pc-go::before { opacity: 1; }
  .pc:hover .pc-go svg { transform: translateX(2px); }

  @media (prefers-reduced-motion: reduce) {
    .pc, .pc-shine, .pc-media :global(.pc-img) { transition: none; }
  }
</style>
