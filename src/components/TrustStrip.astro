---
/**
 * Dải cam kết dạng thẻ nổi nằm vắt ngang ranh giới đỏ đô – kem (gói A, 14/11/2026).
 * Sửa 14/11: không kéo thẻ đè lên phần đầu trang nữa (che nút "Chọn sản phẩm cho tôi" ở màn thấp);
 * thay vào đó nửa trên của khối này tô màu đỏ đô tiếp nối nền đầu trang.
 * Biểu tượng nét vàng trên vòng tròn đỏ đô cho cùng màu với đầu trang; rê chuột có ánh sáng lướt qua.
 */
import { COMMITMENTS } from '../data/site';

// mô tả rút gọn 1 dòng (bản đầy đủ vẫn dùng ở trang Giới thiệu); dấu cách không ngắt quanh "2–3 ngày", "trước – trong – sau"
const SHORT = [
  'Kiểm nghiệm theo Bộ Y tế',
  'Freeship combo · 2–3 ngày',
  'Xem hàng rồi mới trả tiền',
  'Trước – trong – sau khi dùng',
];
// biểu tượng nét mảnh (pathLength=1 để vẽ nét khi cuộn tới): chính hãng · giao hàng · kiểm hàng COD · tư vấn
const ICONS = [
  '<path pathLength="1" d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path pathLength="1" d="M9 12l2 2 4-4"/>',
  '<path pathLength="1" d="M3 7h11v9H3z"/><path pathLength="1" d="M14 10h4l3 3v3h-7"/><circle pathLength="1" cx="7" cy="17.5" r="1.8"/><circle pathLength="1" cx="17.5" cy="17.5" r="1.8"/>',
  '<path pathLength="1" d="M21 8l-9-5-9 5 9 5z"/><path pathLength="1" d="M3 8v8l9 5 9-5V8"/><path pathLength="1" d="M12 13v8"/>',
  '<path pathLength="1" d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path pathLength="1" d="M8.5 11.5c.6 1.5 2 2.8 3.5 3.3"/>',
];
---
<section class="trust-wrap" aria-label="Cam kết của SONG DIỆU">
  <span class="band" aria-hidden="true"></span>
  <div class="trust-in">
    <ul class="trust" data-reveal>
      {COMMITMENTS.map((c, i) => (
        <li class="item" style={`--i:${i}`}>
          <span class="ico">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} />
          </span>
          <span class="txt">
            <span class="t">{c.title}</span>
            <span class="d">{SHORT[i]}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* nền: nửa trên đỏ đô nối liền đáy phần đầu trang, mép dưới cong như băng ảnh, vạch vàng chạy theo mép cong */
  .trust-wrap { position: relative; z-index: 5; padding: 18px 0 10px; overflow-x: clip; }
  .band {
    position: absolute; left: -12%; right: -12%; top: 0; height: calc(50% + 22px); z-index: -1; pointer-events: none;
    border-radius: 0 0 50% 50% / 0 0 64px 64px;
    background:
      radial-gradient(ellipse 50% 160% at 50% 0%, rgba(201, 161, 74, .16), transparent 70%),
      #2b070d;
    box-shadow: 0 1px 0 rgba(224, 191, 110, .55), 0 14px 30px -18px rgba(58, 9, 16, .5);
  }
  .trust-in { max-width: 1240px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .trust {
    list-style: none; margin: 0; padding: 22px 8px;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 24px;
    background: linear-gradient(180deg, #fffdf8, #fbf5ea);
    box-shadow: 0 24px 50px -28px rgba(58, 9, 16, .55), 0 0 0 1px rgba(224, 191, 110, .55), inset 0 1px 0 #fff;
    position: relative;
  }
  .trust::before { /* điểm sáng ở mép trên */
    content: ''; position: absolute; left: 10%; right: 10%; top: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, #f0dca8, transparent);
  }
  /* tia sáng chạy một vòng quanh viền khi cuộn tới */
  .trust::after {
    content: ''; position: absolute; inset: -1px; border-radius: 25px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .trust:global(.is-in)::after { animation: sd-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }

  .item { display: flex; align-items: center; gap: 14px; padding: 4px 22px; min-width: 0; transition: transform .35s cubic-bezier(.2, .8, .2, 1); }
  .item + .item { border-left: 1px solid rgba(201, 161, 74, .3); }
  .item:hover { transform: translateY(-2px); }

  /* biểu tượng nhẹ: nền champagne, viền vàng, nét đỏ đô; rê chuột chuyển đỏ đô + nét vàng + ánh lướt */
  .ico {
    position: relative; overflow: hidden; flex: none;
    width: 46px; height: 46px; border-radius: 999px; display: grid; place-items: center;
    color: var(--color-brand-600);
    background: linear-gradient(180deg, #fdf8ec, #f4e8cc);
    box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .7), 0 4px 10px -6px rgba(125, 92, 27, .5);
    transition: color .35s, background .35s, box-shadow .35s;
  }
  .ico::before { /* lớp đỏ đô hiện khi rê chuột */
    content: ''; position: absolute; inset: 0; border-radius: inherit; opacity: 0; transition: opacity .35s;
    background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%);
  }
  .ico svg { position: relative; }
  .ico::after { /* ánh sáng lướt qua */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 240, 200, .6) 50%, transparent 65%);
    transform: translateX(-130%); transition: transform .8s ease;
  }
  .item:hover .ico { color: var(--color-gold-300); box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .6), 0 8px 16px -8px rgba(99, 16, 28, .8); }
  .item:hover .ico::before { opacity: 1; }
  .item:hover .ico::after { transform: translateX(130%); }

  /* nét biểu tượng tự vẽ lần lượt khi cuộn tới */
  :global(.rv) .trust[data-reveal]:not(:global(.is-in)) .ico :global(svg *) { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .trust:global(.is-in) .ico :global(svg *) { stroke-dasharray: 1; animation: sd-draw .9s cubic-bezier(.4, 0, .2, 1) both; animation-delay: calc(.35s + var(--i) * .18s); }
  @keyframes sd-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

  .txt { min-width: 0; }
  .t { display: block; font-weight: 600; color: var(--color-ink); line-height: 1.3; }
  .d { display: block; margin-top: 2px; font-size: 13.5px; line-height: 1.4; color: var(--color-mute); text-wrap: balance; }
  @media (min-width: 1180px) { .d { white-space: nowrap; } }

  @media (max-width: 1023px) {
    .trust { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 18px; padding: 18px 4px; }
    .item { padding: 4px 14px; }
    .item:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 820px) {
    .band { border-radius: 0 0 50% 50% / 0 0 32px 32px; }
    .item { flex-direction: column; text-align: center; gap: 10px; padding: 4px 8px; }
    .ico { width: 42px; height: 42px; }
    .d { font-size: 12.5px; }
  }
</style>
