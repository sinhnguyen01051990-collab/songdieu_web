---
/**
 * Dải cam kết dạng thẻ nổi, đè nhẹ lên mép dưới phần đầu trang (gói A, 14/11/2026).
 * Biểu tượng nét vàng trên vòng tròn đỏ đô cho cùng màu với đầu trang; rê chuột có ánh sáng lướt qua.
 */
import { COMMITMENTS } from '../data/site';

// mô tả rút gọn 1 dòng (bản đầy đủ vẫn dùng ở trang Giới thiệu)
const SHORT = [
  'Công bố & kiểm nghiệm theo Bộ Y tế',
  'Freeship combo, giao 2–3 ngày',
  'Xem hàng trước, nhận rồi mới trả tiền',
  'Đồng hành trước – trong – sau',
];
// biểu tượng nét mảnh: chính hãng · giao hàng · kiểm hàng COD · tư vấn
const ICONS = [
  '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>',
  '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>',
  '<path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>',
  '<path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path d="M8.5 11.5c.6 1.5 2 2.8 3.5 3.3"/>',
];
---
<section class="trust-wrap" aria-label="Cam kết của SONG DIỆU">
  <div class="container-x">
    <ul class="trust" data-reveal>
      {COMMITMENTS.map((c, i) => (
        <li class="item">
          <span class="ico">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[i]} />
          </span>
          <span class="txt">
            <span class="t">{c.title}</span>
            <span class="d">{SHORT[i]}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-wrap { position: relative; z-index: 5; margin-top: -40px; }
  .trust {
    list-style: none; margin: 0; padding: 22px 8px;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 24px;
    background: linear-gradient(180deg, #fffdf8, #fbf5ea);
    box-shadow: 0 24px 50px -28px rgba(58, 9, 16, .55), 0 0 0 1px rgba(224, 191, 110, .55), inset 0 1px 0 #fff;
    position: relative;
  }
  /* viền vàng sáng ở mép trên, nối với vạch vàng đáy phần đầu trang */
  .trust::before {
    content: ''; position: absolute; left: 10%; right: 10%; top: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, #f0dca8, transparent);
  }
  .item { display: flex; align-items: center; gap: 14px; padding: 4px 22px; min-width: 0; }
  .item + .item { border-left: 1px solid rgba(201, 161, 74, .3); }
  .ico {
    position: relative; overflow: hidden; flex: none;
    width: 50px; height: 50px; border-radius: 999px; display: grid; place-items: center;
    color: var(--color-gold-300);
    background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%);
    box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .55), 0 6px 14px -8px rgba(99, 16, 28, .8);
  }
  .ico::after { /* ánh sáng lướt qua */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 240, 200, .55) 50%, transparent 65%);
    transform: translateX(-130%); transition: transform .8s ease;
  }
  .item:hover .ico::after { transform: translateX(130%); }
  .txt { min-width: 0; }
  .t { display: block; font-weight: 600; color: var(--color-ink); line-height: 1.3; }
  .d { display: block; margin-top: 2px; font-size: 13.5px; line-height: 1.35; color: var(--color-mute); }

  @media (max-width: 1023px) {
    .trust { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 18px; padding: 18px 4px; }
    .item { padding: 4px 14px; }
    .item:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 820px) {
    .trust-wrap { margin-top: -24px; }
    .item { flex-direction: column; text-align: center; gap: 10px; padding: 4px 8px; }
    .ico { width: 44px; height: 44px; }
    .d { font-size: 12.5px; }
  }
</style>
