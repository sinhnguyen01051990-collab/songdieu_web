---
/**
 * Hero đỏ đô & vàng (giai đoạn 1, 13/11/2026) – khung 1440×920 đơn vị (u), carousel cong như mặt trong hình trụ,
 * nền đỏ đô có hạt sáng vàng lấp lánh (canvas), chữ vàng có ánh lướt.
 */
import { getImage } from 'astro:assets';
import { SITE } from '../data/site';
import img0 from '../assets/images/sp/gel-sdbody-2.jpg';
import img1 from '../assets/images/sp/xuan-nu-nhan-beauty-1.jpg';
import img2 from '../assets/images/sp/tra-tao-meo-2.jpg';
import img3 from '../assets/images/sp/but-gel-hcbpk-beauty-1.jpg';
import img4 from '../assets/images/sp/xuan-nu-nhan-1.jpg';
import img5 from '../assets/images/sp/gel-sdbody-beauty-2.jpg';
import img6 from '../assets/images/sp/tra-mam-xoi-2.jpg';
import img7 from '../assets/images/sp/gel-sdbody-3.jpg';
import img8 from '../assets/images/sp/tra-tao-meo-beauty-2.jpg';
import img9 from '../assets/images/sp/but-gel-hcbpk-1.jpg';

const GEL = '/san-pham/gel-gung-que-sdbody/';
const XNN = '/san-pham/vien-uong-noi-tiet-xuan-nu-nhan/';
const TTM = '/san-pham/tra-tao-meo/';
const BUT = '/san-pham/but-gel-hoang-cung-bao-phu-khang/';
const TMX = '/san-pham/tra-mam-xoi-tu-vi/';
const src = [
  { img: img0, href: GEL, alt: 'Gel gừng quế SDBODY', pos: '50% 35%' },
  { img: img1, href: XNN, alt: 'Nhà sáng lập cùng Xuân Nữ Nhan', pos: '50% 35%' },
  { img: img2, href: TTM, alt: 'Thất Bảo Trà – Trà Táo Mèo', pos: '50% 35%' },
  { img: img3, href: BUT, alt: 'Bút gel Hoàng Cung Bảo Phụ Khang', pos: '50% 35%' },
  { img: img4, href: XNN, alt: 'Viên uống Xuân Nữ Nhan', pos: '50% 35%' },
  { img: img5, href: GEL, alt: 'Gel SDBODY chăm sóc vòng eo', pos: '50% 35%' },
  { img: img6, href: TMX, alt: 'Trà Mâm Xôi Tứ Vị', pos: '50% 35%' },
  { img: img7, href: GEL, alt: 'Gel SDBODY giữa hoa hồng', pos: '50% 35%' },
  { img: img8, href: TTM, alt: 'Khách hàng cùng Trà Táo Mèo', pos: '50% 35%' },
  { img: img9, href: BUT, alt: 'Hộp Bút gel Hoàng Cung Bảo Phụ Khang', pos: '50% 35%' },
];
// 2 cỡ ảnh: 280px cho điện thoại, 520px cho máy tính (thẻ cao tối đa ~370u)
const cards = await Promise.all(
  src.map(async (c) => {
    const [s, l] = await Promise.all([280, 520].map((w) => getImage({ src: c.img, width: w, format: 'webp', quality: 70 })));
    return { ...c, url: l.src, srcset: `${s.src} 280w, ${l.src} 520w` };
  })
);
---
<section class="hero" aria-labelledby="hero-title">
  <canvas class="sparkle" id="hero-sparkle" aria-hidden="true"></canvas>
  <div class="frame" id="hero-frame">
    <p class="badge" data-enter="pop">Hơn 11 năm đồng hành cùng phái đẹp</p>

    <h1 id="hero-title" class="headline">
      <span class="line" data-enter="line">Vẻ Đẹp Đến Từ</span>
      <span class="line line2 gold-shine" data-enter="line">Sự An Nhiên</span>
    </h1>

    <p class="sub" data-enter="fade">
      Song Diệu mang đến giải pháp chăm sóc toàn diện, giúp phái đẹp nuôi dưỡng sự tự tin, khỏe khoắn và rạng rỡ bền vững từ sâu bên trong.
    </p>

    <!-- carousel cong -->
    <div class="track" id="hero-track" aria-label="Hình ảnh sản phẩm SONG DIỆU, kéo để xem thêm" role="region">
      {cards.map((c) => (
        <a class="rcard" href={c.href} draggable="false" aria-label={c.alt}>
          <img src={c.url} srcset={c.srcset} sizes="(max-width: 820px) 140px, 260px" alt={c.alt} draggable="false" decoding="async" style={`object-position:${c.pos}`} />
          <span class="chip" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="cta" data-enter="scale">
      <a href="/san-pham/" class="btn-gold cta-main">Chọn sản phẩm cho tôi</a>
      <a href={SITE.zalo} target="_blank" rel="noopener" class="cta-ghost">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5A8.5 8.5 0 1 1 21 12z" /></svg>
        Tư vấn qua Zalo
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    --hh: 72px; /* chiều cao header */
    --u: min(calc(100vw / 1440), calc((100svh - var(--hh)) / 920));
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 70% 55% at 50% 0%, rgba(155, 28, 44, .85), transparent 70%),
      radial-gradient(ellipse 60% 40% at 50% 100%, rgba(201, 161, 74, .16), transparent 70%),
      linear-gradient(180deg, #4a0c15 0%, #2b070d 100%);
    color: #fbf3e6;
  }
  .hero::after { /* viền vàng mảnh ở đáy */
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1px; z-index: 2;
    background: linear-gradient(90deg, transparent, rgba(224,191,110,.7), transparent);
  }
  .sparkle { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .frame {
    position: relative; z-index: 1;
    width: calc(1440 * var(--u));
    height: calc(920 * var(--u));
    margin: 0 auto;
    overflow: hidden;
  }
  .badge {
    position: absolute; left: 50%; top: calc(22 * var(--u)); translate: -50% 0;
    height: calc(36 * var(--u)); padding: 0 calc(20 * var(--u));
    display: inline-flex; align-items: center; white-space: nowrap;
    border-radius: 999px; color: var(--color-gold-300);
    background: rgba(224,191,110,.08); box-shadow: inset 0 0 0 1px rgba(224,191,110,.45);
    font: 600 calc(14 * var(--u)) / 1 'Inter Variable', Inter, sans-serif; letter-spacing: .16em; text-transform: uppercase;
  }
  .headline {
    position: absolute; left: 0; right: 0; top: calc(78 * var(--u)); margin: 0;
    text-align: center; color: #fbf3e6;
    font: 700 calc(100 * var(--u)) / calc(98 * var(--u)) 'Cormorant Garamond', 'Times New Roman', serif;
    letter-spacing: -0.005em;
  }
  .headline .line { display: block; }
  .headline .line2 { font-style: italic; padding-bottom: .06em; }
  .sub {
    position: absolute; left: 50%; translate: -50% 0; top: calc(300 * var(--u));
    width: calc(660 * var(--u)); margin: 0; text-align: center; color: rgba(251,243,230,.78);
    font: 400 calc(19.5 * var(--u)) / calc(31 * var(--u)) 'Inter Variable', Inter, sans-serif;
  }

  .track { position: absolute; inset: 0; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .track.dragging { cursor: grabbing; }
  .rcard { position: absolute; left: 0; top: 0; display: block; overflow: hidden; background: #3a0910; will-change: transform, clip-path; }
  .rcard img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; opacity: 0; transition: opacity .5s; }
  .rcard img.ready { opacity: 1; }
  .chip {
    position: absolute; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 999px;
    color: #fff; background: rgba(255,255,255,.22); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(240,220,168,.6);
  }

  .cta {
    position: absolute; left: 50%; top: calc(808 * var(--u)); translate: -50% 0;
    display: flex; gap: calc(14 * var(--u)); align-items: center; white-space: nowrap;
  }
  .cta-main { height: calc(56 * var(--u)); min-height: 44px; padding: 0 calc(30 * var(--u)); font-size: max(14px, calc(16 * var(--u))); }
  .cta-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    height: calc(56 * var(--u)); min-height: 44px; padding: 0 calc(26 * var(--u)); border-radius: 999px;
    color: #fbf3e6; font: 500 max(14px, calc(16 * var(--u))) / 1 'Inter Variable', Inter, sans-serif;
    box-shadow: inset 0 0 0 1px rgba(251,243,230,.45); transition: background .25s, box-shadow .25s;
  }
  .cta-ghost:hover { background: rgba(251,243,230,.08); box-shadow: inset 0 0 0 1px rgba(224,191,110,.9); }
  .cta a:focus-visible { outline: 2px solid var(--color-gold-300); outline-offset: 3px; }

  /* ---------- Điện thoại ---------- */
  @media (max-width: 820px) {
    .frame { width: 100%; height: auto; display: flex; flex-direction: column; align-items: center; padding: 30px 0 40px; overflow: visible; }
    .badge, .headline, .sub, .cta { position: static; translate: none; }
    .badge { height: 30px; padding: 0 14px; font-size: 11px; }
    .headline { margin-top: 18px; padding: 0 16px; font-size: clamp(42px, 12.5vw, 64px); line-height: 1.02; }
    .sub { width: auto; max-width: 520px; padding: 0 20px; margin-top: 16px; font-size: 15.5px; line-height: 1.6; }
    .track { position: relative; inset: auto; width: 100%; height: 250px; margin-top: 26px; }
    .cta { margin-top: 26px; flex-direction: column; gap: 12px; width: 100%; padding: 0 24px; }
    .cta-main, .cta-ghost { width: 100%; max-width: 340px; justify-content: center; height: 50px; font-size: 15px; }
  }
</style>

<script>
  const frame = document.getElementById('hero-frame')!;
  const track = document.getElementById('hero-track')!;
  const cards = [...track.querySelectorAll<HTMLAnchorElement>('.rcard')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileMQ = matchMedia('(max-width: 820px)');

  // ảnh mờ dần khi sẵn sàng
  cards.forEach((c) => {
    const img = c.querySelector('img')!;
    const done = () => img.classList.add('ready');
    img.complete ? done() : img.addEventListener('load', done, { once: true });
  });

  const N = cards.length, PITCH = 196, SPAN = N * PITCH, SPEED = 50;
  let offset = 0;          // vị trí cuộn (u)
  let vel = 0;             // vận tốc quán tính (u/s)
  let dragging = false, moved = 0, lastX = 0, lastT = 0, samples: { x: number; t: number }[] = [];

  // làm tròn góc tứ giác
  function roundedQuad(p: number[][], r: number) {
    let d = '';
    for (let i = 0; i < 4; i++) {
      const P = p[i], A = p[(i + 3) % 4], B = p[(i + 1) % 4];
      const ua = norm(A[0] - P[0], A[1] - P[1]), ub = norm(B[0] - P[0], B[1] - P[1]);
      const s = [P[0] + ua[0] * r, P[1] + ua[1] * r], e = [P[0] + ub[0] * r, P[1] + ub[1] * r];
      d += (i ? 'L' : 'M') + f(s[0]) + ' ' + f(s[1]) + 'Q' + f(P[0]) + ' ' + f(P[1]) + ' ' + f(e[0]) + ' ' + f(e[1]);
    }
    return d + 'Z';
  }
  const norm = (x: number, y: number) => { const l = Math.hypot(x, y) || 1; return [x / l, y / l]; };
  const f = (n: number) => n.toFixed(1);

  function layout() {
    const mobile = mobileMQ.matches;
    const W = track.clientWidth, H = track.clientHeight;
    // u: px mỗi đơn vị; xShift: dịch khung 1440 để tâm 720 nằm giữa vùng nhìn
    const u = mobile ? W / 640 : frame.clientWidth / 1440;
    const xShift = mobile ? W / 2 - 720 * u : 0;
    const yBase = mobile ? H / 2 / u + 0 : 587;

    for (let i = 0; i < N; i++) {
      let t = ((i * PITCH + offset) % SPAN + SPAN) % SPAN;
      t = t - SPAN / 2;                                   // −980 … 980
      const x = 720 + t * (1 + 0.083 * (t / 706) ** 2);   // đẩy ra ngoài
      const d = Math.abs(x - 720) / 706;
      const w = 170 + 48 * d * d;
      const xl = x - w / 2, xr = x + w / 2;
      const hL = 280 + 92 * (Math.abs(xl - 720) / 706) ** 2.6;
      const hR = 280 + 92 * (Math.abs(xr - 720) / 706) ** 2.6;
      const yc = yBase - 12 * d * d;
      const top = yc - Math.max(hL, hR) / 2, boxH = Math.max(hL, hR);
      const el = cards[i];
      const L = xl * u + xShift, Wpx = w * u, T = top * u, Hpx = boxH * u;
      if (L > W + 40 || L + Wpx < -40) { el.style.visibility = 'hidden'; continue; }
      el.style.visibility = 'visible';
      el.style.width = Wpx + 'px';
      el.style.height = Hpx + 'px';
      el.style.transform = `translate(${L}px, ${T}px)`;
      const yl0 = (yc - hL / 2 - top) * u, yl1 = (yc + hL / 2 - top) * u;
      const yr0 = (yc - hR / 2 - top) * u, yr1 = (yc + hR / 2 - top) * u;
      el.style.clipPath = `path('${roundedQuad([[0, yl0], [Wpx, yr0], [Wpx, yr1], [0, yl1]], 15 * u)}')`;
      const chip = el.querySelector<HTMLElement>('.chip')!;
      chip.style.left = 12 * u + 'px';
      chip.style.top = yl1 - 12 * u - 30 + 'px';
    }
  }

  // đồng hồ dài hạn bằng Web Animations → cuộn theo thời gian
  const clock = document.documentElement.animate(null, { duration: 1e9 });
  let prev = (clock.currentTime as number) ?? 0;
  // Chỉ chạy khi carousel đang hiện trên màn hình (tiết kiệm CPU/pin điện thoại)
  let visible = true, raf = 0;
  function tick() {
    raf = 0;
    const now = (clock.currentTime as number) ?? prev;
    const dt = Math.min(0.05, Math.max(0, (now - prev) / 1000));
    prev = now;
    if (!dragging) {
      offset += ((reduce ? 0 : -SPEED) + vel) * dt;
      vel *= Math.pow(0.05, dt);             // giảm ~95% mỗi giây
      if (Math.abs(vel) < 0.5) vel = 0;
    }
    layout();
    if (visible && !document.hidden) raf = requestAnimationFrame(tick);
  }
  const resume = () => { if (!raf && visible && !document.hidden) { prev = (clock.currentTime as number) ?? prev; raf = requestAnimationFrame(tick); } };
  new IntersectionObserver(([en]) => { visible = en.isIntersecting; resume(); }).observe(track);
  document.addEventListener('visibilitychange', resume);
  addEventListener('resize', () => { layout(); });
  layout();
  resume();

  // kéo thả
  const unit = () => (mobileMQ.matches ? track.clientWidth / 640 : frame.clientWidth / 1440);
  track.addEventListener('pointerdown', (e) => {
    dragging = true; moved = 0; vel = 0; lastX = e.clientX; lastT = performance.now();
    samples = [{ x: e.clientX, t: lastT }];
    track.setPointerCapture(e.pointerId);
    track.classList.add('dragging');
  });
  track.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - lastX;
    lastX = e.clientX; moved += Math.abs(dx);
    offset += dx / unit();
    const t = performance.now();
    samples.push({ x: e.clientX, t });
    while (samples.length > 2 && t - samples[0].t > 100) samples.shift();
  });
  const end = (e: PointerEvent) => {
    if (!dragging) return;
    dragging = false; track.classList.remove('dragging');
    const a = samples[0], b = samples[samples.length - 1];
    const dt = (b.t - a.t) / 1000;
    if (dt > 0) vel = (b.x - a.x) / dt / unit();
    try { track.releasePointerCapture(e.pointerId); } catch {}
  };
  track.addEventListener('pointerup', end);
  track.addEventListener('pointercancel', end);
  // chặn click khi vừa kéo
  track.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } }, true);

  // ---------- Hạt sáng vàng lấp lánh (bokeh) ----------
  const cv = document.getElementById('hero-sparkle') as HTMLCanvasElement;
  const ctx = cv.getContext('2d');
  if (ctx && !reduce) {
    type P = { x: number; y: number; r: number; vy: number; vx: number; ph: number; sp: number; big: boolean };
    let ps: P[] = [], W = 0, H = 0, sraf = 0, sVisible = true;
    const dpr = Math.min(2, devicePixelRatio || 1);
    const make = (y?: number): P => {
      const big = Math.random() < 0.18;
      return { x: Math.random() * W, y: y ?? Math.random() * H, r: big ? 6 + Math.random() * 14 : 0.6 + Math.random() * 1.8,
        vy: -(4 + Math.random() * 10), vx: (Math.random() - 0.5) * 4, ph: Math.random() * 6.28, sp: 0.6 + Math.random() * 1.6, big };
    };
    const size = () => {
      W = cv.clientWidth; H = cv.clientHeight; cv.width = W * dpr; cv.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(90, (W * H) / 16000));
      ps = Array.from({ length: n }, () => make());
    };
    let last = performance.now();
    const draw = (now: number) => {
      sraf = 0;
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of ps) {
        p.y += p.vy * dt; p.x += p.vx * dt; p.ph += p.sp * dt;
        if (p.y < -30) Object.assign(p, make(H + 20));
        const a = (p.big ? 0.10 : 0.55) * (0.5 + 0.5 * Math.sin(p.ph));
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * (p.big ? 1 : 3));
        g.addColorStop(0, `rgba(255,232,170,${a})`); g.addColorStop(1, 'rgba(255,232,170,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, p.r * (p.big ? 1 : 3), 0, 6.283); ctx.fill();
        if (!p.big && a > 0.45) { // tia lấp lánh
          ctx.strokeStyle = `rgba(255,244,210,${(a - 0.45) * 2})`; ctx.lineWidth = 0.6; ctx.beginPath();
          ctx.moveTo(p.x - p.r * 4, p.y); ctx.lineTo(p.x + p.r * 4, p.y); ctx.moveTo(p.x, p.y - p.r * 4); ctx.lineTo(p.x, p.y + p.r * 4); ctx.stroke();
        }
      }
      if (sVisible && !document.hidden) sraf = requestAnimationFrame(draw);
    };
    const sResume = () => { if (!sraf && sVisible && !document.hidden) { last = performance.now(); sraf = requestAnimationFrame(draw); } };
    size(); addEventListener('resize', size);
    new IntersectionObserver(([en]) => { sVisible = en.isIntersecting; sResume(); }).observe(cv);
    document.addEventListener('visibilitychange', sResume);
    sResume();
  }

  // ---------- Entrance ----------
  if (!reduce) {
    const ease = 'cubic-bezier(.2,.8,.2,1)';
    const opt = (delay: number, duration = 700) => ({ delay, duration, easing: ease, fill: 'backwards' as FillMode });
    frame.querySelector('[data-enter=pop]')?.animate([{ transform: 'scale(.6)', opacity: 0 }, { transform: 'scale(1.06)', opacity: 1, offset: .7 }, { transform: 'scale(1)' }], opt(150, 600));
    // Chữ chính (tiêu đề, mô tả) luôn hiện ngay để không làm chậm LCP – chỉ trượt nhẹ, không ẩn/mờ
    frame.querySelectorAll('[data-enter=line]').forEach((el, i) =>
      el.animate([{ transform: 'translateY(18px)' }, { transform: 'none' }], opt(i * 90, 700)));
    track.animate([{ transform: 'translateY(80px)', opacity: 0 }, { transform: 'none', opacity: 1 }], opt(800, 1100));
    frame.querySelector('[data-enter=scale]')?.animate([{ transform: 'translateY(16px)', opacity: 0 }, { transform: 'none', opacity: 1 }], opt(1000, 700));
  }
</script>
