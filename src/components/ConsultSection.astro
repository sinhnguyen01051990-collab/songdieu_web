---
/**
 * Khối "Để lại thông tin" trang chủ (16/11/2026): nền đỏ đô sâu có quầng vàng + bụi vàng lấp lánh,
 * tiêu đề có "gọi lại ngay" vệt vàng, 3 lợi ích biểu tượng vàng, nút Gọi (vàng) + Zalo;
 * thẻ form viền vàng, tia sáng chạy quanh viền một lần khi cuộn tới. Chỉ CSS.
 */
import LeadForm from './LeadForm.astro';
import { SITE } from '../data/site';
// dùng lại ở trang Sản phẩm (16/11/2026): đổi được chữ nhỏ, tiêu đề, phần chữ nghiêng và lời dẫn; mặc định giữ như trang chủ
interface Props { eyebrow?: string; titleA?: string; titleEm?: string; sub?: string }
const { eyebrow = 'Tư vấn miễn phí', titleA, titleEm = 'gọi lại ngay',
  sub = 'Nhận tư vấn liệu trình phù hợp và ưu đãi mới nhất – hoặc liên hệ trực tiếp với SONG DIỆU.' } = Astro.props;
const BENEFITS = [
  { t: 'Tư vấn 1–1 miễn phí', d: 'Lắng nghe đúng vấn đề chị đang gặp', i: '<path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path d="M8.5 11.5c.6 1.5 2 2.8 3.5 3.3"/>' },
  { t: 'Liệu trình phù hợp từng người', d: 'Theo thể trạng, độ tuổi và mục tiêu', i: '<path d="M12 3l2.4 5.6L20 9.3l-4.3 3.9 1.2 5.8L12 16.1 7.1 19l1.2-5.8L4 9.3l5.6-.7z"/>' },
  { t: 'Thông tin được bảo mật', d: 'Chỉ dùng để liên hệ tư vấn cho chị', i: '<path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/>' },
];
---
<section class="cs section" id="dang-ky-tu-van" aria-labelledby="cs-title">
  <span class="cs-glow" aria-hidden="true"></span>
  <span class="cs-dust" aria-hidden="true"></span>
  <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="cs-copy">
      <p class="eyebrow cs-eyebrow" data-reveal>{eyebrow}</p>
      <h2 id="cs-title" class="mt-3 text-4xl font-bold text-white sm:text-5xl" data-reveal>{titleA ? <>{titleA} </> : <>Để lại thông tin, <span class="whitespace-nowrap">SONG DIỆU</span> </>}<span class="cs-em italic">{titleEm}</span></h2>
      <p class="mt-5 text-[1.0625rem] leading-relaxed text-white/75" data-reveal>{sub}</p>
      <ul class="cs-list" data-reveal-group>
        {BENEFITS.map((b, i) => (
          <li style={`--i:${i}`}>
            <span class="cs-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={b.i} /></span>
            <span><b>{b.t}</b><span>{b.d}</span></span>
          </li>
        ))}
      </ul>
      <div class="cs-act" data-reveal>
        <a href={`tel:${SITE.phone}`} class="btn-gold !px-6 !py-3.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
          Gọi {SITE.phoneDisplay}
        </a>
        <a href={SITE.zalo} target="_blank" rel="noopener" class="btn cs-zalo !px-6 !py-3.5">
          Nhắn Zalo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>

    <div class="cs-card" data-reveal>
      <div class="cs-card-head">
        <p class="cs-card-t">Đăng ký tư vấn miễn phí</p>
        <p class="cs-card-d">Chị chỉ cần để lại tên và số điện thoại</p>
      </div>
      <LeadForm variant="contact" />
    </div>
  </div>
</section>

<style>
  /* tốc độ: trình duyệt chỉ dựng khối khi sắp cuộn tới; hiệu ứng lặp ở khối khuất tự dừng (16/11) */
  .cs { content-visibility: auto; contain-intrinsic-size: auto 760px; }
  .cs { position: relative; overflow: hidden; isolation: isolate; color: #fff;
    background:
      radial-gradient(ellipse 55% 60% at 100% 0%, rgba(155, 28, 44, .55), transparent 70%),
      linear-gradient(135deg, #4a0c15 0%, #63101c 45%, #2b070d 100%); }
  .cs::before { /* vạch vàng mảnh ở mép trên */
    content: ''; position: absolute; left: 0; right: 0; top: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(224, 191, 110, .7), transparent); }
  .cs-glow { position: absolute; left: -10%; top: 10%; width: 60%; height: 80%; z-index: -1; border-radius: 50%; filter: blur(60px); pointer-events: none;
    background: radial-gradient(circle, rgba(224, 191, 110, .22), transparent 70%); }
  .cs-dust { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 8% 20%, rgba(246,220,134,.75) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 22% 70%, rgba(246,220,134,.55) 0 1px, transparent 2px),
      radial-gradient(circle at 38% 12%, rgba(246,220,134,.6) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 46% 86%, rgba(246,220,134,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 58% 30%, rgba(246,220,134,.4) 0 1.1px, transparent 2.1px),
      radial-gradient(circle at 92% 82%, rgba(246,220,134,.55) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 96% 14%, rgba(246,220,134,.5) 0 1px, transparent 2px);
    animation: sd-cs-twinkle 4.5s ease-in-out infinite alternate; }
  @keyframes sd-cs-twinkle { from { opacity: .35; } to { opacity: 1; } }

  .cs-eyebrow { color: var(--color-gold-300); }
  .cs-eyebrow::before { display: none; }
  .cs-eyebrow::after { width: 44px; }
  .cs-em { background-image: linear-gradient(100deg, #f0dca8 0 40%, #fff3c4 46%, #ffffff 50%, #fff3c4 54%, #f0dca8 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .cs-em { animation: sd-cs-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-cs-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }

  .cs-list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 14px; }
  .cs-list li { display: flex; align-items: center; gap: 14px; }
  .cs-ico { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; color: var(--color-gold-300);
    background: radial-gradient(circle at 50% 30%, rgba(155, 28, 44, .9), rgba(43, 7, 13, .9) 75%);
    box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .6), 0 8px 18px -10px rgba(0, 0, 0, .6); }
  .cs-list b { display: block; font-weight: 600; color: #fff; }
  .cs-list li > span:last-child > span { display: block; font-size: 14px; color: rgba(255, 255, 255, .65); }

  .cs-act { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .cs-zalo { color: #fff; background: rgba(255, 255, 255, .06); box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .6); }
  .cs-zalo:hover { background: rgba(255, 255, 255, .12); box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .95), 0 0 0 4px rgba(224, 191, 110, .14); }

  /* thẻ form: viền vàng, tia sáng chạy một vòng khi cuộn tới */
  .cs-card { position: relative; padding: 28px; border-radius: 28px; color: var(--color-ink);
    background: linear-gradient(180deg, #fffdf8 0%, #fbf5ea 100%);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .75), 0 0 0 6px rgba(224, 191, 110, .12), 0 40px 70px -40px rgba(0, 0, 0, .7); }
  .cs-card::after { content: ''; position: absolute; inset: -1px; border-radius: 29px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .cs-card:global(.is-in)::after { animation: sd-cs-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-cs-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }
  .cs-card-head { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid rgba(201, 161, 74, .3); }
  .cs-card-t { font: 700 26px/1.2 var(--font-serif); color: var(--color-brand-700); }
  .cs-card-d { margin-top: 4px; font-size: 14px; color: var(--color-mute); }

  @media (max-width: 640px) {
    .cs-card { padding: 22px 18px; }
    .cs-act > a { flex: 1 1 auto; }
  }
</style>
