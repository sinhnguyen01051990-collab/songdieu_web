---
import { Image } from 'astro:assets';
import { TESTIMONIALS } from '../data/site';
import testi from '../assets/images/testi.jpeg';
---
<section class="section bg-white" aria-labelledby="testi-title">
  <div class="container-x grid items-center gap-12 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="eyebrow">Testimonials</p>
      <h2 id="testi-title" class="mt-3 text-3xl font-bold sm:text-4xl">Khách hàng nói về <span class="text-brand-600">SONG DIỆU</span></h2>
      <Image src={testi} alt="Khách hàng sử dụng sản phẩm SONG DIỆU" width={500} height={500} class="mt-8 rounded-3xl shadow-lg" loading="lazy" />
    </div>
    <div class="grid gap-5 lg:col-span-3">
      {TESTIMONIALS.map((t) => (
        <figure class="card p-6">
          <div class="text-gold-500" aria-label="5 sao">★★★★★</div>
          <blockquote class="mt-3 text-ink/80 leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="mt-4 flex items-center gap-3 text-sm">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-100 font-bold text-brand-700">{t.name.charAt(0)}</span>
            <span><span class="font-semibold">{t.name}</span><span class="block text-mute">{t.place} · {t.product}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
