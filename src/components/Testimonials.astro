---
/**
 * Cảm nhận khách hàng đồng bộ phong cách đã duyệt (16/11/2026):
 * chữ nhỏ chỉ gạch phải, "SONG DIỆU" có vệt vàng quét qua; ảnh khung vàng kép + quầng sáng + nhãn nổi;
 * thẻ cảm nhận cùng họ thẻ sản phẩm (nền trắng→kem, viền vàng, sao SVG ánh kim, dấu ngoặc vàng, ô tên đỏ đô);
 * hai thẻ giãn cân chiều cao ảnh + dòng mời tư vấn Zalo; nền trắng nối từ Xuân Nữ Nhan, chuyển kem ở đáy;
 * ảnh AVIF/WebP nhiều cỡ, điện thoại cắt 4:3. Chỉ CSS, không thêm mã chạy.
 */
import { Picture } from 'astro:assets';
import { SITE, TESTIMONIALS } from '../data/site';
import { PRODUCTS } from '../data/products';
import testi from '../assets/images/cam-nhan-khach.jpg';

const items = TESTIMONIALS.map((t) => ({
  ...t,
  href: (() => { const p = PRODUCTS.find((x) => x.name.normalize('NFC').toLowerCase() === t.product.normalize('NFC').toLowerCase()); return p ? `/san-pham/${p.slug}/` : null; })(),
}));
const STAR = 'M12 2.2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
---
<section class="testi section" aria-labelledby="testi-title">
  <span class="t-dust" aria-hidden="true"></span>
  <div class="container-x grid gap-12 lg:grid-cols-5 lg:gap-14">
    <div class="lg:col-span-2">
      <p class="eyebrow t-eyebrow" data-reveal>Cảm nhận khách hàng</p>
      <h2 id="testi-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Chị em nói gì về <span class="t-brand italic">SONG DIỆU</span></h2>
      <div class="t-photo" data-reveal>
        <span class="t-glow" aria-hidden="true"></span>
        <div class="t-frame">
          <Picture src={testi} alt="Khách hàng sử dụng sản phẩm SONG DIỆU" width={900} widths={[400, 600, 900]} sizes="(min-width: 1024px) 440px, 92vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" class="t-img" />
        </div>
        <span class="t-tag"><b>Cảm nhận thật</b>từ khách hàng thật</span>
      </div>
    </div>

    <div class="t-list lg:col-span-3">
      <div class="t-cards" data-reveal-group>
        {items.map((t) => (
          <div class="tc-cell"><figure class="tc">
            <span class="tc-q" aria-hidden="true">“</span>
            <div class="tc-stars" role="img" aria-label="Đánh giá 5 trên 5 sao">
              {[0, 1, 2, 3, 4].map(() => <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={STAR} /></svg>)}
            </div>
            <blockquote class="tc-text">“{t.quote}”</blockquote>
            <figcaption class="tc-by">
              <span class="tc-ava" aria-hidden="true">{t.name.trim().split(/\s+/).pop()!.charAt(0)}</span>
              <span class="tc-who"><span class="tc-name">{t.name}</span><span class="tc-place">{t.place}</span></span>
              {t.href ? <a href={t.href} class="tc-prod">{t.product}</a> : <span class="tc-prod">{t.product}</span>}
            </figcaption>
          </figure></div>
        ))}
      </div>
      <div class="t-cta" data-reveal>
        <p>Chị em cần tư vấn <strong>lộ trình riêng</strong>?</p>
        <a href={SITE.zalo} class="btn-primary !px-6 !py-3" target="_blank" rel="noopener">
          Tư vấn qua Zalo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* nền trắng nối đáy Xuân Nữ Nhan, chuyển dần sang kem ở đáy để liền khối Tin tức */
  .testi { position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(ellipse 45% 40% at 95% 10%, rgba(224, 191, 110, .14), transparent 70%),
      radial-gradient(ellipse 40% 45% at 0% 90%, rgba(155, 28, 44, .05), transparent 70%),
      linear-gradient(180deg, #fff 0%, #fff 60%, var(--color-cream) 100%); }
  .t-dust { position: absolute; right: 0; top: 0; width: 55%; height: 320px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 88% 14%, rgba(201,161,74,.5) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 70% 6%, rgba(201,161,74,.4) 0 1px, transparent 2px),
      radial-gradient(circle at 55% 26%, rgba(201,161,74,.35) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 94% 46%, rgba(201,161,74,.3) 0 1px, transparent 2px),
      radial-gradient(circle at 36% 10%, rgba(201,161,74,.3) 0 1.1px, transparent 2.1px);
    animation: sd-testi-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-testi-twinkle { from { opacity: .4; } to { opacity: 1; } }

  /* ---------- tiêu đề ---------- */
  .t-eyebrow::before { display: none; }
  .t-eyebrow::after { width: 44px; }
  .t-brand { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .t-brand { animation: sd-testi-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-testi-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }

  /* ---------- ảnh: khung vàng kép + quầng sáng + nhãn nổi ---------- */
  .t-photo { position: relative; margin-top: 32px; max-width: 30rem; }
  .t-glow { position: absolute; inset: 10% 6%; z-index: -1; border-radius: 50%; filter: blur(44px);
    background: radial-gradient(circle, rgba(224,191,110,.6), rgba(155,28,44,.25) 60%, transparent 75%); }
  .t-frame { position: relative; border-radius: 2rem; padding: 6px; overflow: hidden;
    background: linear-gradient(140deg, #f6dc86, #b8862a 35%, #f0dca8 55%, #a8761f 80%, #e8c46a);
    box-shadow: 0 28px 56px -30px rgba(58, 9, 16, .55); }
  .t-frame::before { content: ''; position: absolute; inset: 6px; border-radius: 1.65rem; z-index: 1; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 248, 225, .9), inset 0 0 0 4px rgba(184, 134, 42, .3); }
  .t-frame :global(.t-img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 40%; border-radius: 1.65rem; }
  .t-tag { position: absolute; right: -22px; bottom: 26px; z-index: 3; display: flex; flex-direction: column; gap: 2px;
    padding: 10px 16px; border-radius: 16px; font-size: 12px; line-height: 1.3; color: rgba(251, 243, 230, .82);
    background: linear-gradient(180deg, rgba(99, 16, 28, .92), rgba(58, 9, 16, .94));
    box-shadow: 0 14px 30px -14px rgba(58, 9, 16, .8), inset 0 0 0 1px rgba(224, 191, 110, .55);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    animation: sd-testi-float 6s ease-in-out infinite; }
  .t-tag b { font-family: var(--font-serif); font-size: 20px; line-height: 1.1; color: var(--color-gold-300); }
  @keyframes sd-testi-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  /* ---------- cột thẻ: giãn cân chiều cao cột trái ---------- */
  .t-list { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .t-cards { flex: 1; display: flex; flex-direction: column; gap: 20px; }
  .tc-cell { flex: 1; display: flex; } /* ô bọc nhận hiệu ứng hiện dần, thẻ giữ hiệu ứng rê chuột riêng */

  /* thẻ cảm nhận cùng họ thẻ sản phẩm */
  .tc { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: center; margin: 0;
    padding: 28px 30px 24px; border-radius: 24px; overflow: hidden;
    background: linear-gradient(180deg, #fff 0%, #fffdf8 55%, #fbf3e4 100%);
    box-shadow: 0 0 0 1px rgba(201, 161, 74, .38), 0 18px 40px -28px rgba(58, 9, 16, .45);
    transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
  @media (hover: hover) {
    .tc:hover { transform: translateY(-4px);
      box-shadow: 0 0 0 1px rgba(224, 191, 110, .95), 0 0 0 5px rgba(224, 191, 110, .14), 0 30px 50px -26px rgba(99, 16, 28, .5); }
  }
  /* tia sáng chạy một vòng quanh viền khi cuộn tới */
  .tc::after { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  :global(.is-in) > .tc::after { animation: sd-testi-ring 1.8s cubic-bezier(.45, 0, .2, 1) calc(.35s + var(--rd, 0s)) both; }
  @keyframes sd-testi-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }

  .tc-q { position: absolute; right: 22px; top: 2px; font: 700 110px/1 var(--font-serif); pointer-events: none; opacity: .35;
    background: linear-gradient(180deg, #f6dc86, #b8862a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tc-stars { display: flex; gap: 3px; }
  .tc-stars svg { fill: #f0c95a; stroke: #b8862a; stroke-width: 1; stroke-linejoin: round; filter: drop-shadow(0 1px 1.5px rgba(184, 134, 42, .35)); }
  .tc-text { position: relative; margin: 14px 0 0; font-size: 16.5px; line-height: 1.65; color: rgba(35, 24, 25, .82); }
  .tc-by { display: flex; align-items: center; gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(201, 161, 74, .28); }
  .tc-ava { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    font: 700 20px/1 var(--font-serif); color: var(--color-gold-300);
    background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%);
    box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .6), 0 6px 14px -8px rgba(58, 9, 16, .8); }
  .tc-who { flex: 1; min-width: 0; font-size: 14px; }
  .tc-name { display: block; font-weight: 600; color: var(--color-ink); }
  .tc-place { display: block; color: var(--color-mute); }
  .tc-prod { flex: none; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--color-brand-700);
    background: linear-gradient(180deg, #fdf8ec, #f4e8cc); box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .7);
    transition: color .3s, background .3s, box-shadow .3s; }
  a.tc-prod:hover { color: var(--color-gold-300); background: linear-gradient(180deg, #9b1c2c, #63101c); box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .6); }

  /* dòng mời tư vấn */
  .t-cta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding: 16px 18px 16px 24px; border-radius: 20px;
    background: linear-gradient(135deg, #fdf8ec, #f6ecd6);
    box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .55), 0 12px 26px -20px rgba(125, 92, 27, .45); }
  .t-cta p { font: italic 600 21px/1.3 var(--font-serif); color: var(--color-ink); }
  .t-cta strong { color: var(--color-brand-700); }

  /* ---------- màn nhỏ ---------- */
  @media (max-width: 1023px) {
    .t-photo { margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 640px) {
    .t-frame :global(.t-img) { aspect-ratio: 4 / 3; object-position: 50% 45%; }
    .t-tag { right: -6px; bottom: 16px; padding: 8px 12px; font-size: 11px; } .t-tag b { font-size: 17px; }
    .tc { padding: 24px 20px 20px; } .tc-q { font-size: 90px; right: 14px; }
    .tc-text { font-size: 15.5px; }
    .tc-by { flex-wrap: wrap; } .tc-prod { margin-left: 56px; }
    .t-cta { justify-content: center; text-align: center; padding: 18px; }
  }
</style>
