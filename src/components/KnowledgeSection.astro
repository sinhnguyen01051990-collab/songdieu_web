---
/**
 * Khối "Kiến thức & chia sẻ" trang chủ (16/11/2026), thay khối Tin tức:
 * chữ nhỏ gạch phải + "chia sẻ" có vệt vàng quét một lần; 3 thẻ bài có ảnh (PostCard) hiện lần lượt;
 * nút "Xem tất cả bài viết" giữa dưới lưới; điện thoại lướt ngang từng thẻ, thấy mép thẻ kế bên.
 */
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
const posts = (await getCollection('tinTuc')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
{posts.length > 0 && (
  <section class="kt section" aria-labelledby="kt-title">
    <span class="kt-dust" aria-hidden="true"></span>
    <div class="container-x">
      <div class="kt-head">
        <div>
          <p class="eyebrow kt-eyebrow" data-reveal>Góc chăm sóc</p>
          <h2 id="kt-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>Kiến thức &amp; <span class="kt-em italic">chia sẻ</span></h2>
        </div>
        <p class="kt-sub" data-reveal>Hướng dẫn chăm sóc vóc dáng, nội tiết tố nữ và cách dùng sản phẩm SONG DIỆU đúng chuẩn.</p>
      </div>
      <div class="kt-grid" data-reveal-group>
        {posts.map((post) => <div class="kt-cell"><PostCard post={post} /></div>)}
      </div>
      <div class="kt-more" data-reveal>
        <a href="/tin-tuc/" class="btn-primary !px-7 !py-3.5">
          Xem tất cả bài viết
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .kt { position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(ellipse 45% 40% at 4% 8%, rgba(224, 191, 110, .16), transparent 70%),
      radial-gradient(ellipse 40% 45% at 100% 100%, rgba(155, 28, 44, .05), transparent 70%),
      var(--color-cream); }
  .kt-dust { position: absolute; left: 0; top: 0; width: 55%; height: 300px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 10% 16%, rgba(201,161,74,.5) 0 1.3px, transparent 2.4px),
      radial-gradient(circle at 26% 6%, rgba(201,161,74,.4) 0 1px, transparent 2px),
      radial-gradient(circle at 42% 28%, rgba(201,161,74,.35) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 5% 50%, rgba(201,161,74,.3) 0 1px, transparent 2px),
      radial-gradient(circle at 62% 12%, rgba(201,161,74,.3) 0 1.1px, transparent 2.1px);
    animation: sd-kt-twinkle 5s ease-in-out infinite alternate; }
  @keyframes sd-kt-twinkle { from { opacity: .4; } to { opacity: 1; } }

  .kt-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 40px; flex-wrap: wrap; }
  .kt-eyebrow::before { display: none; }
  .kt-eyebrow::after { width: 44px; }
  .kt-em { background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  :global(.is-in) > .kt-em { animation: sd-kt-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-kt-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .kt-sub { max-width: 26rem; font-size: 15.5px; line-height: 1.6; color: var(--color-mute); }

  .kt-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 40px; }
  .kt-cell { min-width: 0; }
  .kt-more { display: flex; justify-content: center; margin-top: 40px; }

  /* máy tính bảng: 2 cột, ẩn thẻ thứ 3 để lưới không lẻ */
  @media (max-width: 1023px) and (min-width: 768px) {
    .kt-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kt-cell:nth-child(3) { display: none; }
  }
  /* điện thoại: lướt ngang từng thẻ, thấy mép thẻ kế bên */
  @media (max-width: 767px) {
    .kt-grid { display: flex; gap: 14px; margin: 28px -16px 0; padding: 6px 16px 18px; overflow-x: auto;
      scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .kt-grid::-webkit-scrollbar { display: none; }
    .kt-cell { flex: 0 0 82%; scroll-snap-align: start; }
    .kt-more { margin-top: 20px; }
  }
</style>
