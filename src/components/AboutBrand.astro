---
/**
 * Về chúng tôi (bản 2, 14/11/2026)
 * - Ảnh viền vàng kép, 3D nhiều lớp: ảnh · ngôi sao · huy hiệu "11+" nằm ở 3 độ sâu, rê chuột thấy lệch nhau.
 *   Cuộn tới: ảnh xoay vào như cánh cửa mở, vệt sáng lướt qua, huy hiệu lật một vòng như đồng xu.
 * - Giữ nguyên văn bản anh Nhân gửi; thêm 2 thẻ trụ cột "Chăm ngoài / Uống trong" dẫn tới sản phẩm.
 * - Trích dẫn: 2 vạch vàng trên/dưới tự kéo dài từ giữa ra, ngoặc kép lớn chìm phía sau.
 */
import { Image } from 'astro:assets';
import avatar from '../assets/images/chu-thuong-hieu.jpg';

const PILLARS = [
  {
    title: 'Chăm ngoài', sub: 'Thảo mộc dùng ngoài da',
    icon: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
    items: [
      { name: 'Gel Gừng Quế SDBODY', href: '/san-pham/gel-gung-que-sdbody/' },
      { name: 'Bút gel Hoàng Cung Bảo Phụ Khang', href: '/san-pham/but-gel-hoang-cung-bao-phu-khang/' },
    ],
  },
  {
    title: 'Uống trong', sub: 'Bồi bổ từ bên trong',
    icon: '<path d="M4 9h13v4a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6z"/><path d="M17 10.5h1.5a2.5 2.5 0 0 1 0 5H16.5"/><path d="M8.5 3.5v2.5M12.5 3.5v2.5"/>',
    items: [
      { name: 'Viên uống Xuân Nữ Nhan', href: '/san-pham/vien-uong-noi-tiet-xuan-nu-nhan/' },
      { name: 'Thất Bảo Trà – Trà Táo Mèo', href: '/san-pham/tra-tao-meo/' },
      { name: 'Trà Mâm Xôi Tứ Vị', href: '/san-pham/tra-mam-xoi-tu-vi/' },
    ],
  },
];
---
<section class="about section" id="ve-chung-toi" aria-labelledby="about-title">
  <span class="dust" aria-hidden="true"></span>
  <div class="container-x grid items-center gap-14 lg:grid-cols-[5fr_6fr] lg:gap-16">
    <!-- ẢNH 3D NHIỀU LỚP -->
    <div class="photo-wrap" data-reveal>
      <span class="glow" aria-hidden="true"></span>
      <div class="door">
        <div class="photo" id="about-photo">
          <div class="frame">
            <Image src={avatar} alt="Chủ thương hiệu SONG DIỆU tại văn phòng Song Diệu Pharma Beauty" width={640} height={640} class="img" loading="lazy" />
            <span class="sheen" aria-hidden="true"></span>
            <span class="glare" aria-hidden="true"></span>
          </div>
          <svg class="star" width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0l2.2 9.8L24 12l-9.8 2.2L12 24l-2.2-9.8L0 12l9.8-2.2z" fill="currentColor" /></svg>
          <div class="seal-pos">
            <div class="seal" role="img" aria-label="Hơn 11 năm đồng hành cùng phái đẹp">
              <svg viewBox="0 0 120 120" width="100%" height="100%" aria-hidden="true">
                <defs>
                  <linearGradient id="seal-gold" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#f6dc86" /><stop offset=".35" stop-color="#b8862a" />
                    <stop offset=".55" stop-color="#fff3c4" /><stop offset=".8" stop-color="#a8761f" /><stop offset="1" stop-color="#e8c46a" />
                  </linearGradient>
                  <radialGradient id="seal-red" cx=".5" cy=".35" r=".7">
                    <stop offset="0" stop-color="#9b1c2c" /><stop offset="1" stop-color="#3a0910" />
                  </radialGradient>
                  <path id="seal-ring" d="M9 60a51 51 0 1 1 102 0a51 51 0 1 1 -102 0" />
                </defs>
                <circle cx="60" cy="60" r="59" fill="url(#seal-gold)" />
                <circle cx="60" cy="60" r="44.5" fill="url(#seal-red)" stroke="#fff3c4" stroke-opacity=".7" stroke-width="1" />
                <circle cx="60" cy="60" r="56.5" fill="none" stroke="#7d5c1b" stroke-opacity=".45" stroke-width=".6" />
                <text font-family="Inter Variable, Inter, sans-serif" font-size="8.2" font-weight="700" fill="#4a0c15" letter-spacing="1.2">
                  <textPath href="#seal-ring" textLength="312" lengthAdjust="spacing">NĂM ĐỒNG HÀNH ✦ CÙNG PHÁI ĐẸP ✦</textPath>
                </text>
                <text x="60" y="68" text-anchor="middle" font-family="Inter Variable, Inter, sans-serif" font-size="30" font-weight="700" fill="#f0dca8" letter-spacing="-1">11+</text>
                <text x="60" y="84" text-anchor="middle" font-family="Inter Variable, Inter, sans-serif" font-size="7.5" font-weight="600" fill="#f0dca8" fill-opacity=".8" letter-spacing="2.2">NĂM</text>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CHỮ -->
    <div class="copy">
      <p class="eyebrow" data-reveal>Về chúng tôi</p>
      <h2 id="about-title" class="mt-3 text-4xl font-bold sm:text-5xl" data-reveal>SONG DIỆU <span class="pb italic">Pharma Beauty</span></h2>
      <p class="lead mt-6 text-lg leading-relaxed text-ink/80" data-reveal>
        Lấy tinh hoa từ <strong class="text-brand-700">dược liệu tự nhiên</strong> làm nền tảng, thương hiệu mang đến hệ sinh thái giải pháp <strong>an toàn, lành tính</strong> chăm sóc vóc dáng, nội tiết tố và sức khỏe phụ nữ toàn diện từ trong ra ngoài.
      </p>
      <p class="body mt-4 leading-relaxed text-mute" data-reveal>
        Với triết lý <strong class="text-brand-700">“chăm ngoài – uống trong”</strong>, Song Diệu đồng hành cùng phái đẹp Việt chủ động gìn giữ nét thanh xuân. Mỗi sản phẩm đều là sự kết tinh giữa thảo mộc truyền thống và quy trình sản xuất hiện đại, giúp phụ nữ luôn rạng rỡ, tự tin và tràn đầy sức sống ở mọi&nbsp;độ&nbsp;tuổi.
      </p>

      <!-- 2 trụ cột -->
      <div class="pillars" data-reveal-group>
        {PILLARS.map((p) => (
          <div class="pillar">
            <div class="p-head">
              <span class="p-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} /></span>
              <span><span class="p-t">{p.title}</span><span class="p-s">{p.sub}</span></span>
            </div>
            <ul class="p-list">
              {p.items.map((it) => <li><a href={it.href}>{it.name}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a></li>)}
            </ul>
          </div>
        ))}
      </div>

      <figure class="quote" data-reveal>
        <span class="qmark" aria-hidden="true">“</span>
        <blockquote>Giữ trọn chữ tín trên mọi hành trình</blockquote>
        <figcaption><span aria-hidden="true">✦</span> Cam kết của SONG DIỆU</figcaption>
      </figure>

      <div data-reveal>
        <a href="/gioi-thieu/" class="btn-primary about-btn mt-8 !px-7 !py-3.5">
          Câu chuyện thương hiệu
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about { position: relative; overflow: hidden; isolation: isolate;
    background:
      linear-gradient(180deg, var(--color-cream) 0, rgba(251, 247, 241, 0) 220px),
      radial-gradient(ellipse 50% 45% at 8% 12%, rgba(224, 191, 110, .22), transparent 70%),
      radial-gradient(ellipse 40% 50% at 100% 100%, rgba(155, 28, 44, .07), transparent 70%),
      var(--color-cream);
  }
  .dust { position: absolute; inset: 0 auto auto 0; width: 60%; height: 340px; z-index: -1; pointer-events: none;
    background:
      radial-gradient(circle at 12% 18%, rgba(201,161,74,.55) 0 1.4px, transparent 2.5px),
      radial-gradient(circle at 28% 8%, rgba(201,161,74,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 44% 30%, rgba(201,161,74,.4) 0 1.2px, transparent 2.2px),
      radial-gradient(circle at 6% 52%, rgba(201,161,74,.35) 0 1px, transparent 2px),
      radial-gradient(circle at 63% 14%, rgba(201,161,74,.4) 0 1.3px, transparent 2.3px),
      radial-gradient(circle at 80% 40%, rgba(201,161,74,.3) 0 1px, transparent 2px),
      radial-gradient(circle at 35% 62%, rgba(201,161,74,.25) 0 1px, transparent 2px);
    animation: sd-twinkle 5s ease-in-out infinite alternate;
  }
  @keyframes sd-twinkle { from { opacity: .45; } to { opacity: 1; } }

  /* ---------- ảnh 3D nhiều lớp ---------- */
  .photo-wrap { position: relative; margin: 0 auto; width: 100%; max-width: 30rem; perspective: 1100px; }
  .glow { position: absolute; inset: 8% 4%; z-index: -1; border-radius: 50%; filter: blur(48px);
    background: radial-gradient(circle, rgba(224,191,110,.75), rgba(155,28,44,.35) 60%, transparent 75%); }
  .door, .photo { transform-style: preserve-3d; }
  .photo { position: relative; transition: transform .5s cubic-bezier(.2,.8,.2,1); will-change: transform; }
  .frame { position: relative; border-radius: 2.25rem; padding: 7px; overflow: hidden;
    background: linear-gradient(140deg, #f6dc86, #b8862a 35%, #f0dca8 55%, #a8761f 80%, #e8c46a);
    box-shadow: 0 30px 60px -30px rgba(58, 9, 16, .6); }
  .frame::before { content: ''; position: absolute; inset: 7px; border-radius: 1.85rem; z-index: 1; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 248, 225, .9), inset 0 0 0 4px rgba(184, 134, 42, .35); }
  .frame :global(.img) { display: block; width: 100%; height: auto; border-radius: 1.85rem; }
  .glare { position: absolute; inset: 7px; border-radius: 1.85rem; z-index: 2; pointer-events: none; opacity: 0; mix-blend-mode: soft-light;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(255,250,230,.95), rgba(255,236,190,.3) 30%, transparent 60%);
    transition: opacity .4s; }
  .photo.tilt .glare { opacity: 1; }
  .sheen { position: absolute; inset: 0; z-index: 2; pointer-events: none; transform: translateX(-130%);
    background: linear-gradient(115deg, transparent 38%, rgba(255, 246, 215, .55) 50%, transparent 62%); mix-blend-mode: screen; }

  /* lớp nổi phía trước ảnh */
  .star { position: absolute; right: 18px; top: -14px; z-index: 3; color: #e8c46a; filter: drop-shadow(0 0 6px rgba(240,220,168,.9));
    transform: translateZ(40px); }
  .star path { transform-origin: 12px 12px; animation: sd-star 3.2s ease-in-out infinite; }
  @keyframes sd-star { 0%, 100% { transform: scale(.7) rotate(0); opacity: .6; } 50% { transform: scale(1) rotate(45deg); opacity: 1; } }
  .seal-pos { position: absolute; left: -30px; bottom: -30px; z-index: 4; width: 124px; height: 124px;
    transform: translateZ(70px); transform-style: preserve-3d; }
  .seal { width: 100%; height: 100%; border-radius: 50%;
    box-shadow: 0 18px 30px -12px rgba(58, 9, 16, .65), 0 0 0 4px rgba(251, 247, 241, .9), 0 0 24px rgba(240, 220, 168, .55); }

  /* hiệu ứng khi cuộn tới (lớp .is-in do script chung gắn) */
  :global(.is-in) > .door { animation: sd-door 1.2s cubic-bezier(.2,.8,.2,1) var(--rd, 0s) both; }
  :global(.is-in) .sheen { animation: sd-sheen 1.3s ease-in-out calc(var(--rd, 0s) + .5s) both; }
  :global(.is-in) .seal { animation: sd-coin 1.3s cubic-bezier(.3,.7,.2,1) calc(var(--rd, 0s) + .6s) both; }
  @keyframes sd-door { from { transform: rotateY(-16deg) rotateX(4deg); } to { transform: none; } }
  @keyframes sd-sheen { from { transform: translateX(-130%); } to { transform: translateX(130%); } }
  @keyframes sd-coin { from { transform: rotateY(-180deg) scale(.7); } 70% { transform: rotateY(20deg) scale(1.04); } to { transform: none; } }

  /* ---------- chữ ---------- */
  .pb {
    background-image: linear-gradient(100deg, #7d1424 0 40%, #c9a14a 46%, #f6dc86 50%, #c9a14a 54%, #7d1424 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em;
  }
  :global(.is-in) > .pb { animation: sd-pb-sweep 1.4s cubic-bezier(.4,0,.2,1) .35s both; }
  @keyframes sd-pb-sweep { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .lead, .body { max-width: 37rem; text-wrap: pretty; }

  /* 2 trụ cột */
  .pillars { margin-top: 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 37rem; }
  .pillar { padding: 16px 18px; border-radius: 18px; background: linear-gradient(180deg, #fffdf8, #fbf5ea);
    box-shadow: 0 14px 30px -22px rgba(58, 9, 16, .5), 0 0 0 1px rgba(224, 191, 110, .5);
    transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s; }
  .pillar:hover { transform: translateY(-3px); box-shadow: 0 20px 36px -22px rgba(58, 9, 16, .6), 0 0 0 1px rgba(224, 191, 110, .8); }
  .p-head { display: flex; align-items: center; gap: 12px; }
  .p-ico { position: relative; overflow: hidden; flex: none; width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center;
    color: var(--color-brand-600); background: linear-gradient(180deg, #fdf8ec, #f4e8cc);
    box-shadow: inset 0 0 0 1px rgba(201, 161, 74, .7); transition: color .35s; }
  .p-ico::before { content: ''; position: absolute; inset: 0; opacity: 0; transition: opacity .35s; background: radial-gradient(circle at 50% 30%, #9b1c2c, #4a0c15 75%); }
  .p-ico svg { position: relative; }
  .pillar:hover .p-ico { color: var(--color-gold-300); }
  .pillar:hover .p-ico::before { opacity: 1; }
  .p-t { display: block; font: italic 700 23px/1.1 var(--font-serif); color: var(--color-brand-700); }
  .p-s { display: block; margin-top: 2px; font-size: 12px; letter-spacing: .04em; color: var(--color-mute); }
  .p-list { list-style: none; margin: 12px 0 0; padding: 10px 0 0; border-top: 1px solid rgba(201, 161, 74, .3); display: grid; gap: 6px; }
  .p-list a { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; color: var(--color-ink); transition: color .25s; }
  .p-list a svg { flex: none; color: var(--color-gold-500); transition: transform .25s; }
  .p-list a:hover { color: var(--color-brand-600); }
  .p-list a:hover svg { transform: translateX(3px); }

  /* trích dẫn */
  .quote { position: relative; isolation: isolate; margin: 30px 0 0; padding: 22px 4px 18px; max-width: 37rem; }
  .quote::before, .quote::after { content: ''; position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-gold-500) 20%, var(--color-gold-500) 80%, transparent); }
  .quote::before { top: 0; } .quote::after { bottom: 0; }
  :global(.rv) .quote[data-reveal]:not(:global(.is-in))::before, :global(.rv) .quote[data-reveal]:not(:global(.is-in))::after { transform: scaleX(0); }
  .quote:global(.is-in)::before, .quote:global(.is-in)::after { animation: sd-line 1.1s cubic-bezier(.2,.8,.2,1) calc(var(--rd, 0s) + .2s) both; }
  @keyframes sd-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .qmark { position: absolute; left: -6px; top: -26px; z-index: -1; font: 700 150px/1 var(--font-serif); opacity: .22;
    background: linear-gradient(180deg, #f6dc86, #b8862a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .quote blockquote { margin: 0; padding-left: 28px; font: italic 700 clamp(25px, 2.6vw, 33px)/1.25 var(--font-serif); color: var(--color-brand-700); }
  .quote figcaption { margin-top: 10px; padding-left: 28px; font-size: 12.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-gold-600); }
  .quote figcaption span { color: var(--color-gold-500); margin-right: 4px; }

  .about-btn { box-shadow: 0 6px 18px -8px rgba(99,16,28,.6), inset 0 0 0 1px rgba(224,191,110,.6); }

  @media (max-width: 640px) {
    .seal-pos { width: 92px; height: 92px; left: -8px; bottom: -18px; }
    .pillar { padding: 14px; }
    .p-t { font-size: 20px; }
    .p-ico { width: 34px; height: 34px; }
    .p-list a { font-size: 13px; }
    .quote blockquote, .quote figcaption { padding-left: 18px; }
  }
  @media (max-width: 400px) { .pillars { grid-template-columns: 1fr; } }
</style>

<script>
  // nghiêng 3D theo chuột: ảnh, ngôi sao và huy hiệu ở 3 độ sâu khác nhau nên lệch nhau (chỉ máy tính có chuột)
  const photo = document.getElementById('about-photo');
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (photo && fine && !reduce) {
    photo.addEventListener('pointermove', (e) => {
      const r = photo.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
      photo.classList.add('tilt');
      photo.style.transform = `rotateX(${((0.5 - py) * 12).toFixed(2)}deg) rotateY(${((px - 0.5) * 14).toFixed(2)}deg)`;
      photo.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
      photo.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
    });
    photo.addEventListener('pointerleave', () => { photo.classList.remove('tilt'); photo.style.transform = ''; });
  }
</script>
