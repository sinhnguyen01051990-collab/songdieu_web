---
/** Đầu trang con – phong cách sang trọng đỏ đô & vàng (giai đoạn 1) */
interface Props { badge: string; title: string; titleLine2?: string; sub?: string; note?: string }
const { badge, title, titleLine2, sub, note } = Astro.props;
---
<section class="page-hero relative overflow-hidden">
  <div class="container-x relative py-14 text-center sm:py-20">
    <p class="eyebrow ph-enter">{badge}</p>
    <h1 class="ph-title ph-enter mx-auto mt-5 max-w-4xl text-ink">
      <span class="block">{title}</span>
      {titleLine2 && <span class="block" style="letter-spacing:-0.022em">{titleLine2}</span>}
    </h1>
    {sub && <p class="ph-enter mx-auto mt-5 max-w-2xl text-lg leading-8 text-mute">{sub}</p>}
    <slot />

    {note && (
      <>
        <p class="hand ph-note absolute right-[7%] top-[22%] hidden rotate-[14deg] text-2xl leading-tight md:block">{note}</p>
      </>
    )}
  </div>
</section>

<style>
  .ph-title { font: 700 clamp(40px, 6.4vw, 80px) / 1.05 'Cormorant Garamond', 'Times New Roman', serif; letter-spacing: -0.005em; }
</style>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ease = 'cubic-bezier(.2,.8,.2,1)';
    document.querySelectorAll('.page-hero .ph-enter').forEach((el, i) =>
      el.animate([{ transform: 'translateY(14px)' }, { transform: 'none' }],
        { delay: i * 80, duration: 700, easing: ease, fill: 'backwards' }));
    document.querySelectorAll<SVGPathElement>('.page-hero .ph-draw').forEach((p, i) => {
      const len = p.getTotalLength();
      p.style.strokeDasharray = String(len);
      p.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], { delay: 600 + i * 120, duration: 800, easing: 'ease-in-out', fill: 'both' });
    });
    document.querySelectorAll('.page-hero .ph-note').forEach((el) =>
      el.animate([{ opacity: 0 }, { opacity: 1 }], { delay: 900, duration: 700, fill: 'backwards' }));
  }
</script>
