---
/**
 * Khối Xuân Nữ Nhan trang chủ (15/11/2026, bản 3):
 * - ảnh nền hiện trọn, đứng yên, 4 mép mờ dần; ảnh xuất AVIF (trình duyệt cũ dùng WebP).
 * - máy tính: thẻ ngang 3 cột cân giữa (tiêu đề | mô tả + thành phần | giá + nút), chỉ vắt nhẹ lên mép dưới ảnh;
 *   điện thoại: thẻ dọc như cũ, nền đỏ đô đặc (không làm nhòe nền phía sau cho nhẹ máy).
 * - kéo khối sát lên khối sản phẩm; đáy chuyển kem → trắng nối liền khối Cảm nhận khách hàng.
 * - long lanh: sao vàng ánh kim có quầng sáng, vầng sáng vàng dưới chân bệ đá, ánh sáng lướt qua sản phẩm,
 *   bụi vàng vẽ bằng hình dựng sẵn (nhẹ hơn nhiều), điện thoại ít hạt hơn và 30 khung hình/giây.
 * Bật "giảm chuyển động" thì tắt hết hiệu ứng động.
 */
import { Picture } from 'astro:assets';
import nen from '../assets/images/xnn-nen-long-lanh.png';
import { getProduct, minPrice, formatVnd } from '../data/products';
import { SITE } from '../data/site';
const xnn = getProduct('vien-uong-noi-tiet-xuan-nu-nhan')!;
const price = minPrice(xnn);
const CHIPS = ['Thiên môn chùm', 'Sâm tố nữ', 'Đông trùng hạ thảo'];
// vị trí sao (theo % ảnh gốc), sát mép lọ và hộp
const STARS = [
  { x: 67.6, y: 30, s: 30, d: 0 },
  { x: 72.5, y: 22.5, s: 20, d: 1.6 },
  { x: 88.6, y: 21, s: 36, d: 0.8 },
  { x: 77.2, y: 46, s: 22, d: 2.3 },
  { x: 89.2, y: 58, s: 26, d: 1.2 },
  { x: 76.8, y: 84, s: 20, d: 2.8 },
];
---
<section class="xnn" id="xnn" aria-labelledby="xnn-title">
  <div class="media" id="xnn-media">
    <div class="stage">
      <Picture src={nen} formats={['avif', 'webp']} fallbackFormat="webp" alt="Viên uống nội tiết Xuân Nữ Nhan bên người phụ nữ rạng rỡ giữa hoa sen và lụa hồng" widths={[900, 1400, 1920, 2600]} sizes="(max-width: 767px) 1140px, 100vw" class="bg" loading="lazy" decoding="async" />
      <span class="pedestal" aria-hidden="true"></span>
      <span class="shine" aria-hidden="true"><i></i></span>
      {STARS.map((t) => (
        <span class="star" style={`left:${t.x}%;top:${t.y}%;--s:${t.s}px;animation-delay:${t.d}s`} aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 0l2.2 9.8L24 12l-9.8 2.2L12 24l-2.2-9.8L0 12l9.8-2.2z" /></svg>
        </span>
      ))}
    </div>
    <canvas class="dust" aria-hidden="true"></canvas>
  </div>

  <div class="card-wrap">
    <div class="card-x" data-reveal>
      <div class="c-head">
        <p class="eyebrow !text-gold-300">Nội tiết tố nữ</p>
        <h2 id="xnn-title" class="title">{xnn.shortName}</h2>
      </div>
      <div class="c-mid">
        <p class="desc">Xuân Nữ Nhan – người bạn đồng hành tin cậy của phụ nữ hiện đại trên hành trình tái tạo nội tiết tố tự nhiên, phục hồi sinh lý và duy trì vẻ đẹp rạng rỡ từ sâu bên trong.</p>
        <ul class="chips" aria-label="Thành phần chính">
          {CHIPS.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="c-act">
        {price && <p class="price">Từ <b>{formatVnd(price)}</b></p>}
        <a href={`/san-pham/${xnn.slug}/`} class="btn-gold xnn-btn">
          Tìm hiểu Xuân Nữ Nhan
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={SITE.zalo} target="_blank" rel="noopener" class="zalo-btn">Tư vấn qua Zalo</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* kéo sát lên khối sản phẩm; đáy chuyển kem → trắng để nối liền khối Cảm nhận khách hàng (nền trắng) */
  .xnn { position: relative; isolation: isolate; margin-top: -56px; padding-bottom: 64px;
    background: linear-gradient(180deg, var(--color-cream) 0, var(--color-cream) 55%, #fff 100%); }

  /* ---------- ảnh: giữ đúng tỉ lệ ảnh gốc, căn như object-position 78%; 4 mép mờ dần ---------- */
  .media { position: relative; overflow: hidden; aspect-ratio: 3872 / 1088; min-height: 380px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 5%, #000 76%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 5%, #000 76%, transparent 100%);
    mask-composite: intersect; }
  .stage { position: absolute; top: 0; height: 100%; min-width: 100%; aspect-ratio: 3872 / 1088; left: 78%; transform: translateX(-78%); }
  .stage :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dust { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); pointer-events: none;
    translate: var(--px, 0px) var(--py, 0px); transition: translate .6s cubic-bezier(.2, .8, .2, 1); }

  /* vầng sáng vàng dưới chân bệ đá, thở nhẹ */
  .pedestal { position: absolute; left: 58%; top: 76%; width: 38%; height: 26%; z-index: 1; pointer-events: none; mix-blend-mode: screen;
    background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(255, 214, 140, .55), rgba(240, 190, 110, .18) 55%, transparent 75%);
    animation: sd-xnn-glow 4.5s ease-in-out infinite alternate; }
  @keyframes sd-xnn-glow { from { opacity: .55; } to { opacity: 1; } }

  /* sao vàng ánh kim có quầng sáng; chỉ động transform/opacity để trình duyệt không phải vẽ lại bộ lọc */
  .star { position: absolute; z-index: 2; width: var(--s); height: var(--s); margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    opacity: 0; transform: scale(.15); will-change: transform, opacity; animation: sd-xnn-star 3s ease-in-out infinite; }
  .star::before { content: ''; position: absolute; inset: -70%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 236, 170, .85), rgba(224, 175, 70, .35) 35%, transparent 65%); }
  .star svg { position: relative; display: block; width: 100%; height: 100%; }
  .star svg path { fill: #ffe9a8; stroke: #c9962f; stroke-width: .6; }
  @keyframes sd-xnn-star {
    0%, 100% { transform: scale(.15) rotate(0); opacity: 0; }
    40% { transform: scale(1) rotate(40deg); opacity: 1; }
    65% { transform: scale(.55) rotate(70deg); opacity: .55; }
  }

  /* ánh sáng lướt chéo qua lọ và hộp */
  .shine { position: absolute; left: 66%; top: 14%; width: 25%; height: 78%; overflow: hidden; z-index: 1; pointer-events: none; mix-blend-mode: screen; }
  .shine i { position: absolute; inset: -10% -60%; transform: translateX(-100%); will-change: transform;
    background: linear-gradient(110deg, transparent 38%, rgba(255, 228, 180, .55) 46%, rgba(255, 255, 255, .95) 50%, rgba(255, 228, 180, .55) 54%, transparent 62%);
    animation: sd-xnn-shine 5s ease-in-out infinite 1.2s; }
  @keyframes sd-xnn-shine { 0%, 55% { transform: translateX(-100%); } 82%, 100% { transform: translateX(100%); } }

  /* ---------- thẻ nội dung ---------- */
  .card-wrap { position: relative; z-index: 3; margin-top: -48px;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .card-x { position: relative; max-width: 700px; margin: 0 auto; text-align: center; color: #fff;
    padding: 24px 20px 26px; border-radius: 24px;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(224, 191, 110, .2), transparent 70%),
      linear-gradient(180deg, #651120, #3a0910);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .75), 0 0 0 6px rgba(251, 247, 241, .55), 0 0 0 7px rgba(224, 191, 110, .45),
      0 30px 56px -30px rgba(58, 9, 16, .7); }
  .card-x::before { /* vạch kem mảnh bên trong: viền thứ hai */
    content: ''; position: absolute; inset: 8px; border-radius: 17px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .32); }
  .card-x::after { /* tia sáng chạy một vòng quanh viền khi cuộn tới */
    content: ''; position: absolute; inset: -1px; border-radius: 25px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .card-x:global(.is-in)::after { animation: sd-xnn-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }

  .title { margin-top: 6px; font-family: var(--font-serif); font-weight: 700; font-size: clamp(32px, 3.2vw, 42px); line-height: 1.1;
    background-image: linear-gradient(100deg, #fbf3e6 0 40%, #e0bf6e 46%, #fff3c4 50%, #e0bf6e 54%, #fbf3e6 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  .card-x:global(.is-in) .title { animation: sd-xnn-title 1.4s cubic-bezier(.4, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-title { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .desc { max-width: 580px; margin: 10px auto 0; font-size: 15px; line-height: 1.6; color: rgba(251, 243, 230, .84); text-wrap: pretty; }

  .chips { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .chips li { padding: 4px 12px; border-radius: 999px; font-size: 12.5px; color: var(--color-gold-300);
    background: rgba(224, 191, 110, .1); box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .45); }
  .chips li::before { content: '✦'; margin-right: 6px; font-size: 10px; opacity: .85; }

  .c-act { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 14px; }
  .price { width: 100%; font-size: 13px; color: rgba(251, 243, 230, .7); }
  .price b { margin-left: 2px; font-size: 20px; color: var(--color-gold-300); }
  .xnn-btn { gap: 10px; } /* rê chuột: dùng hiệu ứng chung của btn-gold */
  .zalo-btn { display: inline-flex; align-items: center; justify-content: center; padding: 11px 22px; border-radius: 999px; font-weight: 600; font-size: 15px;
    color: var(--color-gold-300); box-shadow: inset 0 0 0 1.5px rgba(224, 191, 110, .7);
    transition: transform .35s cubic-bezier(.2, .8, .2, 1), background .35s, color .35s, box-shadow .35s; }
  .zalo-btn:hover { transform: translateY(-2px); background: rgba(224, 191, 110, .14); color: #fff3c4;
    box-shadow: inset 0 0 0 1.5px rgba(224, 191, 110, .95), 0 0 0 4px rgba(224, 191, 110, .14); }
  .zalo-btn:active { transform: translateY(0) scale(.98); transition-duration: .1s; }

  /* máy tính: thẻ ngang 3 cột, trong mờ */
  @media (min-width: 1024px) {
    .card-wrap { margin-top: -64px; }
    .card-x { max-width: 1120px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center;
      text-align: left; padding: 26px 34px; border-radius: 26px;
      background:
        radial-gradient(ellipse 60% 90% at 50% 0%, rgba(224, 191, 110, .18), transparent 70%),
        linear-gradient(180deg, rgba(106, 18, 32, .88), rgba(58, 9, 16, .94));
      backdrop-filter: blur(12px) saturate(1.2); -webkit-backdrop-filter: blur(12px) saturate(1.2); }
    .card-x::before { border-radius: 19px; }
    .card-x::after { border-radius: 27px; }
    .c-head { padding-right: 30px; }
    .c-head .eyebrow::before { display: none; }
    .title { white-space: nowrap; }
    .c-mid { padding: 0 30px; border-left: 1px solid rgba(224, 191, 110, .3); border-right: 1px solid rgba(224, 191, 110, .3); }
    .desc { margin: 0; max-width: none; }
    .chips { justify-content: flex-start; }
    .c-act { margin: 0; padding-left: 30px; flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 10px; text-align: center; }
    .price { width: auto; }
    .xnn-btn, .zalo-btn { white-space: nowrap; padding-top: 11px; padding-bottom: 11px; }
  }

  @media (max-width: 767px) {
    .xnn { margin-top: -36px; }
    .media { aspect-ratio: auto; min-height: 0; height: 320px; }
    .card-wrap { margin-top: -44px; }
    .star { --s: 18px !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .star { display: none; }
    .shine i, .pedestal { animation: none; }
    .dust { transition: none; translate: none; }
  }
</style>

<script>
  // bụi vàng lấp lánh + đốm sáng nhòe, vẽ bằng hình dựng sẵn (không tạo màu mới mỗi khung hình);
  // điện thoại: ít hạt hơn, 30 khung/giây; dừng khi khối ra khỏi màn hình (tab ẩn thì trình duyệt tự dừng)
  const media = document.getElementById('xnn-media');
  const cv = media?.querySelector<HTMLCanvasElement>('canvas.dust');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && cv && !reduce) {
    const ctx = cv.getContext('2d')!;
    const mobile = matchMedia('(max-width: 767px), (pointer: coarse)').matches;
    const frameMs = mobile ? 1000 / 30 : 0;
    const sprite = (stops: [number, string][]) => {
      const c = document.createElement('canvas'); c.width = c.height = 64;
      const g = c.getContext('2d')!, gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      for (const [o, col] of stops) gr.addColorStop(o, col);
      g.fillStyle = gr; g.fillRect(0, 0, 64, 64); return c;
    };
    const DOT = sprite([[0, 'rgba(255,250,228,1)'], [0.3, 'rgba(245,214,135,.65)'], [1, 'rgba(224,191,110,0)']]);
    const BOKEH = sprite([[0, 'rgba(255,240,200,1)'], [1, 'rgba(255,220,160,0)']]);
    let w = 0, h = 0, raf = 0, on = false, last = 0;
    type P = { x: number; y: number; r: number; vy: number; vx: number; t: number; sp: number; big: boolean };
    let ps: P[] = [];
    const prodX = () => { // vùng sản phẩm (ảnh căn 78%)
      const sw = Math.max(w, h * (3872 / 1088)), off = 0.78 * (w - sw);
      return [off + sw * 0.64, off + sw * 0.93];
    };
    const spawn = (anyY: boolean, big = false): P => {
      const [a, b] = prodX();
      const x = big || Math.random() < 0.65 ? a + Math.random() * (b - a) : Math.random() * w;
      return { x, y: anyY ? Math.random() * h : h + 20, big,
        r: big ? 8 + Math.random() * 14 : (0.9 + Math.random() * 2.3) * 4,
        vy: big ? 0.08 + Math.random() * 0.15 : 0.2 + Math.random() * 0.5, vx: (Math.random() - 0.5) * 0.25,
        t: Math.random() * 6.28, sp: big ? 0.008 + Math.random() * 0.012 : 0.025 + Math.random() * 0.045 };
    };
    const size = () => {
      const r = cv.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, mobile ? 1.5 : 2); w = r.width; h = r.height;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = mobile ? Math.round(Math.min(60, w / 7)) : Math.round(Math.min(150, Math.max(60, w / 11)));
      ps = Array.from({ length: n }, () => spawn(true));
      for (let i = 0; i < (mobile ? 4 : 7); i++) ps.push(spawn(true, true));
    };
    const draw = (now: number) => {
      raf = requestAnimationFrame(draw);
      if (frameMs && now - last < frameMs) return;
      const k = last ? Math.min(3, (now - last) / 16.7) : 1; last = now;
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of ps) {
        p.y -= p.vy * k; p.x += p.vx * k; p.t += p.sp * k;
        if (p.y < -30) Object.assign(p, spawn(false, p.big));
        const tw = Math.abs(Math.sin(p.t));
        ctx.globalAlpha = p.big ? 0.1 + 0.18 * tw : 0.3 + 0.7 * tw;
        ctx.drawImage(p.big ? BOKEH : DOT, p.x - p.r, p.y - p.r, p.r * 2, p.r * 2);
      }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
    };
    size();
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(size, 150); }, { passive: true });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; last = 0; raf = requestAnimationFrame(draw); }
      else if (!e.isIntersecting && on) { on = false; cancelAnimationFrame(raf); }
    }, { rootMargin: '100px' }).observe(media);

    // chỉ lớp bụi vàng trôi theo chuột (ảnh đứng yên)
    if (!mobile && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      media.addEventListener('pointermove', (e) => {
        const r = media.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5, dy = (e.clientY - r.top) / r.height - 0.5;
        media.style.setProperty('--px', `${(-dx * 26).toFixed(1)}px`);
        media.style.setProperty('--py', `${(-dy * 16).toFixed(1)}px`);
      });
      media.addEventListener('pointerleave', () => { media.style.setProperty('--px', '0px'); media.style.setProperty('--py', '0px'); });
    }
  }
</script>
