---
/**
 * Khối Xuân Nữ Nhan trang chủ (15/11/2026):
 * ảnh nền mới hiện trọn, không phủ màu; thẻ nội dung đỏ đô viền vàng kép vắt lên mép dưới ảnh.
 * Hiệu ứng: bụi vàng lấp lánh bay lên (canvas), sao 4 cánh nhấp nháy quanh sản phẩm,
 * ánh sáng lướt chéo qua sản phẩm, ảnh/bụi trôi nhẹ theo chuột, tiêu đề có vệt vàng quét,
 * viền thẻ có tia sáng chạy một vòng khi cuộn tới, nút vàng sáng hơn khi rê chuột.
 * Bật "giảm chuyển động" thì tắt hết hiệu ứng động.
 */
import { Image } from 'astro:assets';
import nen from '../assets/images/xnn-nen-long-lanh.png';
import { getProduct } from '../data/products';
const xnn = getProduct('vien-uong-noi-tiet-xuan-nu-nhan')!;
// vị trí sao (theo % ảnh gốc) quanh lọ và hộp
const STARS = [
  { x: 66.5, y: 30, s: 22, d: 0 },
  { x: 90.5, y: 17, s: 26, d: 1.1 },
  { x: 75, y: 26, s: 14, d: 2.2 },
  { x: 63.5, y: 70, s: 16, d: 0.6 },
  { x: 92, y: 62, s: 18, d: 1.7 },
  { x: 84, y: 94, s: 13, d: 2.8 },
];
---
<section class="xnn" id="xnn" aria-labelledby="xnn-title">
  <div class="media" id="xnn-media">
    <div class="stage">
      <Image src={nen} alt="Viên uống nội tiết Xuân Nữ Nhan bên người phụ nữ rạng rỡ giữa hoa sen và lụa hồng" widths={[900, 1400, 1920, 2600]} sizes="(max-width: 767px) 1210px, 100vw" class="bg" loading="lazy" />
      <span class="shine" aria-hidden="true"><i></i></span>
      {STARS.map((t) => (
        <svg class="star" style={`left:${t.x}%;top:${t.y}%;width:${t.s}px;height:${t.s}px;animation-delay:${t.d}s`} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0l2.2 9.8L24 12l-9.8 2.2L12 24l-2.2-9.8L0 12l9.8-2.2z" fill="currentColor" /></svg>
      ))}
    </div>
    <canvas class="dust" aria-hidden="true"></canvas>
  </div>

  <div class="card-wrap">
    <div class="card-x" data-reveal>
      <p class="eyebrow !text-gold-300">Nội tiết tố nữ</p>
      <h2 id="xnn-title" class="title">{xnn.shortName}</h2>
      <p class="desc">Xuân Nữ Nhan – người bạn đồng hành tin cậy của phụ nữ hiện đại trên hành trình tái tạo nội tiết tố tự nhiên, phục hồi sinh lý và duy trì vẻ đẹp rạng rỡ từ sâu bên trong.</p>
      <a href={`/san-pham/${xnn.slug}/`} class="btn-gold xnn-btn">
        Tìm hiểu Xuân Nữ Nhan
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .xnn { position: relative; isolation: isolate; padding-bottom: 72px;
    background: linear-gradient(180deg, #fbefe9 0, var(--color-cream) 70%); }

  /* ---------- ảnh: luôn giữ đúng tỉ lệ ảnh gốc, căn như object-position 78% để không mất sản phẩm ---------- */
  .media { position: relative; overflow: hidden; aspect-ratio: 3872 / 1088; min-height: 380px; }
  .stage { position: absolute; top: 0; height: 100%; min-width: 100%; aspect-ratio: 3872 / 1088;
    left: 78%; transform: translateX(-78%);
    translate: var(--px, 0) var(--py, 0); scale: 1.03; transition: translate .6s cubic-bezier(.2, .8, .2, 1); }
  .stage :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .media::after { /* viền mờ dần xuống nền kem ở đáy ảnh */
    content: ''; position: absolute; inset: auto 0 0; height: 70px; pointer-events: none;
    background: linear-gradient(180deg, transparent, rgba(251, 239, 233, .55)); }
  .dust { position: absolute; inset: -20px; width: calc(100% + 40px); height: calc(100% + 40px); pointer-events: none;
    translate: calc(var(--px, 0px) * 2.2) calc(var(--py, 0px) * 2.2); transition: translate .6s cubic-bezier(.2, .8, .2, 1); }

  /* sao 4 cánh nhấp nháy */
  .star { position: absolute; z-index: 2; color: #fff3c4; transform: translate(-50%, -50%) scale(.2); opacity: 0;
    filter: drop-shadow(0 0 6px rgba(255, 236, 170, .95)) drop-shadow(0 0 14px rgba(224, 191, 110, .7));
    animation: sd-xnn-star 3.4s ease-in-out infinite; }
  @keyframes sd-xnn-star {
    0%, 100% { transform: translate(-50%, -50%) scale(.2) rotate(0); opacity: 0; }
    45% { transform: translate(-50%, -50%) scale(1) rotate(45deg); opacity: 1; }
    70% { transform: translate(-50%, -50%) scale(.5) rotate(70deg); opacity: .4; }
  }

  /* ánh sáng lướt chéo qua lọ và hộp */
  .shine { position: absolute; left: 66%; top: 18%; width: 25%; height: 74%; overflow: hidden; z-index: 1; pointer-events: none; mix-blend-mode: screen; }
  .shine i { position: absolute; inset: -10% -60%; transform: translateX(-100%);
    background: linear-gradient(110deg, transparent 40%, rgba(255, 236, 200, .55) 48%, rgba(255, 255, 255, .8) 50%, rgba(255, 236, 200, .55) 52%, transparent 60%);
    animation: sd-xnn-shine 6.5s ease-in-out infinite 1.5s; }
  @keyframes sd-xnn-shine { 0%, 60% { transform: translateX(-100%); } 85%, 100% { transform: translateX(100%); } }

  /* ---------- thẻ nội dung ---------- */
  .card-wrap { position: relative; z-index: 3; margin-top: -44px;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .card-x { position: relative; max-width: 760px; margin: 0 auto; text-align: center; color: #fff;
    padding: 34px 40px 36px; border-radius: 28px;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(224, 191, 110, .2), transparent 70%),
      linear-gradient(180deg, #6a1220, #3a0910);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .75), 0 0 0 6px rgba(251, 239, 233, .9), 0 0 0 7px rgba(224, 191, 110, .45),
      0 34px 60px -30px rgba(58, 9, 16, .7); }
  .card-x::before { /* vạch kem mảnh bên trong: viền thứ hai */
    content: ''; position: absolute; inset: 8px; border-radius: 21px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .35); }
  .card-x::after { /* tia sáng chạy một vòng quanh viền khi cuộn tới */
    content: ''; position: absolute; inset: -1px; border-radius: 29px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .card-x:global(.is-in)::after { animation: sd-xnn-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }

  .title { margin-top: 10px; font-family: var(--font-serif); font-weight: 700; font-size: clamp(36px, 4.4vw, 52px); line-height: 1.1;
    background-image: linear-gradient(100deg, #fbf3e6 0 40%, #e0bf6e 46%, #fff3c4 50%, #e0bf6e 54%, #fbf3e6 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  .card-x:global(.is-in) .title { animation: sd-xnn-title 1.4s cubic-bezier(.4, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-title { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .desc { max-width: 600px; margin: 14px auto 0; font-size: 17px; line-height: 1.65; color: rgba(251, 243, 230, .82); text-wrap: pretty; }

  .xnn-btn { margin-top: 26px; gap: 10px; transition: transform .35s cubic-bezier(.2, .8, .2, 1), box-shadow .35s, filter .35s; }
  .xnn-btn:hover { transform: translateY(-2px); filter: brightness(1.08);
    box-shadow: 0 12px 30px -10px rgba(240, 210, 120, .95), 0 0 0 4px rgba(224, 191, 110, .2), inset 0 1px 0 rgba(255, 255, 255, .6); }
  .xnn-btn svg { transition: transform .35s; }
  .xnn-btn:hover svg { transform: translateX(3px); }

  @media (max-width: 767px) {
    .media { aspect-ratio: auto; min-height: 0; height: 340px; }
    .card-wrap { margin-top: -32px; }
    .card-x { padding: 28px 22px 30px; border-radius: 24px; }
    .card-x::before { border-radius: 17px; }
    .desc { font-size: 15.5px; }
    .star { scale: .8; }
  }
  @media (prefers-reduced-motion: reduce) {
    .star, .shine i { animation: none; }
    .star { display: none; }
    .stage, .dust { transition: none; translate: none; }
  }
</style>

<script>
  // bụi vàng lấp lánh bay lên, dày hơn quanh sản phẩm; trôi theo chuột; dừng khi khối ra khỏi màn hình
  const media = document.getElementById('xnn-media');
  const cv = media?.querySelector<HTMLCanvasElement>('canvas.dust');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && cv && !reduce) {
    const ctx = cv.getContext('2d')!;
    let w = 0, h = 0, dpr = 1, raf = 0, on = false;
    type P = { x: number; y: number; r: number; vy: number; vx: number; t: number; sp: number };
    let ps: P[] = [];
    const spawn = (anyY: boolean): P => {
      // 60% hạt ở vùng sản phẩm (bên phải), còn lại rải khắp ảnh
      const nearProduct = Math.random() < 0.6;
      const x = nearProduct ? w * (0.58 + Math.random() * 0.4) : Math.random() * w;
      return { x, y: anyY ? Math.random() * h : h + 10, r: 0.6 + Math.random() * 1.8,
        vy: 0.15 + Math.random() * 0.45, vx: (Math.random() - 0.5) * 0.25, t: Math.random() * 6.28, sp: 0.02 + Math.random() * 0.04 };
    };
    const size = () => {
      const r = cv.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2); w = r.width; h = r.height;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(90, Math.max(36, w / 18)));
      ps = Array.from({ length: n }, () => spawn(true));
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const p of ps) {
        p.y -= p.vy; p.x += p.vx; p.t += p.sp;
        if (p.y < -10) Object.assign(p, spawn(false));
        const a = 0.35 + 0.65 * Math.abs(Math.sin(p.t));
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
        g.addColorStop(0, `rgba(255,246,214,${a})`); g.addColorStop(0.35, `rgba(240,210,130,${a * 0.6})`); g.addColorStop(1, 'rgba(224,191,110,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 4, 0, 6.283); ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    };
    size();
    addEventListener('resize', () => { size(); }, { passive: true });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; raf = requestAnimationFrame(draw); }
      else if (!e.isIntersecting && on) { on = false; cancelAnimationFrame(raf); }
    }).observe(media);

    // ảnh và bụi trôi nhẹ theo chuột (chỉ máy tính có chuột)
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      media.addEventListener('pointermove', (e) => {
        const r = media.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5, dy = (e.clientY - r.top) / r.height - 0.5;
        media.style.setProperty('--px', `${(-dx * 14).toFixed(1)}px`);
        media.style.setProperty('--py', `${(-dy * 8).toFixed(1)}px`);
      });
      media.addEventListener('pointerleave', () => { media.style.setProperty('--px', '0px'); media.style.setProperty('--py', '0px'); });
    }
  }
</script>
