---
/**
 * Khối Xuân Nữ Nhan trang chủ (15/11/2026, bản 2):
 * ảnh nền hiện trọn, đứng yên (bỏ trôi theo chuột vì ảnh rộng bị vẽ lệch thành vệt ngang), 4 mép mờ dần vào nền kem;
 * thẻ đỏ đô trong mờ viền vàng kép, gọn hơn, vắt lên ảnh ~1/3, lệch trái để không che sản phẩm.
 * Long lanh: bụi vàng + đốm sáng nhòe (canvas, chỉ lớp này trôi theo chuột), sao 4 cánh quanh lọ/hộp, ánh sáng lướt qua sản phẩm.
 * Thẻ có 3 thành phần chính, giá, nút Tìm hiểu + nút Tư vấn Zalo. Bật "giảm chuyển động" thì tắt hiệu ứng động.
 */
import { Image } from 'astro:assets';
import nen from '../assets/images/xnn-nen-long-lanh.png';
import { getProduct, minPrice, formatVnd } from '../data/products';
import { SITE } from '../data/site';
const xnn = getProduct('vien-uong-noi-tiet-xuan-nu-nhan')!;
const price = minPrice(xnn);
const CHIPS = ['Thiên môn chùm', 'Sâm tố nữ', 'Đông trùng hạ thảo'];
// vị trí sao (theo % ảnh gốc), sát mép lọ và hộp
const STARS = [
  { x: 67.6, y: 30, s: 34, d: 0 },
  { x: 72.5, y: 22.5, s: 22, d: 1.6 },
  { x: 88.8, y: 15.5, s: 40, d: 0.8 },
  { x: 77.2, y: 46, s: 24, d: 2.3 },
  { x: 89.2, y: 58, s: 28, d: 1.2 },
  { x: 76.8, y: 84, s: 22, d: 2.8 },
];
---
<section class="xnn" id="xnn" aria-labelledby="xnn-title">
  <div class="media" id="xnn-media">
    <div class="stage">
      <Image src={nen} alt="Viên uống nội tiết Xuân Nữ Nhan bên người phụ nữ rạng rỡ giữa hoa sen và lụa hồng" widths={[900, 1400, 1920, 2600]} sizes="(max-width: 767px) 1210px, 100vw" class="bg" loading="lazy" />
      <span class="shine" aria-hidden="true"><i></i></span>
      {STARS.map((t) => (
        <svg class="star" style={`left:${t.x}%;top:${t.y}%;width:${t.s}px;height:${t.s}px;animation-delay:${t.d}s`} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0l2.2 9.8L24 12l-9.8 2.2L12 24l-2.2-9.8L0 12l9.8-2.2z" fill="currentColor" /></svg>
      ))}
    </div>
    <canvas class="dust" aria-hidden="true"></canvas>
  </div>

  <div class="card-wrap">
    <div class="card-x" data-reveal>
      <p class="eyebrow !text-gold-300">Nội tiết tố nữ</p>
      <h2 id="xnn-title" class="title">{xnn.shortName}</h2>
      <p class="desc">Xuân Nữ Nhan – người bạn đồng hành tin cậy của phụ nữ hiện đại trên hành trình tái tạo nội tiết tố tự nhiên, phục hồi sinh lý và duy trì vẻ đẹp rạng rỡ từ sâu bên trong.</p>
      <ul class="chips" aria-label="Thành phần chính">
        {CHIPS.map((c) => <li>{c}</li>)}
      </ul>
      <div class="actions">
        {price && <p class="price">Từ <b>{formatVnd(price)}</b></p>}
        <a href={`/san-pham/${xnn.slug}/`} class="btn-gold xnn-btn">
          Tìm hiểu Xuân Nữ Nhan
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
        <a href={SITE.zalo} target="_blank" rel="noopener" class="zalo-btn">Tư vấn qua Zalo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .xnn { position: relative; isolation: isolate; padding-bottom: 64px; background: var(--color-cream); }

  /* ---------- ảnh: giữ đúng tỉ lệ ảnh gốc, căn như object-position 78% để không mất sản phẩm; 4 mép mờ dần ---------- */
  .media { position: relative; overflow: hidden; aspect-ratio: 3872 / 1088; min-height: 380px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 7%, #000 74%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%), linear-gradient(180deg, transparent 0, #000 7%, #000 74%, transparent 100%);
    mask-composite: intersect; }
  .stage { position: absolute; top: 0; height: 100%; min-width: 100%; aspect-ratio: 3872 / 1088; left: 78%; transform: translateX(-78%); }
  .stage :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dust { position: absolute; inset: -24px; width: calc(100% + 48px); height: calc(100% + 48px); pointer-events: none;
    translate: var(--px, 0px) var(--py, 0px); transition: translate .6s cubic-bezier(.2, .8, .2, 1); }

  /* sao 4 cánh nhấp nháy, sáng rõ */
  .star { position: absolute; z-index: 2; color: #fffaf0; transform: translate(-50%, -50%) scale(.15); opacity: 0;
    filter: drop-shadow(0 0 4px #fff) drop-shadow(0 0 10px rgba(255, 230, 160, 1)) drop-shadow(0 0 22px rgba(224, 191, 110, .9));
    animation: sd-xnn-star 3s ease-in-out infinite; }
  @keyframes sd-xnn-star {
    0%, 100% { transform: translate(-50%, -50%) scale(.15) rotate(0); opacity: 0; }
    40% { transform: translate(-50%, -50%) scale(1) rotate(40deg); opacity: 1; }
    65% { transform: translate(-50%, -50%) scale(.55) rotate(70deg); opacity: .55; }
  }

  /* ánh sáng lướt chéo qua lọ và hộp, rõ hơn */
  .shine { position: absolute; left: 66%; top: 14%; width: 25%; height: 78%; overflow: hidden; z-index: 1; pointer-events: none; mix-blend-mode: screen; }
  .shine i { position: absolute; inset: -10% -60%; transform: translateX(-100%);
    background: linear-gradient(110deg, transparent 38%, rgba(255, 228, 180, .55) 46%, rgba(255, 255, 255, .95) 50%, rgba(255, 228, 180, .55) 54%, transparent 62%);
    animation: sd-xnn-shine 5s ease-in-out infinite 1.2s; }
  @keyframes sd-xnn-shine { 0%, 55% { transform: translateX(-100%); } 82%, 100% { transform: translateX(100%); } }

  /* ---------- thẻ nội dung: gọn, đỏ đô trong mờ, vắt lên ảnh ~1/3 ---------- */
  .card-wrap { position: relative; z-index: 3; margin-top: -60px;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
  .card-x { position: relative; max-width: 700px; margin: 0 auto; text-align: center; color: #fff;
    padding: 24px 34px 26px; border-radius: 26px;
    background:
      radial-gradient(ellipse 70% 60% at 50% 0%, rgba(224, 191, 110, .2), transparent 70%),
      linear-gradient(180deg, rgba(106, 18, 32, .86), rgba(58, 9, 16, .93));
    backdrop-filter: blur(12px) saturate(1.2); -webkit-backdrop-filter: blur(12px) saturate(1.2);
    box-shadow: 0 0 0 1px rgba(224, 191, 110, .75), 0 0 0 6px rgba(251, 247, 241, .55), 0 0 0 7px rgba(224, 191, 110, .45),
      0 30px 56px -30px rgba(58, 9, 16, .7); }
  @media (min-width: 768px) and (max-width: 1399px) { .card-wrap { margin-top: -40px; } }
  @media (min-width: 1400px) {
    /* màn rộng: vắt lên ảnh ~1/3, lệch trái về phía mặt hồ để không che lọ và hộp */
    .card-wrap { margin-top: -120px; }
    .card-x { margin-left: max(16px, calc(41% - 350px)); }
  }
  .card-x::before { /* vạch kem mảnh bên trong: viền thứ hai */
    content: ''; position: absolute; inset: 8px; border-radius: 19px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(240, 220, 168, .32); }
  .card-x::after { /* tia sáng chạy một vòng quanh viền khi cuộn tới */
    content: ''; position: absolute; inset: -1px; border-radius: 27px; padding: 1.5px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--sd-a), transparent 0 78%, rgba(246, 220, 134, .2) 86%, #fff3c4 93%, #e0bf6e 96%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
  .card-x:global(.is-in)::after { animation: sd-xnn-ring 1.8s cubic-bezier(.45, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-ring { 0% { --sd-a: 0deg; opacity: 0; } 12% { opacity: 1; } 85% { opacity: 1; } 100% { --sd-a: 360deg; opacity: 0; } }

  .title { margin-top: 6px; font-family: var(--font-serif); font-weight: 700; font-size: clamp(32px, 3.4vw, 44px); line-height: 1.1;
    background-image: linear-gradient(100deg, #fbf3e6 0 40%, #e0bf6e 46%, #fff3c4 50%, #e0bf6e 54%, #fbf3e6 60% 100%);
    background-size: 320% 100%; background-position: 0 0;
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  .card-x:global(.is-in) .title { animation: sd-xnn-title 1.4s cubic-bezier(.4, 0, .2, 1) .35s both; }
  @keyframes sd-xnn-title { from { background-position: 100% 0; } to { background-position: 0 0; } }
  .desc { max-width: 580px; margin: 10px auto 0; font-size: 16px; line-height: 1.6; color: rgba(251, 243, 230, .84); text-wrap: pretty; }

  .chips { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .chips li { padding: 4px 12px; border-radius: 999px; font-size: 12.5px; color: var(--color-gold-300);
    background: rgba(224, 191, 110, .1); box-shadow: inset 0 0 0 1px rgba(224, 191, 110, .45); }
  .chips li::before { content: '✦'; margin-right: 6px; font-size: 10px; opacity: .85; }

  .actions { margin-top: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 16px; }
  .price { width: 100%; font-size: 13px; color: rgba(251, 243, 230, .7); }
  .price b { margin-left: 2px; font-size: 20px; color: var(--color-gold-300); }
  .xnn-btn { gap: 10px; } /* rê chuột: dùng hiệu ứng chung của btn-gold */
  .zalo-btn { display: inline-flex; align-items: center; padding: 11px 22px; border-radius: 999px; font-weight: 600; font-size: 15px;
    color: var(--color-gold-300); box-shadow: inset 0 0 0 1.5px rgba(224, 191, 110, .7);
    transition: transform .35s cubic-bezier(.2, .8, .2, 1), background .35s, color .35s, box-shadow .35s; }
  .zalo-btn:hover { transform: translateY(-2px); background: rgba(224, 191, 110, .14); color: #fff3c4;
    box-shadow: inset 0 0 0 1.5px rgba(224, 191, 110, .95), 0 0 0 4px rgba(224, 191, 110, .14); }
  .zalo-btn:active { transform: translateY(0) scale(.98); transition-duration: .1s; }

  @media (max-width: 767px) {
    .media { aspect-ratio: auto; min-height: 0; height: 320px; }
    .card-wrap { margin-top: -48px; }
    .card-x { padding: 22px 18px 24px; border-radius: 22px; }
    .card-x::before { border-radius: 15px; }
    .desc { font-size: 15px; }
    .star { scale: .75; }
  }
  @media (prefers-reduced-motion: reduce) {
    .star { display: none; }
    .shine i { animation: none; }
    .dust { transition: none; translate: none; }
  }
</style>

<script>
  // bụi vàng lấp lánh bay lên + đốm sáng nhòe, dày quanh sản phẩm; chỉ lớp này trôi theo chuột; dừng khi ra khỏi màn hình
  const media = document.getElementById('xnn-media');
  const cv = media?.querySelector<HTMLCanvasElement>('canvas.dust');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && cv && !reduce) {
    const ctx = cv.getContext('2d')!;
    let w = 0, h = 0, raf = 0, on = false, px0 = 0.78;
    type P = { x: number; y: number; r: number; vy: number; vx: number; t: number; sp: number; big: boolean };
    let ps: P[] = [];
    // vùng sản phẩm trên canvas (ảnh căn 78%, nên tính lại theo bề rộng thật của ảnh)
    const prodX = () => {
      const stageW = Math.max(w, h * (3872 / 1088));
      const off = px0 * (w - stageW);
      return [off + stageW * 0.64, off + stageW * 0.93];
    };
    const spawn = (anyY: boolean, big = false): P => {
      const [a, b] = prodX();
      const near = big || Math.random() < 0.65;
      const x = near ? a + Math.random() * (b - a) : Math.random() * w;
      return { x, y: anyY ? Math.random() * h : h + 20, big,
        r: big ? 8 + Math.random() * 14 : 0.9 + Math.random() * 2.3,
        vy: big ? 0.08 + Math.random() * 0.15 : 0.2 + Math.random() * 0.5, vx: (Math.random() - 0.5) * 0.25,
        t: Math.random() * 6.28, sp: big ? 0.008 + Math.random() * 0.012 : 0.025 + Math.random() * 0.045 };
    };
    const size = () => {
      const r = cv.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2); w = r.width; h = r.height;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(170, Math.max(60, w / 10)));
      ps = Array.from({ length: n }, () => spawn(true));
      for (let i = 0; i < 7; i++) ps.push(spawn(true, true));
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of ps) {
        p.y -= p.vy; p.x += p.vx; p.t += p.sp;
        if (p.y < -30) Object.assign(p, spawn(false, p.big));
        const tw = Math.abs(Math.sin(p.t));
        const a = p.big ? 0.1 + 0.18 * tw : 0.3 + 0.7 * tw;
        const R = p.big ? p.r : p.r * 4;
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, R);
        if (p.big) { g.addColorStop(0, `rgba(255,240,200,${a})`); g.addColorStop(1, 'rgba(255,220,160,0)'); }
        else { g.addColorStop(0, `rgba(255,250,228,${a})`); g.addColorStop(0.3, `rgba(245,214,135,${a * 0.65})`); g.addColorStop(1, 'rgba(224,191,110,0)'); }
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, R, 0, 6.283); ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
      raf = requestAnimationFrame(draw);
    };
    size();
    addEventListener('resize', size, { passive: true });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on) { on = true; raf = requestAnimationFrame(draw); }
      else if (!e.isIntersecting && on) { on = false; cancelAnimationFrame(raf); }
    }).observe(media);

    // chỉ lớp bụi vàng trôi theo chuột (ảnh đứng yên để không bị vẽ lệch)
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      media.addEventListener('pointermove', (e) => {
        const r = media.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5, dy = (e.clientY - r.top) / r.height - 0.5;
        media.style.setProperty('--px', `${(-dx * 26).toFixed(1)}px`);
        media.style.setProperty('--py', `${(-dy * 16).toFixed(1)}px`);
      });
      media.addEventListener('pointerleave', () => { media.style.setProperty('--px', '0px'); media.style.setProperty('--py', '0px'); });
    }
  }
</script>
