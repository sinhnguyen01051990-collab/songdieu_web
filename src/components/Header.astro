---
import { NAV, SITE } from '../data/site';
import { PRODUCTS } from '../data/products';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-40 bg-cream/85 backdrop-blur-md">
  <div class="mx-auto flex h-[72px] w-full max-w-[1440px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-9">
    <a href="/" class="flex items-center gap-2.5" aria-label="Song Diệu Pharma Beauty – Trang chủ">
      <img src="/logo-sd-128.webp" alt="" width="44" height="48" class="h-12 w-auto" fetchpriority="high" />
      <span class="flex flex-col leading-none">
        <span class="wordmark gold-text whitespace-nowrap text-[19px] sm:text-[22px]">Song Diệu</span>
        <span class="mt-0.5 font-brand text-[10.5px] font-semibold italic tracking-[0.2em] text-gold-600 uppercase">Pharma Beauty</span>
      </span>
    </a>

    <nav aria-label="Menu chính" class="hidden lg:block">
      <ul class="flex items-center gap-[31px] text-[16.4px]">
        {NAV.map((item) =>
          item.href === '/san-pham/' ? (
            <li class="group relative">
              <a href={item.href} class:list={['py-2 transition hover:text-brand-600', isActive(item.href) ? 'text-brand-600 font-medium' : 'text-ink/80']}>{item.label}</a>
              <div class="invisible absolute left-1/2 top-full w-72 -translate-x-1/2 translate-y-3 rounded-2xl bg-white p-2 opacity-0 shadow-xl ring-1 ring-black/5 transition group-hover:visible group-hover:translate-y-2 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {PRODUCTS.map((p) => (
                  <a href={`/san-pham/${p.slug}/`} class="block rounded-xl px-3 py-2 text-sm hover:bg-brand-50">
                    <span class="font-medium">{p.name}</span>
                    <span class="block text-xs text-mute">{p.category}</span>
                  </a>
                ))}
              </div>
            </li>
          ) : (
            <li>
              <a href={item.href} class:list={['py-2 transition hover:text-brand-600', isActive(item.href) ? 'text-brand-600 font-medium' : 'text-ink/80']}>{item.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={`tel:${SITE.phone}`} class="btn-white hidden h-10 !px-5 sm:inline-flex">Gọi tư vấn</a>
      <a href="/san-pham/" class="btn-primary h-10 !px-5">Mua ngay</a>
      <button id="menu-btn" class="lg:hidden rounded-full p-2 hover:bg-black/5" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-black/5 bg-cream lg:hidden" aria-label="Menu di động">
    <ul class="container-x py-3">
      {NAV.map((item) => (
        <li><a href={item.href} class="block rounded-xl px-3 py-3 font-medium hover:bg-brand-50">{item.label}</a></li>
      ))}
      {PRODUCTS.map((p) => (
        <li><a href={`/san-pham/${p.slug}/`} class="block rounded-xl px-6 py-2 text-sm text-mute hover:bg-brand-50">– {p.name}</a></li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
