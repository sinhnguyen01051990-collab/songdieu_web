---
import { SITE } from '../data/site';
/**
 * Liên hệ nhanh (giai đoạn 1, 13/11/2026)
 * - Điện thoại (< md): thanh cố định đáy màn hình: Gọi | Zalo | Đặt hàng.
 *   "Đặt hàng" cuộn tới form #dat-hang nếu trang có, không thì sang /san-pham/.
 * - Máy tính (≥ md): nút tròn nổi góc phải như cũ, bỏ vòng nhấp nháy liên tục.
 */
---
<!-- máy tính -->
<div id="fc-desk" class="fixed bottom-5 right-5 z-50 hidden flex-col gap-3 transition duration-300 md:flex">
  <a href={SITE.zalo} target="_blank" rel="noopener" aria-label="Chat Zalo với SONG DIỆU"
     class="grid h-14 w-14 place-items-center rounded-full bg-[#0068ff] text-xs font-bold text-white shadow-xl ring-2 ring-white transition hover:scale-105">Zalo</a>
  {SITE.messenger && (
    <a href={SITE.messenger} target="_blank" rel="noopener" aria-label="Nhắn tin Messenger"
       class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-[#00b2ff] to-[#a033ff] text-white shadow-xl ring-2 ring-white transition hover:scale-105">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.36 2 2 6.13 2 11.7c0 2.91 1.19 5.44 3.14 7.17v3.13l2.98-1.64c.86.24 1.82.37 2.88.37 5.64 0 10-4.13 10-9.7S17.64 2 12 2zm1 13.06-2.55-2.72-4.98 2.72 5.48-5.82 2.6 2.72 4.93-2.72L13 15.06z"/></svg>
    </a>
  )}
  <a href={`tel:${SITE.phone}`} aria-label={`Gọi hotline ${SITE.phoneDisplay}`}
     class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-b from-brand-500 to-brand-700 text-white shadow-xl ring-2 ring-gold-400/70 transition hover:scale-105">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
  </a>
</div>

<!-- điện thoại -->
<nav aria-label="Liên hệ nhanh"
     class="fixed inset-x-0 bottom-0 z-50 border-t border-gold-400/40 bg-brand-900/95 backdrop-blur-md md:hidden"
     style="padding-bottom: env(safe-area-inset-bottom, 0px)">
  <div class="mx-auto grid h-16 max-w-md grid-cols-[1fr_1fr_1.25fr] items-center gap-2 px-3">
    <a href={`tel:${SITE.phone}`} class="flex flex-col items-center gap-0.5 text-[11px] font-medium text-white/90">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-gold-300"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      Gọi ngay
    </a>
    <a href={SITE.zalo} target="_blank" rel="noopener" class="flex flex-col items-center gap-0.5 text-[11px] font-medium text-white/90">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-gold-300"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5A8.5 8.5 0 1 1 21 12z"/></svg>
      Chat Zalo
    </a>
    <a href="/san-pham/" id="bar-order" class="btn-gold h-11 !px-3 !text-sm">Đặt hàng</a>
  </div>
</nav>
<script>
  const order = document.getElementById('bar-order') as HTMLAnchorElement | null;
  if (order && document.getElementById('dat-hang')) order.href = '#dat-hang';

  // Trang chủ: ẩn nút nổi khi đang xem phần đầu trang (đã có nút Zalo + hotline ở đó), cuộn xuống mới hiện
  const desk = document.getElementById('fc-desk');
  const hero = document.querySelector('section.hero');
  if (desk && hero) {
    const set = (show: boolean) => {
      desk.style.opacity = show ? '' : '0';
      desk.style.transform = show ? '' : 'translateY(16px)';
      desk.style.pointerEvents = show ? '' : 'none';
      desk.toggleAttribute('inert', !show);
    };
    set(scrollY > (hero as HTMLElement).offsetHeight * 0.65);
    new IntersectionObserver(([e]) => set(e.intersectionRatio < 0.35), { threshold: [0, 0.35, 1] }).observe(hero);
  }
</script>
