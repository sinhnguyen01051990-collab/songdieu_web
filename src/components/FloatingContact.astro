---
import { SITE } from '../data/site';
---
<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-3">
  <a href={SITE.zalo} target="_blank" rel="noopener" aria-label="Chat Zalo với SONG DIỆU"
     class="grid h-14 w-14 place-items-center rounded-full bg-[#0068ff] text-xs font-bold text-white shadow-xl transition hover:scale-105">Zalo</a>
  {SITE.messenger && (
    <a href={SITE.messenger} target="_blank" rel="noopener" aria-label="Nhắn tin Messenger"
       class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-[#00b2ff] to-[#a033ff] text-white shadow-xl transition hover:scale-105">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.36 2 2 6.13 2 11.7c0 2.91 1.19 5.44 3.14 7.17v3.13l2.98-1.64c.86.24 1.82.37 2.88.37 5.64 0 10-4.13 10-9.7S17.64 2 12 2zm1 13.06-2.55-2.72-4.98 2.72 5.48-5.82 2.6 2.72 4.93-2.72L13 15.06z"/></svg>
    </a>
  )}
  <a href={`tel:${SITE.phone}`} aria-label={`Gọi hotline ${SITE.phoneDisplay}`}
     class="relative grid h-14 w-14 place-items-center rounded-full bg-brand-600 text-white shadow-xl transition hover:scale-105">
    <span class="absolute inset-0 animate-ping rounded-full bg-brand-500/40"></span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="relative"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
  </a>
</div>
